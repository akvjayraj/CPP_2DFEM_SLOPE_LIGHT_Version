<UserControl x:Class="GeotechSlopeApp.Views.Tabs.StagedAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GeotechSlopeApp.Converters"
             xmlns:vm="clr-namespace:GeotechSlopeApp.ViewModels"
             xmlns:models="clr-namespace:GeotechSlopeApp.Models">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:StringEqualConverter x:Key="StringEqualConverter"/>
        <converters:InvertedBooleanConverter x:Key="InvertedBooleanConverter"/>
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter"/>

        <!-- Palette: matches Mesh Studio for a consistent FEM studio feel -->
        <SolidColorBrush x:Key="Border"       Color="#FFE2E8F0"/>
        <SolidColorBrush x:Key="PanelFill"    Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ToolbarFill"  Color="#FFF8FAFC"/>
        <SolidColorBrush x:Key="StatusFill"   Color="#FF0F172A"/>
        <SolidColorBrush x:Key="StatusFG"     Color="#FFE2E8F0"/>
        <SolidColorBrush x:Key="Accent"       Color="#FF4F46E5"/>
        <SolidColorBrush x:Key="AccentSoft"   Color="#FFEEF2FF"/>
        <SolidColorBrush x:Key="Muted"        Color="#FF64748B"/>
        <SolidColorBrush x:Key="Warn"         Color="#FFB45309"/>
        <SolidColorBrush x:Key="Error"        Color="#FFB91C1C"/>
        <SolidColorBrush x:Key="OK"           Color="#FF047857"/>
        <SolidColorBrush x:Key="GanttFill"    Color="#FFDBE4FF"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#FF334155"/>
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin"  Value="0,0,6,0"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="#FFFEF2F2"/>
            <Setter Property="Foreground" Value="{StaticResource Error}"/>
            <Setter Property="BorderBrush" Value="#FFFCA5A5"/>
        </Style>

        <Style x:Key="CardGroup" TargetType="GroupBox">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin"  Value="0,0,0,10"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Background"  Value="White"/>
        </Style>

        <Style x:Key="StatusValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource StatusFG}"/>
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
        </Style>

        <Style x:Key="InspectorChip" TargetType="RadioButton">
            <Setter Property="GroupName" Value="InspectorKind"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip"
                                Background="White"
                                BorderBrush="{StaticResource Border}" BorderThickness="1"
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gantt-style phase row in the left master panel -->
        <DataTemplate x:Key="PhaseRowTemplate" DataType="{x:Type models:StageDefinition}">
            <Border x:Name="Row"
                    Margin="0,2"
                    Padding="8,6"
                    CornerRadius="4"
                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                    Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>   <!-- stage # chip -->
                        <ColumnDefinition Width="*"/>    <!-- name + type -->
                        <ColumnDefinition Width="Auto"/> <!-- gantt bar -->
                        <ColumnDefinition Width="Auto"/> <!-- starts-from arrow -->
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{StaticResource AccentSoft}"
                            CornerRadius="10"
                            MinHeight="24" MinWidth="24"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StageNumber}"
                                   FontWeight="Bold" Foreground="{StaticResource Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Padding="6,2"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                        <TextBlock Text="{Binding StageName}" FontWeight="SemiBold" FontSize="13"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Border Background="#FFF1F5F9" CornerRadius="8" Padding="6,1">
                                <TextBlock Text="{Binding StageType}" FontSize="10.5" Foreground="#FF475569"/>
                            </Border>
                            <TextBlock Text="{Binding SolverMode, StringFormat='  {0}'}" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="6,0,0,0"/>
                            <TextBlock Text="{Binding StressReleaseLambda, StringFormat='  λ={0:0.##}'}" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="6,0,0,0"/>
                            <TextBlock Text="{Binding LoadFactor, StringFormat='  ×{0:0.##}'}" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Gantt-style duration bar (simple visual; width scales linearly with Duration) -->
                    <Border Grid.Column="2" Background="{StaticResource GanttFill}" CornerRadius="3"
                            Height="10" VerticalAlignment="Center" MinWidth="20" MaxWidth="180"
                            Width="{Binding Duration}"
                            Margin="0,0,8,0"
                            ToolTip="{Binding Duration, StringFormat='Duration: {0} (relative)'}"/>

                    <TextBlock Grid.Column="3"
                               Foreground="{StaticResource Muted}"
                               FontSize="10.5"
                               VerticalAlignment="Center"
                               Text="{Binding StartsFromStageNumber, StringFormat='↳ from P{0}', TargetNullValue=''}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoft}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Convergence-log entry -->
        <DataTemplate x:Key="LogEntryTemplate" DataType="{x:Type vm:ConvergenceLogEntry}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding TimestampText}" Foreground="{StaticResource Muted}" FontFamily="Consolas,monospace" FontSize="11"/>
                <TextBlock Grid.Column="1" Text="{Binding PhaseText}" Foreground="{StaticResource Muted}" FontFamily="Consolas,monospace" FontSize="11"/>
                <Border Grid.Column="2" CornerRadius="6" Padding="4,0" Background="#FFEEF2FF" HorizontalAlignment="Left">
                    <TextBlock x:Name="Level"
                               Text="{Binding Level}" FontSize="10.5"
                               FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                </Border>
                <TextBlock Grid.Column="3" Text="{Binding Message}" Margin="8,0,0,0" TextWrapping="Wrap"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="warn">
                    <Setter TargetName="Level" Property="Foreground" Value="{StaticResource Warn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="error">
                    <Setter TargetName="Level" Property="Foreground" Value="{StaticResource Error}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="converged">
                    <Setter TargetName="Level" Property="Foreground" Value="{StaticResource OK}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#FFF8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- toolbar -->
            <RowDefinition Height="*"/>      <!-- master + inspector -->
            <RowDefinition Height="Auto"/>   <!-- convergence log -->
            <RowDefinition Height="Auto"/>   <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ════════════════════ TOOLBAR ════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource ToolbarFill}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Preset" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="PresetCombo"
                          ItemsSource="{Binding Presets}"
                          DisplayMemberPath="Name"
                          MinWidth="260"
                          Margin="0,0,8,0"
                          ToolTip="Construction-method templates based on tunneling practice (NATM, TBM, top-heading/bench/invert, staged loading, safety FOS)."/>
                <Button Content="Apply"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ApplyPresetCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=PresetCombo}"
                        Margin="0,0,16,0"
                        ToolTip="Replace the current phase list with this preset."/>

                <Border Width="1" Margin="0,2,8,2" Background="{StaticResource Border}"/>

                <Button Content="+ Phase" Style="{StaticResource ToolbarButton}" Command="{Binding AddPhaseCommand}" ToolTip="Add a new phase after the current selection."/>
                <Button Content="– Phase" Style="{StaticResource DangerButton}"  Command="{Binding RemovePhaseCommand}" ToolTip="Remove the selected phase."/>
                <Button Content="▲ Up"    Style="{StaticResource ToolbarButton}" Command="{Binding MoveUpCommand}"/>
                <Button Content="▼ Down"  Style="{StaticResource ToolbarButton}" Command="{Binding MoveDownCommand}"/>

                <Border Width="1" Margin="6,2,8,2" Background="{StaticResource Border}"/>

                <Button Content="Validate" Style="{StaticResource ToolbarButton}" Command="{Binding ValidateCommand}" ToolTip="Check the phase list for configuration issues."/>
                <Button Content="▶ Run All"      Style="{StaticResource PrimaryButton}" Command="{Binding RunAllCommand}" ToolTip="Solve every phase in order, carrying stresses forward (Plaxis / RS2 style)."/>
                <Button Content="▶▮ Run To"      Style="{StaticResource ToolbarButton}" Command="{Binding RunToSelectedCommand}" ToolTip="Run from Phase 1 up to and including the selected phase."/>
                <Button Content="▶ Only"         Style="{StaticResource ToolbarButton}" Command="{Binding RunSelectedOnlyCommand}" ToolTip="Run just the selected phase (advanced: assumes prior state is valid)."/>
                <Button Content="↻ Continue"     Style="{StaticResource ToolbarButton}" Command="{Binding ContinueCommand}" ToolTip="Continue from the last successful phase."/>
                <Button Content="⟲ Restart"      Style="{StaticResource ToolbarButton}" Command="{Binding RestartCommand}" ToolTip="Discard accumulated state; next run starts from scratch."/>
                <Button Content="■ Stop"         Style="{StaticResource DangerButton}"  Command="{Binding StopCommand}" ToolTip="Request a stop after the current phase completes."/>
            </StackPanel>
        </Border>

        <!-- ════════════════════ MASTER + DETAIL ════════════════════ -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: phase tree (Gantt-style rows) -->
            <Border Grid.Column="0" Background="{StaticResource PanelFill}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarFill}"
                            BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Phase Plan" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PhaseCount, StringFormat='  ({0})'}" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>

                    <!-- placeholder when empty -->
                    <Border DockPanel.Dock="Top" Padding="14"
                            Background="#FFFFFBEB" BorderBrush="#FFFCD34D" BorderThickness="1"
                            CornerRadius="4" Margin="10"
                            Visibility="{Binding HasSelectedPhase, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="No phases yet" FontWeight="SemiBold" Foreground="#FF92400E"/>
                            <TextBlock Text="Apply a construction-method preset from the toolbar, or click + Phase to build your own schedule."
                                       TextWrapping="Wrap" Foreground="#FF92400E" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <ListBox ItemsSource="{Binding Phases}"
                             SelectedItem="{Binding SelectedPhase, Mode=TwoWay}"
                             ItemTemplate="{StaticResource PhaseRowTemplate}"
                             HorizontalContentAlignment="Stretch"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="True"/>

            <!-- RIGHT: inspector cards -->
            <Border Grid.Column="2" Background="{StaticResource PanelFill}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <!-- inspector chip selector -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarFill}"
                            BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource InspectorChip}" Content="Phase"       IsChecked="{Binding InspectorKind, Converter={StaticResource StringEqualConverter}, ConverterParameter=Phase, Mode=OneWay}" Command="{Binding SetInspectorCommand}" CommandParameter="Phase"/>
                            <RadioButton Style="{StaticResource InspectorChip}" Content="Activity"    IsChecked="{Binding InspectorKind, Converter={StaticResource StringEqualConverter}, ConverterParameter=Activity, Mode=OneWay}" Command="{Binding SetInspectorCommand}" CommandParameter="Activity"/>
                            <RadioButton Style="{StaticResource InspectorChip}" Content="Calculation" IsChecked="{Binding InspectorKind, Converter={StaticResource StringEqualConverter}, ConverterParameter=Calculation, Mode=OneWay}" Command="{Binding SetInspectorCommand}" CommandParameter="Calculation"/>
                            <RadioButton Style="{StaticResource InspectorChip}" Content="Convergence" IsChecked="{Binding InspectorKind, Converter={StaticResource StringEqualConverter}, ConverterParameter=Convergence, Mode=OneWay}" Command="{Binding SetInspectorCommand}" CommandParameter="Convergence"/>
                            <RadioButton Style="{StaticResource InspectorChip}" Content="Results"     IsChecked="{Binding InspectorKind, Converter={StaticResource StringEqualConverter}, ConverterParameter=Results, Mode=OneWay}" Command="{Binding SetInspectorCommand}" CommandParameter="Results"/>
                            <Button Content="⤴ Jump to footer stage tab" Style="{StaticResource ToolbarButton}"
                                    Command="{Binding JumpToFooterTabCommand}" Margin="24,0,0,0"
                                    ToolTip="Switch the footer stage tab to this phase (footer governs load ownership)."/>
                        </StackPanel>
                    </Border>

                    <!-- placeholder when nothing selected -->
                    <Grid DockPanel.Dock="Top"
                          Visibility="{Binding HasSelectedPhase, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                        <TextBlock Text="Select a phase on the left (or add one) to configure it here."
                                   Foreground="{StaticResource Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="24"/>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="14"
                                  Visibility="{Binding HasSelectedPhase, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <!-- ─── PHASE CARD ─── -->
                            <GroupBox Header="Phase"
                                      Style="{StaticResource CardGroup}"
                                      Visibility="{Binding InspectorKind, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Phase}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Stage #"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,4" Text="{Binding SelectedPhase.StageNumber, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Is active"/>
                                    <CheckBox  Grid.Row="0" Grid.Column="3" Margin="0,8,0,4" IsChecked="{Binding SelectedPhase.IsActive, Mode=TwoWay}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Phase name"/>
                                    <TextBox   Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4" Text="{Binding SelectedPhase.StageName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Type"/>
                                    <ComboBox  Grid.Row="2" Grid.Column="1" Margin="0,4"
                                               ItemsSource="{Binding PhaseTypeOptionsRef}"
                                               SelectedItem="{Binding SelectedPhase.StageType, Mode=TwoWay}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Starts from phase"/>
                                    <TextBox   Grid.Row="2" Grid.Column="3" Margin="0,4" Text="{Binding SelectedPhase.StartsFromStageNumber, Mode=TwoWay, TargetNullValue='', UpdateSourceTrigger=LostFocus}"
                                               ToolTip="Leave empty for previous phase; enter an earlier phase number to branch."/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Duration"/>
                                    <TextBox   Grid.Row="3" Grid.Column="1" Margin="0,4" Text="{Binding SelectedPhase.Duration, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Units"/>
                                    <TextBox   Grid.Row="3" Grid.Column="3" Margin="0,4" Text="{Binding SelectedPhase.Units, Mode=TwoWay}"/>

                                    <CheckBox  Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4"
                                               Content="Reset displacements at start of phase"
                                               IsChecked="{Binding SelectedPhase.ResetDisplacementsAtStart, Mode=TwoWay}"
                                               ToolTip="Zeros the cumulative displacement field before this phase; useful for a clean Safety analysis."/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Notes"/>
                                    <TextBox   Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4"
                                               AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                                               VerticalScrollBarVisibility="Auto"
                                               Text="{Binding SelectedPhase.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </GroupBox>

                            <!-- ─── ACTIVITY CARD ─── -->
                            <GroupBox Header="Activity (surfaces, lining, bolts, groundwater)"
                                      Style="{StaticResource CardGroup}"
                                      Visibility="{Binding InspectorKind, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Activity}">
                                <StackPanel>
                                    <TextBlock Text="Deactivate surfaces (excavate):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ComboBox x:Name="DeactivateCombo" ItemsSource="{Binding AvailableSurfaces}" MinWidth="100" Margin="0,0,6,0"/>
                                        <Button Content="+ Add"    Style="{StaticResource ToolbarButton}" Command="{Binding AddDeactivateSurfaceCommand}" CommandParameter="{Binding SelectedItem, ElementName=DeactivateCombo}"/>
                                        <Button Content="- Remove" Style="{StaticResource ToolbarButton}" Command="{Binding RemoveDeactivateSurfaceCommand}" CommandParameter="{Binding SelectedItem, ElementName=DeactivatedSurfaceList}"/>
                                    </StackPanel>
                                    <ListBox x:Name="DeactivatedSurfaceList" ItemsSource="{Binding SelectedPhase.DeactivateSurfaceNumbers}" Height="60" Margin="0,0,0,10">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat='S{0}'}" Margin="2"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Text="Activate (re-enable) surfaces:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ComboBox x:Name="ActivateCombo" ItemsSource="{Binding AvailableSurfaces}" MinWidth="100" Margin="0,0,6,0"/>
                                        <Button Content="+ Add"    Style="{StaticResource ToolbarButton}" Command="{Binding AddActivateSurfaceCommand}" CommandParameter="{Binding SelectedItem, ElementName=ActivateCombo}"/>
                                        <Button Content="- Remove" Style="{StaticResource ToolbarButton}" Command="{Binding RemoveActivateSurfaceCommand}" CommandParameter="{Binding SelectedItem, ElementName=ActivatedSurfaceList}"/>
                                    </StackPanel>
                                    <ListBox x:Name="ActivatedSurfaceList" ItemsSource="{Binding SelectedPhase.ActivateSurfaceNumbers}" Height="60" Margin="0,0,0,10">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat='S{0}'}" Margin="2"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Separator Margin="0,4,0,8"/>
                                    <CheckBox Content="Lining installed in this phase" IsChecked="{Binding SelectedPhase.LiningEnabled, Mode=TwoWay}" Margin="0,2"/>
                                    <CheckBox Content="Bolts / anchors installed in this phase" IsChecked="{Binding SelectedPhase.BoltsEnabled, Mode=TwoWay}" Margin="0,2"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="Groundwater line tag:" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding SelectedPhase.GroundwaterLineTag, Mode=TwoWay}" MinWidth="160"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <!-- ─── CALCULATION CARD ─── -->
                            <GroupBox Header="Calculation"
                                      Style="{StaticResource CardGroup}"
                                      Visibility="{Binding InspectorKind, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Calculation}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Solver mode"/>
                                    <ComboBox  Grid.Row="0" Grid.Column="1" Margin="0,4"
                                               ItemsSource="{Binding SolverModeOptionsRef}"
                                               SelectedItem="{Binding SelectedPhase.SolverMode, Mode=TwoWay}"
                                               ToolTip="Elastic = one-shot linear; Plastic = Newton iteration; Consolidation = coupled; Safety = c-φ reduction FOS."/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Stress release λ"/>
                                    <TextBox   Grid.Row="0" Grid.Column="3" Margin="0,4"
                                               Text="{Binding SelectedPhase.StressReleaseLambda, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.###}"
                                               ToolTip="Fraction of excavation/load applied in this phase (0..1). NATM typically 0.3–0.5 before lining."/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Load factor"/>
                                    <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,4"
                                               Text="{Binding SelectedPhase.LoadFactor, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.###}"
                                               ToolTip="Multiplier on external loads applied in this phase."/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Max load steps"/>
                                    <TextBox   Grid.Row="1" Grid.Column="3" Margin="0,4" Text="{Binding SelectedPhase.MaxLoadSteps, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Max iterations"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding SelectedPhase.MaxIterations, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Tolerance"/>
                                    <TextBox   Grid.Row="2" Grid.Column="3" Margin="0,4" Text="{Binding SelectedPhase.Tolerance, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.###e+00}"/>

                                    <CheckBox  Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6"
                                               Content="Use arc-length control (for snap-through / post-peak)"
                                               IsChecked="{Binding SelectedPhase.ArcLength, Mode=TwoWay}"/>

                                    <Border Grid.Row="4" Grid.ColumnSpan="4" Margin="0,8,0,0" Padding="10"
                                            Background="{StaticResource AccentSoft}" CornerRadius="4" BorderBrush="{StaticResource Accent}" BorderThickness="1">
                                        <TextBlock TextWrapping="Wrap" Foreground="#FF312E81">
                                            <Run FontWeight="SemiBold">Tip:</Run> split large excavation loads across phases by reducing λ
                                            (e.g. 0.4 for top heading, then full 1.0 after lining) — this gives a more realistic deformation history.
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </GroupBox>

                            <!-- ─── CONVERGENCE CARD ─── -->
                            <GroupBox Header="Convergence"
                                      Style="{StaticResource CardGroup}"
                                      Visibility="{Binding InspectorKind, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Convergence}">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,6">
                                        Live |ΔU| and residual history will appear here as the solver iterates. The bottom panel already shows a
                                        streaming log of every solver message (colour-coded by severity). The target tolerance for this phase is
                                        <Run FontFamily="Consolas,monospace" Text="{Binding SelectedPhase.Tolerance, StringFormat=0.###e+00}"/>.
                                    </TextBlock>

                                    <Border Background="#FFF8FAFC" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4"
                                            Height="140" Margin="0,6,0,0">
                                        <Grid>
                                            <TextBlock Text="Convergence chart (placeholder) — values stream in at runtime."
                                                       Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </GroupBox>

                            <!-- ─── RESULTS CARD ─── -->
                            <GroupBox Header="Results export"
                                      Style="{StaticResource CardGroup}"
                                      Visibility="{Binding InspectorKind, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Results}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Checklist (drives what is shown on the Results tab for this phase)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <CheckBox Content="Ux displacement"      IsChecked="{Binding SelectedPhase.ExportUx, Mode=TwoWay}" Margin="0,2"/>
                                        <CheckBox Content="Uy displacement"      IsChecked="{Binding SelectedPhase.ExportUy, Mode=TwoWay}" Margin="0,2"/>
                                        <CheckBox Content="σxx"                  IsChecked="{Binding SelectedPhase.ExportSxx, Mode=TwoWay}" Margin="0,2"/>
                                        <CheckBox Content="σyy"                  IsChecked="{Binding SelectedPhase.ExportSyy, Mode=TwoWay}" Margin="0,2"/>
                                        <CheckBox Content="τxy"                  IsChecked="{Binding SelectedPhase.ExportTxy, Mode=TwoWay}" Margin="0,2"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Advanced" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <CheckBox Content="Plastic zones / yield"  IsChecked="{Binding SelectedPhase.ExportPlasticZones, Mode=TwoWay}" Margin="0,2"/>
                                        <CheckBox Content="Factor of safety history" IsChecked="{Binding SelectedPhase.ExportFosHistory, Mode=TwoWay}" Margin="0,2"
                                                  ToolTip="Enable for Safety (c-φ) phases to track FOS vs load step."/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ════════════════════ CONVERGENCE LOG ════════════════════ -->
        <Border Grid.Row="2" Background="White"
                BorderBrush="{StaticResource Border}" BorderThickness="1,1,1,0" Margin="10,0,10,0" CornerRadius="4"
                MaxHeight="180">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarFill}"
                        BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Convergence log" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ConvergenceLog.Count, StringFormat='  ({0} entries)'}" Foreground="{StaticResource Muted}"/>
                        <Button Content="Clear" Style="{StaticResource ToolbarButton}"
                                Command="{Binding ClearLogCommand}"
                                Margin="16,0,0,0"/>
                    </StackPanel>
                </Border>
                <ListBox ItemsSource="{Binding ConvergenceLog}"
                         ItemTemplate="{StaticResource LogEntryTemplate}"
                         BorderThickness="0" Padding="8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch"
                         FontFamily="Segoe UI"/>
            </DockPanel>
        </Border>

        <!-- ════════════════════ STATUS BAR ════════════════════ -->
        <Border Grid.Row="3" Background="{StaticResource StatusFill}" Padding="12,6" Margin="10,6,10,10" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Phases:"  Foreground="#FF94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding PhaseCount}" Style="{StaticResource StatusValue}"/>
                <TextBlock Text="Selected:" Foreground="#FF94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding SelectedPhase.StageName, FallbackValue='(none)'}" Style="{StaticResource StatusValue}"/>
                <TextBlock Text="Status:"  Foreground="#FF94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding RunStatusLabel}" Style="{StaticResource StatusValue}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
