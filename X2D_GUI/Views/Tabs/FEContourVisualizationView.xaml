<UserControl x:Class="GeotechSlopeApp.Views.Tabs.FEContourVisualizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GeotechSlopeApp.Views.Controls"
             xmlns:tabs="clr-namespace:GeotechSlopeApp.Views.Tabs"
             xmlns:converters="clr-namespace:GeotechSlopeApp.Converters"
             xmlns:oxy="http://oxyplot.org/wpf">
    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12"
                    Visibility="{Binding DataContext.IsResultsWorkspace, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <TextBlock Text="FE Analysis Contour Visualization"
                       FontSize="20"
                       FontWeight="Bold"/>
            <TextBlock Text="{Binding FeStatusMessage}"
                       Margin="0,4,0,0"
                       Foreground="Gray"/>
            <TextBlock Text="{Binding CriticalSrfBannerText}"
                       Margin="0,6,0,0"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#8B0000"
                       Visibility="{Binding ShowCriticalSrfBanner, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Text="{Binding GammaMaxStageHint}"
                       Margin="0,4,0,0"
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Visibility="{Binding ShowCriticalSrfBanner, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Margin="0,4,0,0"
                       Visibility="{Binding HasPseudoStaticResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Run Text="Pseudo-static run: k_h = "/>
                <Run Text="{Binding PseudoStaticKh, Mode=OneWay, StringFormat=F4}" FontWeight="SemiBold"/>
                <Run Text=", k_v = "/>
                <Run Text="{Binding PseudoStaticKv, Mode=OneWay, StringFormat=F4}" FontWeight="SemiBold"/>
                <Run Text=" — switch Vector Type to “Pseudo-static Force Vectors” (orange arrows)."/>
            </TextBlock>
        </StackPanel>
        
        <!-- Compact time scrubber for transient contours (full chart lives on Force-Displacement) -->
        <GroupBox Grid.Row="1" Header="Time"
                  Margin="0,0,0,12"
                  Visibility="{Binding HasTransientResults, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⏮" Width="34" Margin="0,0,4,0"
                            Command="{Binding JumpTransientToStartCommand}"
                            ToolTip="Jump to t = 0"/>
                    <Button Content="◀" Width="34" Margin="0,0,4,0"
                            Command="{Binding StepTransientBackwardCommand}"
                            ToolTip="Previous time frame"/>
                    <Button Content="▶" Width="40" Margin="0,0,4,0"
                            Command="{Binding PlayTransientCommand}"
                            ToolTip="Play time animation"
                            Visibility="{Binding IsTransientPlaying, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                    <Button Content="❚❚" Width="40" Margin="0,0,4,0"
                            Command="{Binding PauseTransientCommand}"
                            ToolTip="Pause animation"
                            Visibility="{Binding IsTransientPlaying, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="▶|" Width="34" Margin="0,0,4,0"
                            Command="{Binding StepTransientForwardCommand}"
                            ToolTip="Next time frame"/>
                    <Button Content="⏭" Width="34"
                            Command="{Binding JumpTransientToEndCommand}"
                            ToolTip="Jump to final time"/>
                </StackPanel>
                <Slider Grid.Column="1"
                        Minimum="0"
                        Maximum="{Binding TransientTimeIndexMax}"
                        Value="{Binding TransientTimeIndex, Mode=TwoWay}"
                        IsSnapToTickEnabled="True"
                        TickFrequency="1"
                        VerticalAlignment="Center"
                        Margin="12,0"
                        ToolTip="Scrub through consolidation time frames (contours update live)"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding CurrentTransientTimeLabel}"
                           VerticalAlignment="Center"
                           Foreground="#FF334155"
                           FontFamily="Consolas"
                           FontSize="12"/>
            </Grid>
        </GroupBox>

        <!-- Stage Selection (for Staged Excavation) -->
        <GroupBox Grid.Row="1" Header="Staged Excavation Analysis" 
                  Margin="0,0,0,12"
                  Visibility="{Binding HasStagedExcavationResults, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                           Text="View Stage:" 
                           VerticalAlignment="Center" 
                           Margin="0,4"/>
                <ComboBox Grid.Column="1" 
                          ItemsSource="{Binding AvailableStages}"
                          SelectedItem="{Binding SelectedStageInfo, Mode=TwoWay}"
                          Margin="8,4">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Summary}" Foreground="Gray" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </GroupBox>
        
        <!-- Visualization Mode Selection -->
        <GroupBox Grid.Row="2" Header="Visualization Settings" Margin="0,0,0,12"
                  Visibility="{Binding DataContext.IsResultsWorkspace, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Visualization Mode -->
                <TextBlock Grid.Row="0" Grid.Column="0" 
                           Text="Visualization Mode:" 
                           VerticalAlignment="Center" 
                           Margin="0,0,8,8"/>
                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding AvailableVisualizationModes}"
                          SelectedItem="{Binding VisualizationMode}"
                          VerticalAlignment="Center"
                          Margin="0,0,0,8"/>
                
                <!-- Output Type (for Contour) -->
                <TextBlock Grid.Row="0" Grid.Column="2" 
                           Text="Output Type:" 
                           VerticalAlignment="Center" 
                           Margin="8,0,8,8"
                           Visibility="{Binding IsContourLikeMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <StackPanel Grid.Row="0" Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8"
                            Visibility="{Binding IsContourLikeMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ComboBox ItemsSource="{Binding AvailableOutputTypes}"
                              SelectedItem="{Binding SelectedOutputType}"
                              VerticalAlignment="Center"
                              MinWidth="260"/>
                    <TextBlock Text="{Binding SelectedOutputUnitLabel}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Foreground="Gray"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Contour fill style (2D contour mode only) -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Fill Style:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,8"
                           Visibility="{Binding VisualizationMode, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Contour}"/>
                <ComboBox Grid.Row="1" Grid.Column="1"
                          ItemsSource="{Binding AvailableContourFillModes}"
                          SelectedItem="{Binding ContourFillMode}"
                          VerticalAlignment="Center"
                          Margin="0,0,0,8"
                          ToolTip="Element coloring: one flat color per element. Smooth bands: nodally interpolated field with discrete color levels."
                          Visibility="{Binding VisualizationMode, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Contour}"/>
                
                <!-- Vector Output Type (same row/cols as Contour Fill Style) -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Vector Type:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,8"
                           Visibility="{Binding VisualizationMode, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Vector}"/>
                <ComboBox Grid.Row="1" Grid.Column="1"
                          ItemsSource="{Binding AvailableVectorOutputTypes}"
                          SelectedItem="{Binding VectorOutputType}"
                          VerticalAlignment="Center"
                          Margin="0,0,0,8"
                          Visibility="{Binding VisualizationMode, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Vector}"/>

                <!-- Vector Scale (row 1, right) -->
                <TextBlock Grid.Row="1" Grid.Column="2"
                           Text="Vector Scale:"
                           VerticalAlignment="Center"
                           Margin="8,0,8,8"
                           Visibility="{Binding VisualizationMode, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Vector}"/>
                <StackPanel Grid.Row="1" Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8"
                            Visibility="{Binding VisualizationMode, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Vector}">
                    <Slider Minimum="0.1" Maximum="10" Value="{Binding VectorScale}" Width="150" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding VectorScale, StringFormat=F2}" VerticalAlignment="Center" MinWidth="40"/>
                </StackPanel>

                <!-- Mesh deformation exaggeration (row 2 — Vector + Deformed mesh) -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Mesh exaggeration:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,8"
                           Visibility="{Binding UsesMeshDeformationExaggeration, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <StackPanel Grid.Row="2" Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8"
                            Visibility="{Binding UsesMeshDeformationExaggeration, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Slider Minimum="1" Maximum="200" Value="{Binding DeformedMeshExaggeration}" Width="150" Margin="0,0,8,0"/>
                    <TextBlock VerticalAlignment="Center" MinWidth="48">
                        <Run Text="{Binding DeformedMeshExaggeration, StringFormat=F0}"/>
                        <Run Text="×"/>
                    </TextBlock>
                </StackPanel>

                <!-- Displacement component (row 2, right — does not share row with Vector Scale) -->
                <TextBlock Grid.Row="2" Grid.Column="2"
                           Text="Component:"
                           VerticalAlignment="Center"
                           Margin="8,0,8,8"
                           ToolTip="Horizontal (Ux only) reveals SRF slope-failure patterns when gravity-settlement Uy dominates">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding VisualizationMode}" Value="Vector"/>
                                        <Condition Binding="{Binding VectorOutputType}" Value="Displacement Vectors"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ComboBox Grid.Row="2" Grid.Column="3"
                          ItemsSource="{Binding AvailableVectorDisplacementComponents}"
                          SelectedItem="{Binding VectorDisplacementComponent}"
                          VerticalAlignment="Center"
                          Margin="0,0,0,8"
                          ToolTip="Both: full vector | Horizontal (Ux only): lateral movement — isolates SRF failure mechanism | Vertical (Uy only): settlement">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding VisualizationMode}" Value="Vector"/>
                                        <Condition Binding="{Binding VectorOutputType}" Value="Displacement Vectors"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>

                <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
                          Content="Show undeformed outline"
                          IsChecked="{Binding ShowUndeformedOutline}"
                          VerticalAlignment="Center"
                          Margin="0,0,0,8"
                          Visibility="{Binding IsDeformedMeshMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Show Mesh Checkbox -->
                <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                          Content="Show Mesh"
                          IsChecked="{Binding ShowMesh}"
                          Margin="0,8,0,0">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VisualizationMode}" Value="Vector">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding VisualizationMode}" Value="Deformed mesh">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>

                <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4"
                          Content="Show pseudo-static force vectors (orange overlay on displacement)"
                          IsChecked="{Binding ShowPseudoStaticForceVectors}"
                          Margin="0,4,0,8">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasPseudoStaticResults}" Value="True"/>
                                        <Condition Binding="{Binding VisualizationMode}" Value="Vector"/>
                                        <Condition Binding="{Binding VectorOutputType}" Value="Displacement Vectors"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>

                <!-- Sign/unit/reference note for the selected scalar field -->
                <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4"
                           Text="{Binding SelectedOutputReferenceNote}"
                           TextWrapping="Wrap"
                           Foreground="#FF475569"
                           FontSize="11"
                           Margin="0,6,0,0"
                           Visibility="{Binding IsContourLikeMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Line Plot Tool (Contour mode only) -->
                <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4"
                            Orientation="Horizontal" Margin="0,8,0,0"
                            Visibility="{Binding VisualizationMode, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Contour}">
                    <ToggleButton Content="Line Plot"
                                  IsChecked="{Binding IsLinePlotMode, Mode=TwoWay}"
                                  Padding="10,4" MinWidth="90"/>
                    <TextBlock Text="{Binding LinePlotHint}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Foreground="#CC6600"
                               FontStyle="Italic"
                               FontSize="11"
                               Visibility="{Binding IsLinePlotMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </GroupBox>
        
        <!-- Visualization Canvas + Line Plot Chart (side by side) -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Background="White">
                <Grid>
                    <controls:FEContourCanvasView DataContext="{Binding}"
                                                 Visibility="{Binding VisualizationMode, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Contour}"/>
                    <controls:FEOneDContourCanvasView DataContext="{Binding}"
                                                     Visibility="{Binding VisualizationMode, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='1D Contour'}"/>
                    <controls:FEVectorCanvasView DataContext="{Binding}"
                                                Visibility="{Binding VisualizationMode, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Vector}"/>
                    <controls:FEDeformedMeshCanvasView DataContext="{Binding}"
                                                        Visibility="{Binding VisualizationMode, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Deformed mesh'}"/>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,10,0,0"
                                Visibility="{Binding DataContext.IsResultsWorkspace, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding DataContext.Workspace.Results.PlotOverlayTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontWeight="SemiBold" FontSize="13" Foreground="#FF0F172A"/>
                        <TextBlock Text="{Binding DataContext.Workspace.Results.PlotOverlayText, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="11" Foreground="#FF334155"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Line Plot Chart — appears to the right after two points are picked -->
            <Border Grid.Column="1"
                    Width="340"
                    Margin="8,0,0,0"
                    BorderBrush="#FFCCCCCC"
                    BorderThickness="1"
                    Visibility="{Binding HasLinePlot, Converter={StaticResource BooleanToVisibilityConverter}}">
                <oxy:PlotView Model="{Binding LinePlotModel}"
                              Background="White"/>
            </Border>
        </Grid>
        
        <!-- Color Scale Legend (for Contour) -->
        <GroupBox Grid.Row="4" Header="Color Scale" Margin="0,12,0,0"
                 Visibility="{Binding ShowContourLegend, Converter={StaticResource BooleanToVisibilityConverter}}">
            <controls:FEContourLegendView DataContext="{Binding}"/>
        </GroupBox>
    </Grid>
</UserControl>
