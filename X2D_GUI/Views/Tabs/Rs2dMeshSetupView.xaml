<UserControl x:Class="GeotechSlopeApp.Views.Tabs.Rs2dMeshSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GeotechSlopeApp.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12">
            <GroupBox Header="Mesh and Discretization Settings" Padding="16" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Mesh Type:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,10"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding Rs2dMeshTypeOptions}"
                              SelectedItem="{Binding Rs2dMeshType, Mode=TwoWay}"
                              MinWidth="200" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Text="Element Type:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,10"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              ItemsSource="{Binding Rs2dElementTypeOptions}"
                              SelectedItem="{Binding Rs2dElementType, Mode=TwoWay}"
                              MinWidth="200" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,10"/>

                    <!-- Mesh density: presets scale with model size; User-defined unlocks typed sizes and counts.
                         Editing Global/Near sizes auto-switches the preset to User-defined. -->
                    <TextBlock Text="Mesh Density:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,10"
                               ToolTip="Very Coarse → Very Fine scale with model size. User-defined: type sizes or element/discretization counts."/>
                    <ComboBox Grid.Row="2" Grid.Column="1"
                              ItemsSource="{Binding GlobalDensityPresets}"
                              SelectedItem="{Binding GlobalDensityPreset, Mode=TwoWay}"
                              MinWidth="200" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,10"
                              ToolTip="Presets fill Global/Near sizes from geometry. Choose User-defined for exact sizes or counts."/>

                    <TextBlock Text="Global Element Size:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,10"
                               ToolTip="Target edge length far from boundaries (model units). Editing switches density to User-defined."/>
                    <TextBox Grid.Row="3" Grid.Column="1"
                             Text="{Binding GlobalMeshSize, UpdateSourceTrigger=PropertyChanged}"
                             Width="120" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Text="Near-Boundary Size:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,10"
                               ToolTip="Target edge length on excavation / outer boundary; controls fineness of the first ring."/>
                    <TextBox Grid.Row="4" Grid.Column="1"
                             Text="{Binding NearBoundaryMeshSize, UpdateSourceTrigger=PropertyChanged}"
                             Width="120" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Text="Boundary discretization nodes:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"
                               TextWrapping="Wrap" Margin="0,0,12,10"
                               ToolTip="Optional. When set, Discretize uses average spacing ≈ perimeter / N. Leave blank to use Global/Near sizes."/>
                    <TextBox Grid.Row="5" Grid.Column="1"
                             Text="{Binding Rs2dBoundaryNodeCount, UpdateSourceTrigger=PropertyChanged}"
                             Width="120" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,10"
                             ToolTip="User-defined boundary node count for Discretize (blank = size-based)."/>

                    <TextBlock Text="Target number of elements:" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"
                               TextWrapping="Wrap" Margin="0,0,12,10"
                               ToolTip="Optional approximate element count. When set, Global size is derived from domain area before Discretize/Mesh."/>
                    <TextBox Grid.Row="6" Grid.Column="1"
                             Text="{Binding Rs2dTargetElementCount, UpdateSourceTrigger=PropertyChanged}"
                             Width="120" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,10"
                             ToolTip="Approximate target element count (blank = use Global/Near sizes as typed)."/>

                    <TextBlock Text="Gradation Factor:" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,10"/>
                    <TextBox Grid.Row="7" Grid.Column="1"
                             Text="{Binding Rs2dGradationFactor, UpdateSourceTrigger=PropertyChanged}"
                             Width="120" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Text="Default Number of Nodes on All Excavations:" Grid.Row="8" Grid.Column="0"
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                    <TextBox Grid.Row="8" Grid.Column="1"
                             Text="{Binding Rs2dExcavationNodeCount, UpdateSourceTrigger=PropertyChanged}"
                             Width="120" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>
            </GroupBox>

            <Expander IsExpanded="{Binding Rs2dAdvancedExpanded, Mode=TwoWay}"
                      Margin="0,0,0,12"
                      Padding="0,4,0,0">
                <Expander.Header>
                    <TextBlock Text="Advanced" FontWeight="SemiBold"/>
                </Expander.Header>
                <Border Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,8,0,0">
                    <StackPanel>
                        <CheckBox Content="Refine near excavations" IsChecked="{Binding RefineNearExcavation, Mode=TwoWay}" Margin="0,0,0,6"/>
                        <CheckBox Content="Refine near loads" IsChecked="{Binding RefineNearLoads, Mode=TwoWay}" Margin="0,0,0,6"/>
                        <CheckBox Content="Refine near material interfaces" IsChecked="{Binding RefineNearMaterialInterfaces, Mode=TwoWay}" Margin="0,0,0,6"/>
                        <CheckBox Content="Refine near stiffness contrast" IsChecked="{Binding RefineNearStiffnessContrast, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>
            </Expander>

            <!-- Optional unstructured-mesh quality tools (all opt-in). Hidden by default; pop open the expander when needed. -->
            <Expander Header="Advanced Unstructured Mesh Quality Tools (optional)" Margin="0,0,0,12" Padding="0,4,0,0">
                <Border Background="#FFFAF5FF" BorderBrush="#FFE9D5FF" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Enable any of the following tools to inspect the unstructured triangle mesh. All are off by default."
                                   FontStyle="Italic" Foreground="#FF64748B" Margin="0,0,0,6" TextWrapping="Wrap"/>

                        <CheckBox Content="Show best-practice warnings"
                                  IsChecked="{Binding Rs2dShowBestPracticeWarnings, Mode=TwoWay}" Margin="0,0,0,4"/>
                        <CheckBox Content="Treat best-practice errors as blockers"
                                  IsChecked="{Binding Rs2dStrictWarningBlockers, Mode=TwoWay}" Margin="20,0,0,4"
                                  IsEnabled="{Binding Rs2dShowBestPracticeWarnings}"/>

                        <CheckBox Content="Show mesh quality dashboard"
                                  IsChecked="{Binding Rs2dShowQualityDashboard, Mode=TwoWay}" Margin="0,0,0,4"/>

                        <CheckBox Content="Enable advanced quad conversion controls (Q4 only)"
                                  IsChecked="{Binding Rs2dQualityEnableSlider, Mode=TwoWay}" Margin="0,0,0,4"/>
                        <Grid Margin="20,0,0,4" IsEnabled="{Binding Rs2dQualityEnableSlider}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Prefer more quads" Foreground="#FF64748B" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1"
                                    Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                    TickFrequency="0.1" TickPlacement="BottomRight"
                                    Value="{Binding Rs2dQuadConversionSlider, Mode=TwoWay}" Margin="8,0"/>
                            <TextBlock Grid.Column="2" Text="Prefer higher quality" HorizontalAlignment="Right"
                                       Foreground="#FF64748B" VerticalAlignment="Center"/>
                        </Grid>

                        <CheckBox Content="Highlight unmatched triangles (Q4 only)"
                                  IsChecked="{Binding Rs2dHighlightUnmatched, Mode=TwoWay}" Margin="0,0,0,4"/>
                        <CheckBox Content="Require all quads (strict — block export when triangles remain)"
                                  IsChecked="{Binding Rs2dRequireAllQuads, Mode=TwoWay}" Margin="20,0,0,4"
                                  IsEnabled="{Binding Rs2dHighlightUnmatched}"/>

                        <CheckBox Content="Show solver readiness"
                                  IsChecked="{Binding Rs2dShowSolverReadiness, Mode=TwoWay}" Margin="0,0,0,4"/>

                        <Border Background="#FFFFFFFF" BorderBrush="#FFE2E8F0" BorderThickness="1"
                                CornerRadius="3" Padding="8" Margin="0,8,0,0"
                                Visibility="{Binding Rs2dShowQualityDashboard, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Mesh Quality Dashboard" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SurfaceMeshNodeCount, StringFormat=Nodes: {0}}"/>
                                <TextBlock Text="{Binding SurfaceMeshElementCount, StringFormat=Elements: {0}}"/>
                                <TextBlock Text="{Binding MeshQualityMinAngle, StringFormat=Min angle (deg): {0:F2}}"/>
                                <TextBlock Text="{Binding MeshQualityMaxAspectRatio, StringFormat=Max aspect ratio: {0:F2}}"/>
                                <TextBlock Text="{Binding MeshQualityMaxSkew, StringFormat=Max skew: {0:F2}}"/>
                                <TextBlock Text="{Binding MeshQualityMinJacobian, StringFormat=Min Jacobian: {0:E3}}"/>
                                <TextBlock Text="{Binding MeshQualityGrade, StringFormat=Grade: {0}}"/>
                                <TextBlock Text="{Binding Rs2dUnmatchedCount, StringFormat=Unmatched triangles: {0}}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#FFFFFFFF" BorderBrush="#FFFCD34D" BorderThickness="1"
                                CornerRadius="3" Padding="8" Margin="0,8,0,0"
                                Visibility="{Binding Rs2dShowBestPracticeWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Best-Practice Warnings" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding Rs2dWarningsReadonly}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,2,0,2" Padding="6" Background="#FFFFFBEB"
                                                    BorderBrush="#FFFCD34D" BorderThickness="1" CornerRadius="2">
                                                <StackPanel>
                                                    <TextBlock>
                                                        <Run Text="{Binding Severity}" FontWeight="SemiBold"/>
                                                        <Run Text=": "/>
                                                        <Run Text="{Binding Message}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Suggestion}" Foreground="#FF64748B" FontStyle="Italic"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No warnings — mesh meets the configured best-practice thresholds."
                                           Foreground="#FF16A34A" FontStyle="Italic"
                                           Visibility="{Binding Rs2dWarningCount, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Inverse}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#FFFFFFFF" BorderBrush="#FFCBD5E1" BorderThickness="1"
                                CornerRadius="3" Padding="8" Margin="0,8,0,0"
                                Visibility="{Binding Rs2dShowSolverReadiness, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Solver Readiness" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Rs2dSolverReadinessSeverity, StringFormat=Status: {0}}"/>
                                <TextBlock Text="{Binding Rs2dSolverReadinessStatus}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Expander>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                <Button Command="{Binding Rs2dDiscretizeCommand}" Padding="14,6" Margin="0,0,8,0" MinWidth="108">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="14" Height="14" Margin="0,0,8,0" BorderBrush="#FFDC2626" BorderThickness="1.5" CornerRadius="1"/>
                        <TextBlock Text="Discretize" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding Rs2dMeshCommand}" Padding="14,6" Margin="0,0,8,0" MinWidth="88"
                        IsEnabled="{Binding Rs2dDiscretized}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="16" Height="16" Margin="0,0,8,0">
                            <Rectangle Stroke="#FF64748B" StrokeThickness="1" Fill="#FFF1F5F9"/>
                            <Line X1="4" Y1="5" X2="12" Y2="5" Stroke="#FF94A3B8" StrokeThickness="0.75"/>
                            <Line X1="4" Y1="8" X2="12" Y2="8" Stroke="#FF94A3B8" StrokeThickness="0.75"/>
                            <Line X1="4" Y1="11" X2="12" Y2="11" Stroke="#FF94A3B8" StrokeThickness="0.75"/>
                            <Line X1="4" Y1="5" X2="4" Y2="11" Stroke="#FF94A3B8" StrokeThickness="0.75"/>
                            <Line X1="8" Y1="5" X2="8" Y2="11" Stroke="#FF94A3B8" StrokeThickness="0.75"/>
                            <Line X1="12" Y1="5" X2="12" Y2="11" Stroke="#FF94A3B8" StrokeThickness="0.75"/>
                        </Grid>
                        <TextBlock Text="Mesh" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Content="Clear Mesh" Command="{Binding ClearMeshCommand}" Padding="14,6" Margin="0,0,8,0" MinWidth="96"
                        ToolTip="Remove mesh and discretization from the Mesh tab canvas (same as Standard Meshing Clear)."/>
                <Button Content="OK" Command="{Binding Rs2dOkCommand}" Padding="14,6" Margin="0,0,8,0" MinWidth="72"/>
                <Button Content="Cancel" Command="{Binding Rs2dCancelCommand}" Padding="14,6" MinWidth="72"/>
            </StackPanel>

            <TextBlock Text="Discretize refreshes the surface list from geometry; Mesh generates a graded T3/T6 surface mesh, keeps the current pure-quad Q4 path for 4-node quadrilateral, and uses the native Q8 popup path for 8-node quadrilateral. OK copies Gradation Factor into Surface Mesh boundary growth."
                       FontSize="11" Foreground="#FF64748B" FontStyle="Italic" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
