<UserControl x:Class="GeotechSlopeApp.Views.Tabs.BoundariesPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:converters="clr-namespace:GeotechSlopeApp.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="12">
        <StackPanel Orientation="Vertical">
            <Button Content="Add Stage" 
                    Width="200" 
                    Height="40" 
                    Margin="0,0,0,12"
                    Click="AddStage_Click"/>
            <Button Content="Add Excavation" 
                    Width="200" 
                    Height="40" 
                    Margin="0,0,0,12"
                    Click="AddExcavation_Click"/>
            <Button Content="Add Joint" 
                    Width="200" 
                    Height="40" 
                    Margin="0,0,0,12"
                    Click="AddJoint_Click"/>
            <Button Content="Add Tunnel" 
                    Width="200" 
                    Height="40" 
                    Margin="0,0,0,12"
                    Click="AddTunnel_Click"/>
        </StackPanel>
    </Grid>
</UserControl>


