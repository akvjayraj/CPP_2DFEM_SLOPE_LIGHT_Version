<UserControl x:Class="GeotechSlopeApp.Views.Tabs.SupportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GeotechSlopeApp.Views.Controls"
             xmlns:tabs="clr-namespace:GeotechSlopeApp.Views.Tabs">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="440"/>
        </Grid.ColumnDefinitions>
        <controls:SlopeCanvasView Grid.Column="0"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  DataContext="{Binding GeometryDefinition}"
                                  DoubleClickFitsGeometry="True"
                                  ZoomPanModeEnabled="{Binding DataContext.ZoomPanModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext" Background="#FFE5E7EB"/>
        <Border Grid.Column="2" Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1,0,0,0" Padding="12,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <tabs:SupportDetailsView DataContext="{Binding}"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
