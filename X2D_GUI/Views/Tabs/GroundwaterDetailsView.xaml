<UserControl x:Class="GeotechSlopeApp.Views.Tabs.GroundwaterDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GeotechSlopeApp.Converters"
             Background="{DynamicResource PanelBackgroundBrush}"
             Foreground="{DynamicResource WindowForegroundBrush}">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="RowBackground" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ChromeBorderBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource ChromeBorderBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock TextWrapping="Wrap"
                   Foreground="#FFB45309"
                   Margin="0,0,0,8">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
            <Run Text="Groundwater is not included in the analysis. Enable it via Include Groundwater in Project Settings → Analysis Type → Flow-Seepage/Groundwater."/>
        </TextBlock>

        <TextBlock Text="{Binding StaticMethodRestrictionMessage}"
                   TextWrapping="Wrap"
                   Foreground="#FFB45309"
                   Margin="0,0,0,8"
                   Visibility="{Binding StaticMethodRestrictionMessage, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>

        <GroupBox Header="Pore pressure method" Margin="0,0,0,8" IsEnabled="{Binding IsEnabled}">
            <StackPanel Margin="8">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <RadioButton Content="Phreatic surface (hydrostatic)"
                                 GroupName="GwMethod"
                                 IsChecked="{Binding IsHydrostaticMode}"
                                 IsEnabled="{Binding IsPhreaticEditorAllowed}"
                                 Visibility="{Binding IsPhreaticEditorAllowed, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Margin="0,0,16,0"/>
                    <RadioButton Content="Ru value"
                                 GroupName="GwMethod"
                                 IsChecked="{Binding IsRuMode}"
                                 IsEnabled="{Binding IsRuCoefficientsAllowed}"
                                 Visibility="{Binding IsRuCoefficientsAllowed, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Margin="0,0,16,0"/>
                    <RadioButton Content="B-bar"
                                 GroupName="GwMethod"
                                 IsChecked="{Binding IsBbarMode}"
                                 IsEnabled="{Binding IsRuCoefficientsAllowed}"
                                 Visibility="{Binding IsRuCoefficientsAllowed, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Ru value" Margin="0,0,0,8">
            <GroupBox.Style>
                <Style TargetType="GroupBox">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Setter Property="IsEnabled" Value="False"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                <Condition Binding="{Binding IsRuMode}" Value="True"/>
                                <Condition Binding="{Binding IsRuCoefficientsAllowed}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="IsEnabled" Value="True"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </GroupBox.Style>
            <StackPanel Margin="8">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Ru (0–1):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="80"
                             ToolTip="u = Ru × vertical total stress (σv)"
                             Text="{Binding Ru, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>
                </StackPanel>
                <TextBlock Text="RS2 / Slide2 Problem #18 style pore pressure (Baker–Spencer homogeneous slope)."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="B-bar" Margin="0,0,0,8">
            <GroupBox.Style>
                <Style TargetType="GroupBox">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Setter Property="IsEnabled" Value="False"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                <Condition Binding="{Binding IsBbarMode}" Value="True"/>
                                <Condition Binding="{Binding IsRuCoefficientsAllowed}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="IsEnabled" Value="True"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </GroupBox.Style>
            <StackPanel Margin="8">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="B-bar (0–1):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="80"
                             ToolTip="u = B̄ × vertical total stress (σv). Skempton undrained pore-pressure coefficient."
                             Text="{Binding Bbar, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>
                </StackPanel>
                <TextBlock Text="Undrained total-stress idealisation: pair with an undrained or effective-stress strength model that matches the drainage assumption."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Phreatic surface draw mode" Margin="0,0,0,8">
            <GroupBox.Style>
                <Style TargetType="GroupBox">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Setter Property="IsEnabled" Value="False"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                <Condition Binding="{Binding IsHydrostaticMode}" Value="True"/>
                                <Condition Binding="{Binding IsPhreaticEditorAllowed}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="IsEnabled" Value="True"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </GroupBox.Style>
            <StackPanel Margin="8">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton Content="Horizontal line"
                                 GroupName="GwDrawMode"
                                 IsChecked="{Binding IsHorizontalMode}"
                                 Margin="0,0,16,0"/>
                    <RadioButton Content="Polyline piezometric line"
                                 GroupName="GwDrawMode"
                                 IsChecked="{Binding IsPolylineMode}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8"
                            Visibility="{Binding IsHorizontalMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding WaterTableElevationPrompt}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="120"
                             Text="{Binding WaterTableInput, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddWaterTableCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="Add" Width="70" Margin="8,0,0,0" Command="{Binding AddWaterTableCommand}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding IsPolylineMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="Draw on canvas" Width="120" Margin="0,0,8,0"
                                Command="{Binding StartPolylineDrawCommand}"/>
                        <Button Content="Finish" Width="70" Margin="0,0,8,0"
                                Command="{Binding FinishPolylineDrawCommand}"/>
                        <Button Content="Clear all" Width="70" Command="{Binding ClearGroundwaterCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding PolylineStatus}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Material zone display" Margin="0,0,0,8">
            <GroupBox.Style>
                <Style TargetType="GroupBox">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Setter Property="IsEnabled" Value="False"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                <Condition Binding="{Binding IsHydrostaticMode}" Value="True"/>
                                <Condition Binding="{Binding IsPhreaticEditorAllowed}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="IsEnabled" Value="True"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </GroupBox.Style>
            <StackPanel Margin="8">
                <CheckBox Content="Show saturated material zone"
                          IsChecked="{Binding ShowSaturatedMaterialZone, Mode=TwoWay}"
                          Margin="0,0,0,4"/>
                <CheckBox Content="Show dry material zone"
                          IsChecked="{Binding ShowUnsaturatedMaterialZone, Mode=TwoWay}"
                          Margin="0,0,0,5"/>
                <TextBlock Text="Display only — material properties and solver calculations are unchanged."
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Ponded free water" Margin="0,0,0,8">
            <GroupBox.Style>
                <Style TargetType="GroupBox">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Setter Property="IsEnabled" Value="False"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                <Condition Binding="{Binding IsHydrostaticMode}" Value="True"/>
                                <Condition Binding="{Binding IsPondedFreeWaterAllowed}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="IsEnabled" Value="True"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </GroupBox.Style>
            <StackPanel Margin="8">
                <TextBlock Text="{Binding PondedFreeWaterStatus}"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold"
                           Foreground="#FF0F766E"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Water level method"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton Content="Phreatic line"
                                 IsChecked="{Binding IsPondedPhreaticMethod, Mode=TwoWay}"
                                 GroupName="PondedWaterLevel"
                                 Margin="0,0,16,0"/>
                    <RadioButton Content="Total Head"
                                 IsChecked="{Binding IsPondedTotalHeadMethod, Mode=TwoWay}"
                                 GroupName="PondedWaterLevel"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPondedTotalHeadMethod}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Total Head (axis Y):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="90"
                             Text="{Binding PondedTotalHead, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>
                </StackPanel>
                <TextBlock Text="Display"
                           FontWeight="SemiBold"
                           Margin="0,4,0,4"/>
                <CheckBox Content="Show ponded water"
                          IsChecked="{Binding ShowPondedFreeWaterRegion, Mode=TwoWay}"
                          Margin="0,0,0,4"
                          ToolTip="Draw the ponded free-water region above the ground surface on the Groundwater canvas (also View → Show Ponded Water)."/>
                <StackPanel Orientation="Horizontal" Margin="18,0,0,8">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowPondedFreeWaterRegion}" Value="True">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Pattern:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="160"
                              ItemsSource="{Binding AvailablePondedWaterPatterns}"
                              SelectedValue="{Binding PondedWaterDisplayPattern, Mode=TwoWay}"
                              SelectedValuePath="Pattern"
                              DisplayMemberPath="DisplayName"
                              ToolTip="Fill style for the ponded free-water region on the Groundwater canvas."/>
                </StackPanel>
                <CheckBox Content="Show face-pressure arrows (DistributedEdgeLoads)"
                          IsChecked="{Binding ShowPondedFacePressureArrows, Mode=TwoWay}"
                          Margin="0,0,0,6"
                          ToolTip="Requires a discretized mesh. Draws RS2-style load arrows for hydrostatic ponded face pressures (q = γw · h)."/>
                <CheckBox Content="Show head isobars"
                          IsChecked="{Binding ShowPondedHeadIsobars, Mode=TwoWay}"
                          Margin="0,0,0,6"
                          ToolTip="Draw hydrostatic head contour lines inside the ponded free-water region."/>
                <TextBlock Text="Face pressures auto-assign to exterior free surfaces below the water level (like RS2 Auto Assign). Magnitude uses γw from Project Settings. This does not define seepage Total Head BCs."
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <Expander Header="Saturated / dry material properties"
                  IsExpanded="False"
                  Margin="0,0,0,8">
            <Expander.Style>
                <Style TargetType="Expander">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                <Condition Binding="{Binding IsHydrostaticMode}" Value="True"/>
                                <Condition Binding="{Binding IsPhreaticEditorAllowed}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Expander.Style>
            <StackPanel Margin="8">
                <TextBlock Text="Read-only summary from Material Properties. Strength and stiffness values are shared; groundwater switches γ to γsat below the phreatic surface when enabled."
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"/>
                <DataGrid ItemsSource="{Binding Materials}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          Height="180"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Material" Binding="{Binding Name}" Width="130"/>
                        <DataGridTextColumn Binding="{Binding UnitWeight, StringFormat=F2}" Width="105">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="{Binding DataContext.GammaDryHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridCheckBoxColumn Header="Use γsat"
                                                Binding="{Binding IsSaturatedEnabled}" Width="70"/>
                        <DataGridTextColumn Binding="{Binding SaturatedUnitWeight, StringFormat=F2}" Width="95">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="{Binding DataContext.GammaSatHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Cohesion, StringFormat=F2}" Width="75">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="{Binding DataContext.CohesionHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="φ′ (°)"
                                            Binding="{Binding FrictionAngle, StringFormat=F2}" Width="65"/>
                        <DataGridTextColumn Binding="{Binding YoungsModulus, StringFormat=F0}" Width="90">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="{Binding DataContext.YoungsModulusHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="ν"
                                            Binding="{Binding PoissonsRatio, StringFormat=F3}" Width="55"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Expander>

        <StackPanel Margin="0,0,0,4">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsHydrostaticMode}" Value="True"/>
                                <Condition Binding="{Binding IsPhreaticEditorAllowed}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Free surface points (nosurf / surf):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="Remove selected" Margin="12,0,0,0" Padding="8,2"
                        Command="{Binding RemoveSelectedSurfPointCommand}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding GroundwaterSurfPoints}"
                      SelectedItem="{Binding SelectedSurfPoint, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      Height="200"
                      Margin="0,0,0,12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="40"/>
                    <!-- HeaderTemplate avoids x:Reference→DataContext cycles (DataGrid columns are not in the visual tree). -->
                    <DataGridTextColumn Binding="{Binding AxisX, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding DataContext.SurfPointXHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding AxisY, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding DataContext.SurfPointYHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <GroupBox Header="Water Pressure Grids" Margin="0,0,0,8"
                  IsEnabled="{Binding IsEnabled}">
            <GroupBox.Style>
                <Style TargetType="GroupBox">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAnyWaterPressureGridAllowed}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </GroupBox.Style>
            <StackPanel Margin="8">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Edit Water Pressure Grids..."
                            Padding="10,3"
                            Command="{Binding OpenWaterPressureGridDialogCommand}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTotalHeadGridAllowed}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}">
                        <Run Text="Water Pressure Grid (Total Head) — "/>
                        <Run Text="{Binding TotalHeadGridPointCount, Mode=OneWay}"/>
                        <Run Text=" point(s)"/>
                    </TextBlock>
                    <Button Content="Edit..." Margin="12,0,0,0" Padding="8,2"
                            Command="{Binding OpenWaterPressureGridDialogCommand}"
                            CommandParameter="TotalHead"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPressureHeadGridAllowed}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}">
                        <Run Text="Water Pressure Grid (Pressure Head) — "/>
                        <Run Text="{Binding PressureHeadGridPointCount, Mode=OneWay}"/>
                        <Run Text=" point(s)"/>
                    </TextBlock>
                    <Button Content="Edit..." Margin="12,0,0,0" Padding="8,2"
                            Command="{Binding OpenWaterPressureGridDialogCommand}"
                            CommandParameter="PressureHead"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPorePressureGridAllowed}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}">
                        <Run Text="Water Pressure Grid (Pore Pressure) — "/>
                        <Run Text="{Binding PorePressureGridPointCount, Mode=OneWay}"/>
                        <Run Text=" point(s)"/>
                    </TextBlock>
                    <Button Content="Edit..." Margin="12,0,0,0" Padding="8,2"
                            Command="{Binding OpenWaterPressureGridDialogCommand}"
                            CommandParameter="PorePressure"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Water heads (seepage BCs)" Margin="0,0,0,8" Padding="8"
                  Visibility="{Binding IsWaterHeadAllowed, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"
                           Text="Fill the form, place with Mouse select if needed, then click Add to append a row to the grid. User-defined applies to min-x / max-x faces. Mouse select (Line): click two boundary points like Add Load."/>
                <Border Background="{DynamicResource ViewportPaperBrush}" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="8"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,8,6"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                                 Text="{Binding WaterHeadDraft.Name, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Text="Role:" VerticalAlignment="Center" Margin="0,0,8,6"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"
                                  ItemsSource="{Binding WaterHeadRoles}"
                                  SelectedItem="{Binding WaterHeadDraft.Role, Mode=TwoWay}"/>
                        <TextBlock Grid.Row="2" Text="Definition:" VerticalAlignment="Center" Margin="0,0,8,6"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,6"
                                  ItemsSource="{Binding WaterHeadDefinitionMethods}"
                                  SelectedItem="{Binding WaterHeadDraft.DefinitionMethod, Mode=TwoWay}"/>
                        <TextBlock Grid.Row="3" Text="{Binding WaterHeadDraft.HeadPrompt}" VerticalAlignment="Center" Margin="0,0,8,6" TextWrapping="Wrap"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" Width="100" HorizontalAlignment="Left"
                                 Text="{Binding WaterHeadDraft.Head, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="4" Text="Placement type:" VerticalAlignment="Center" Margin="0,0,8,6"
                                   ToolTip="Line: two clicks (start then end) on the mesh boundary, like Add Load. Point: single node."/>
                        <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,6"
                                  ItemsSource="{Binding WaterHeadPlacementTypes}"
                                  SelectedItem="{Binding WaterHeadDraft.PlacementType, Mode=TwoWay}"
                                  IsEnabled="{Binding WaterHeadDraft.IsMouseSelect}"
                                  ToolTip="Line (recommended): click start then end of the segment. Both ends snap to the nearest mesh node."/>
                        <TextBlock Grid.Row="5" Text="Summary:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding WaterHeadDraft.PlacementSummary}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Add" Command="{Binding AddWaterHeadCommand}" Padding="10,4" Margin="0,0,8,0" MinWidth="88"
                            ToolTip="Add the form values (Name, Role, Definition, Head, Placement) as a new row in the grid."/>
                    <Button Content="Remove" Command="{Binding RemoveWaterHeadCommand}" Padding="10,4" MinWidth="80"
                            ToolTip="Remove the selected grid row."/>
                </StackPanel>
                <TextBlock Text="{Binding WaterHeadPlacementStatus}" TextWrapping="Wrap" Foreground="#FF0369A1" FontStyle="Italic" Margin="0,0,0,6"/>
                <DataGrid ItemsSource="{Binding WaterHeads}"
                          SelectedItem="{Binding SelectedWaterHead, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          MaxHeight="200"
                          Margin="0,0,0,4">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        <DataGridTextColumn Header="Role" Binding="{Binding RoleLabel}" IsReadOnly="True" Width="80"/>
                        <DataGridTextColumn Header="Definition" Binding="{Binding DefinitionLabel}" IsReadOnly="True" Width="90"/>
                        <DataGridTextColumn Header="Head" Binding="{Binding Head, UpdateSourceTrigger=PropertyChanged, StringFormat=G6}" Width="60"/>
                        <DataGridTextColumn Header="Placement type" Binding="{Binding PlacementTypeLabel}" IsReadOnly="True" Width="90"/>
                        <DataGridTextColumn Header="Summary" Binding="{Binding PlacementSummary}" IsReadOnly="True" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                           Text="Tip: set Definition to MouseSelect and Placement to Line, click two points on a boundary, then click Add. The grid stores Name, Role, Definition, Head, Placement type, and Summary."/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Transient consolidation BCs" Margin="0,0,0,8" Padding="8"
                  Visibility="{Binding IsTransientBcAllowed, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <Border Background="{DynamicResource ViewportPaperBrush}" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1"
                        CornerRadius="3" Padding="8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Initial pressure:" VerticalAlignment="Center" Margin="0,0,8,0"
                                   ToolTip="Common initial excess pore pressure for all three transient BC options."/>
                        <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left"
                                 Text="{Binding TransientSettings.InitialPressure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Initial excess pore pressure on free (non-fixed) nodes. Applies to options 1, 2, and 3."/>
                    </Grid>
                </Border>

                <!-- 1. Fixed pressure + Fixed drain faces -->
                <CheckBox Content="1. Fixed pressure / Fixed drain faces"
                          IsChecked="{Binding IsTransientBulkFaceSectionEnabled, Mode=TwoWay}"
                          FontWeight="SemiBold" Margin="0,0,0,6"
                          ToolTip="Bulk bbox drain faces. Checking this collapses sections 2 and 3."/>
                <StackPanel Visibility="{Binding IsTransientBulkFaceSectionEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Margin="0,0,0,4">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"
                               Text="Bulk bbox edges for p84/p88 (Top = max-y, Bottom = min-y). Syncs with Project Settings → Transient State."/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Fixed pressure" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding TransientSettings.FixedPressure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Prescribed pressure on selected drain faces."/>
                    </Grid>
                    <TextBlock Text="Fixed drain faces" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <CheckBox Content="Top (max-y)"
                              IsChecked="{Binding TransientSettings.FixTopFace, Mode=TwoWay}"
                              Margin="0,0,0,4"/>
                    <CheckBox Content="Bottom (min-y)"
                              IsChecked="{Binding TransientSettings.FixBottomFace, Mode=TwoWay}"
                              Margin="0,0,0,4"/>
                    <CheckBox Content="Min-x"
                              IsChecked="{Binding TransientSettings.FixMinXFace, Mode=TwoWay}"
                              Margin="0,0,0,4"/>
                    <CheckBox Content="Max-x"
                              IsChecked="{Binding TransientSettings.FixMaxXFace, Mode=TwoWay}"/>
                </StackPanel>

                <Separator Margin="0,6,0,8"/>

                <!-- 2. UserDefined / MouseSelect (Line) -->
                <CheckBox Content="2. Fixed-pressure BCs (UserDefined / MouseSelect)"
                          IsChecked="{Binding IsTransientInteractiveBcSectionEnabled, Mode=TwoWay}"
                          FontWeight="SemiBold" Margin="0,0,0,6"
                          ToolTip="UserDefined face rows or MouseSelect Line. Checking this collapses sections 1 and 3."/>
                <StackPanel Visibility="{Binding IsTransientInteractiveBcSectionEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"
                               Text="Fill the form, place with MouseSelect if needed, then click Add to append a row to the grid. UserDefined applies to a drain face. MouseSelect (Line): click two boundary points like Add Load."/>
                    <Border Background="{DynamicResource ViewportPaperBrush}" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1"
                            CornerRadius="3" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                                     Text="{Binding TransientFixedPressureDraft.Name, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Text="Drain face:" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"
                                      ItemsSource="{Binding TransientDrainFaces}"
                                      SelectedItem="{Binding TransientFixedPressureDraft.Face, Mode=TwoWay}"
                                      IsEnabled="{Binding TransientFixedPressureDraft.IsUserDefined}"
                                      ToolTip="UserDefined only: select the prescribed-pressure drain face."/>
                            <TextBlock Grid.Row="2" Text="Definition:" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,6"
                                      ItemsSource="{Binding TransientFixedPressureDefinitionMethods}"
                                      SelectedItem="{Binding TransientFixedPressureDraft.DefinitionMethod, Mode=TwoWay}"/>
                            <TextBlock Grid.Row="3" Text="Fixed pressure:" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,0,0,6"
                                     Text="{Binding TransientFixedPressureDraft.Pressure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="4" Text="Placement type:" VerticalAlignment="Center" Margin="0,0,8,6"
                                       ToolTip="Line: click start then end on the mesh boundary, like Add Load."/>
                            <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,6"
                                      ItemsSource="{Binding TransientFixedPressurePlacementTypes}"
                                      SelectedItem="{Binding TransientFixedPressureDraft.PlacementType, Mode=TwoWay}"
                                      IsEnabled="{Binding TransientFixedPressureDraft.IsMouseSelect}"
                                      ToolTip="Section 2 uses Line placement. Both ends snap to the nearest mesh node."/>
                            <TextBlock Grid.Row="5" Text="Summary:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TransientFixedPressureDraft.Summary}"
                                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Add" Command="{Binding AddTransientFixedPressureNodeCommand}"
                                Padding="10,4" Margin="0,0,8,0" MinWidth="88"
                                ToolTip="Add the form values as a fixed-pressure row in the grid."/>
                        <Button Content="Remove" Command="{Binding RemoveTransientFixedPressureNodeCommand}"
                                Padding="10,4" MinWidth="80"
                                ToolTip="Remove the selected grid row."/>
                    </StackPanel>
                    <TextBlock Text="{Binding TransientFixedPressurePlacementStatus}" TextWrapping="Wrap"
                               Foreground="#FF0369A1" FontStyle="Italic" Margin="0,0,0,6"/>
                    <DataGrid ItemsSource="{Binding TransientFixedPressureNodes}"
                              SelectedItem="{Binding SelectedTransientFixedPressureNode, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              MaxHeight="200"
                              Margin="0,0,0,4">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                            <DataGridTextColumn Header="Face" Binding="{Binding FaceLabel}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="Definition" Binding="{Binding DefinitionLabel}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="Pressure" Binding="{Binding Pressure, UpdateSourceTrigger=PropertyChanged, StringFormat=G6}" Width="70"/>
                            <DataGridTextColumn Header="Placement type" Binding="{Binding PlacementTypeLabel}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                               Text="Tip: set Definition to MouseSelect and Placement type to Line, click two points on a boundary, then click Add. The grid stores Name, Face, Definition, Pressure, Placement type, and Summary."/>
                </StackPanel>

                <Separator Margin="0,6,0,8"/>

                <!-- 3. Optional node selection -->
                <CheckBox Content="3. Enable node selection mode"
                          IsChecked="{Binding IsTransientNodeSelectionEnabled, Mode=TwoWay}"
                          FontWeight="SemiBold" Margin="0,0,0,6"
                          ToolTip="Type Node ID(s) or drag a box on the canvas. Checking this collapses sections 1 and 2."/>
                <StackPanel Visibility="{Binding IsTransientNodeSelectionEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"
                               Text="Type one or more Node IDs (e.g. 12 or 12, 15, 18), or drag a box / click on the Groundwater canvas. Then Add selected nodes."/>
                    <Border Background="{DynamicResource ViewportPaperBrush}" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1"
                            CornerRadius="3" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Node ID(s):" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <TextBox Grid.Column="1" Margin="0,0,0,6"
                                     Text="{Binding TransientNodeSelectionIdsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Text="Pressure:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Width="100" HorizontalAlignment="Left"
                                     Text="{Binding TransientNodeSelectionPressure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Add selected nodes" Command="{Binding AddTransientNodeSelectionCommand}"
                                Padding="10,4" MinWidth="130"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TransientNodeSelectionStatus}" TextWrapping="Wrap"
                               Foreground="#FF0369A1" FontStyle="Italic" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding TransientFixedPressureNodes}"
                              SelectedItem="{Binding SelectedTransientFixedPressureNode, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              MaxHeight="170"
                              Margin="0,0,0,4">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                            <DataGridTextColumn Header="Definition" Binding="{Binding DefinitionLabel}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="Pressure" Binding="{Binding Pressure, UpdateSourceTrigger=PropertyChanged, StringFormat=G6}" Width="70"/>
                            <DataGridTextColumn Header="Placement type" Binding="{Binding PlacementTypeLabel}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                               Text="Tip: type Node ID(s) or select nodes on the canvas, set the pressure, then click Add selected nodes. Point rows are stored in the same fixed-pressure BC list."/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}">
            <Run Text="Hydrostatic mode adds phreatic surface points to the script. Ru mode exports method ru and Ru to .dat (no surf points). Include Groundwater and γw are set in Project Settings → Analysis Type → Flow-Seepage/Groundwater; Static checkboxes gate phreatic/Ru/grids; Steady State solver Water Head gates Add Water Head; Transient State shows editable consolidation BCs (drain faces / pressures) here."/>
        </TextBlock>
    </StackPanel>
</UserControl>
