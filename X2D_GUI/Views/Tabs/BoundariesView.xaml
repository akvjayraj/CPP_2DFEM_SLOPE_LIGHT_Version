<UserControl x:Class="GeotechSlopeApp.Views.Tabs.BoundariesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GeotechSlopeApp.Views.Controls">
    <Grid Margin="12">
        <controls:SlopeCanvasView HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  IsGeometryEditable="True"
                                  DataContext="{Binding}"
                                  ZoomPanModeEnabled="{Binding DataContext.ZoomPanModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}"/>
    </Grid>
</UserControl>

