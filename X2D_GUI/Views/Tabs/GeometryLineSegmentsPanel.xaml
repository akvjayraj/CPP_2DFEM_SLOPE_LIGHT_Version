<UserControl x:Class="GeotechSlopeApp.Views.Tabs.GeometryLineSegmentsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GeotechSlopeApp.Converters"
             Background="{DynamicResource PanelBackgroundBrush}"
             Foreground="{DynamicResource WindowForegroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:BooleanNegationConverter x:Key="BooleanNegationConverter" />
        <converters:LineNumberMatchToBooleanConverter x:Key="LineNumberMatchToBooleanConverter" />
        <Style x:Key="LineToolBtn" TargetType="Button">
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ExplorerSelectionBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LineToolBtnWhenDrawLine" TargetType="Button" BasedOn="{StaticResource LineToolBtn}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDrawLineMode}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LineToolBtnWhenDrawArc" TargetType="Button" BasedOn="{StaticResource LineToolBtn}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDrawArcMode}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LineToolBtnWhenDrawCircle" TargetType="Button" BasedOn="{StaticResource LineToolBtn}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDrawCircleMode}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LineCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LineCellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style x:Key="LineCellEdit" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ExplorerSelectionBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <GroupBox Header="Geometry Line Segments"
              Margin="0,0,0,12"
              Foreground="{DynamicResource WindowForegroundBrush}"
              BorderBrush="{DynamicResource ChromeBorderBrush}"
              Background="{DynamicResource PanelBackgroundBrush}">
        <StackPanel Margin="8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Draw"
                            Style="{StaticResource LineToolBtn}"
                            Command="{Binding StartDrawLineModeCommand}"
                            Margin="0,0,6,0"
                            ToolTip="Enter draw-line mode: click two vertices per segment; add many segments. Click Finish (beside Draw Arc) when done."
                            IsEnabled="{Binding IsTunnelCircleDrawingMode, Converter={StaticResource BooleanNegationConverter}}"/>
                    <Button Content="Cancel"
                            Style="{StaticResource LineToolBtnWhenDrawLine}"
                            Command="{Binding CancelDrawLineModeCommand}"
                            Margin="0,0,12,0"
                            ToolTip="Cancel draw-line mode."/>
                    <Button Content="Draw Arc"
                            Style="{StaticResource LineToolBtn}"
                            Command="{Binding StartDrawArcModeCommand}"
                            MinWidth="72"
                            Margin="0,0,6,0"
                            ToolTip="Click three existing vertices on the canvas (start → through → end) to draw an arc."
                            IsEnabled="{Binding IsTunnelCircleDrawingMode, Converter={StaticResource BooleanNegationConverter}}"/>
                    <Button Content="Circle"
                            Style="{StaticResource LineToolBtn}"
                            Command="{Binding StartDrawCircleModeCommand}"
                            MinWidth="56"
                            Margin="0,0,6,0"
                            ToolTip="Click the canvas for center, drag to set radius, release to add a closed circle as line segments."
                            IsEnabled="{Binding IsTunnelCircleDrawingMode, Converter={StaticResource BooleanNegationConverter}}"/>
                    <Button Content="Cancel"
                            Style="{StaticResource LineToolBtnWhenDrawArc}"
                            Command="{Binding CancelDrawArcModeCommand}"
                            Margin="0,0,6,0"
                            ToolTip="Cancel draw-arc mode."/>
                    <Button Content="Cancel"
                            Style="{StaticResource LineToolBtnWhenDrawCircle}"
                            Command="{Binding CancelDrawCircleModeCommand}"
                            Margin="0,0,6,0"
                            ToolTip="Cancel draw-circle mode."/>
                    <Button Content="Finish"
                            Style="{StaticResource LineToolBtnWhenDrawLine}"
                            Command="{Binding FinishDrawLineModeCommand}"
                            MinWidth="64"
                            Margin="0,0,12,0"
                            ToolTip="Stop adding line segments and exit draw-line mode."
                            IsEnabled="{Binding IsTunnelCircleDrawingMode, Converter={StaticResource BooleanNegationConverter}}"/>
                    <TextBlock Text="Shared edge:"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"
                               Foreground="{DynamicResource WindowForegroundBrush}"
                               ToolTip="Connect two existing points (non-consecutive on the boundary). Both surfaces can use the same L# for this edge."/>
                    <ComboBox Width="200"
                              Style="{StaticResource LineCombo}"
                              ItemsSource="{Binding AvailablePointLabels}"
                              SelectedItem="{Binding SharedEdgeFromPointLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="False"
                              Margin="0,0,6,0"/>
                    <TextBlock Text="→"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Foreground="{DynamicResource WindowForegroundBrush}"/>
                    <ComboBox Width="200"
                              Style="{StaticResource LineCombo}"
                              ItemsSource="{Binding AvailablePointLabels}"
                              SelectedItem="{Binding SharedEdgeToPointLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="False"
                              Margin="0,0,8,0"/>
                    <Button Content="Add shared edge"
                            Style="{StaticResource LineToolBtn}"
                            Command="{Binding AddSharedGeometryEdgeCommand}"
                            MinWidth="100"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding IsTunnelCircleDrawingMode, Converter={StaticResource BooleanNegationConverter}}"/>
                    <Button Content="Add Line Segment"
                            Style="{StaticResource LineToolBtn}"
                            Command="{Binding AddLineSegmentCommand}"
                            MinWidth="120"
                            Margin="0,0,8,0"
                            ToolTip="Adds a new row: first available chord between two points that is not already a boundary or shared edge."
                            IsEnabled="{Binding IsTunnelCircleDrawingMode, Converter={StaticResource BooleanNegationConverter}}"/>
                    <Button Content="Delete"
                            Style="{StaticResource LineToolBtn}"
                            Command="{Binding DeleteLineSegmentCommand}"
                            Width="60"
                            IsEnabled="{Binding CanDeleteLineSegment}"/>
                </StackPanel>
            </ScrollViewer>
            <TextBlock Text="{Binding DrawLineModeStatus}"
                       Foreground="#FFEF4444"
                       FontStyle="Italic"
                       FontSize="11"
                       Margin="0,0,0,4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDrawLineMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding DrawArcStatus}"
                       Foreground="#FF7C3AED"
                       FontStyle="Italic"
                       FontSize="11"
                       Margin="0,0,0,4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDrawArcMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding DrawCircleStatus}"
                       Foreground="#FF0D9488"
                       FontStyle="Italic"
                       FontSize="11"
                       Margin="0,0,0,4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDrawCircleMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <DataGrid x:Name="LineSegmentsGrid"
                      ItemsSource="{Binding GeometryLineSegments}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      Height="200"
                      Margin="0,0,0,0"
                      Background="{DynamicResource PanelBackgroundBrush}"
                      Foreground="{DynamicResource WindowForegroundBrush}"
                      RowBackground="{DynamicResource PanelBackgroundBrush}"
                      AlternatingRowBackground="{DynamicResource PanelBackgroundBrush}"
                      HorizontalGridLinesBrush="{DynamicResource ChromeBorderBrush}"
                      VerticalGridLinesBrush="{DynamicResource ChromeBorderBrush}"
                      GridLinesVisibility="All"
                      BorderThickness="0"
                      SelectionChanged="LineSegmentsGrid_SelectionChanged"
                      BeginningEdit="LineSegmentsGrid_BeginningEdit">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Line Number"
                                        Binding="{Binding LineNumber}"
                                        Width="100"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource LineCellText}"/>
                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding EdgeKindLabel}"
                                        Width="72"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource LineCellText}"/>
                    <DataGridTemplateColumn Header="Center X" Width="88" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource LineCellText}">
                                            <Setter Property="Text" Value="—"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCircle}" Value="True">
                                                    <Setter Property="Text" Value="{Binding CircleCenterAxisX, StringFormat={}{0:0.###}}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Center Y" Width="88" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource LineCellText}">
                                            <Setter Property="Text" Value="—"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCircle}" Value="True">
                                                    <Setter Property="Text" Value="{Binding CircleCenterAxisY, StringFormat={}{0:0.###}}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="From Point" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FromPoint}" Style="{StaticResource LineCellText}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox Style="{StaticResource LineCombo}"
                                          ItemsSource="{Binding DataContext.AvailablePointLabels, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          SelectedItem="{Binding FromPoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="False"
                                          IsEnabled="{Binding IsApplied, Converter={StaticResource BooleanNegationConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="To Point" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ToPoint}" Style="{StaticResource LineCellText}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox Style="{StaticResource LineCombo}"
                                          ItemsSource="{Binding DataContext.AvailablePointLabels, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          SelectedItem="{Binding ToPoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="False"
                                          IsEnabled="{Binding IsApplied, Converter={StaticResource BooleanNegationConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Through Pt"
                                        Binding="{Binding ThroughPoint}"
                                        Width="80"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource LineCellText}"/>
                    <DataGridTextColumn Header="Radius"
                                        Binding="{Binding ArcRadius, StringFormat={}{0:0.###}}"
                                        Width="70"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource LineCellText}"/>
                    <DataGridTemplateColumn Header="Tag" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,0">
                                    <TextBox Text="{Binding Tag, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                             Style="{StaticResource LineCellEdit}"
                                             Width="120"/>
                                    <Button Content="Apply"
                                            Style="{StaticResource LineToolBtn}"
                                            Width="50"
                                            Height="22"
                                            MinWidth="50"
                                            Margin="4,0,0,0"
                                            Click="ApplyTagButton_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ExplorerSelectionBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
                                <Setter Property="FontStyle" Value="Italic"/>
                            </DataTrigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource LineNumberMatchToBooleanConverter}">
                                        <Binding />
                                        <Binding Path="DataContext.HighlightedLineNumber" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Background" Value="#CC22C55E"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </StackPanel>
    </GroupBox>
</UserControl>
