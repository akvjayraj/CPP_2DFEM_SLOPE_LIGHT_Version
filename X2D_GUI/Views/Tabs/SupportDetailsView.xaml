<UserControl x:Class="GeotechSlopeApp.Views.Tabs.SupportDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="FE support elements"
                   FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
        <TextBlock TextWrapping="Wrap" Foreground="#FF475569" Margin="0,0,0,10"
                   Text="Property sets hold EA, prestress and capacity. Patterns generate 2-node bars that p610 assembles into K (snapped to nearest mesh nodes). Supports are excluded from SRF by default."/>

        <GroupBox Header="Property sets" Margin="0,0,0,8">
            <StackPanel Margin="8">
                <ListBox ItemsSource="{Binding PropertySets}"
                         SelectedItem="{Binding SelectedPropertySet}"
                         DisplayMemberPath="Name"
                         Height="90" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Add set" Width="80" Margin="0,0,8,0" Command="{Binding AddPropertySetCommand}"/>
                    <Button Content="Delete set" Width="80" Command="{Binding DeletePropertySetCommand}"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Name" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2"
                             Text="{Binding SelectedPropertySet.Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Text="Type" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2"
                              ItemsSource="{Binding AvailableTypes}"
                              SelectedItem="{Binding SelectedPropertySet.Type}"/>
                    <TextBlock Grid.Row="2" Text="EA (kN)" VerticalAlignment="Center"
                               ToolTip="Axial rigidity of one product. Divided by out-of-plane spacing on export."/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2"
                             Text="{Binding SelectedPropertySet.AxialStiffnessKn, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="3" Text="Prestress (kN)" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,2"
                             Text="{Binding SelectedPropertySet.PrestressKn, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="4" Text="Spacing (m)" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,2"
                             Text="{Binding SelectedPropertySet.OutOfPlaneSpacingM, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="5" Text="Tensile cap. (kN)" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Margin="0,2"
                             Text="{Binding SelectedPropertySet.TensileCapacityKn, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Pattern" Margin="0,0,0,8">
            <StackPanel Margin="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Start X" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2"
                             Text="{Binding PatternStartX, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Text="End X" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2"
                             Text="{Binding PatternEndX, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="2" Text="Spacing (m)" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2"
                             Text="{Binding PatternSpacing, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="3" Text="Length (m)" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,2"
                             Text="{Binding PatternLength, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="4" Text="Inclination (°)" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,2"
                             Text="{Binding PatternInclination, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="5" Text="Rows" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Margin="0,2"
                             Text="{Binding PatternRows, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                    <Button Content="Apply pattern" Width="110" Margin="0,0,8,0" Command="{Binding ApplyPatternCommand}"/>
                    <Button Content="Add one" Width="80" Margin="0,0,8,0" Command="{Binding AddElementCommand}"/>
                    <Button Content="Clear all" Width="80" Command="{Binding ClearElementsCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding PatternStatus}" TextWrapping="Wrap" Foreground="#FF475569"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Placements">
            <StackPanel Margin="8">
                <DataGrid ItemsSource="{Binding Elements}"
                          SelectedItem="{Binding SelectedElement, Mode=TwoWay}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          Height="160" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="36"/>
                        <DataGridTextColumn Header="Set" Binding="{Binding PropertySetId}" Width="40"/>
                        <DataGridTextColumn Header="Hx" Binding="{Binding HeadX, StringFormat=F2}" Width="56"/>
                        <DataGridTextColumn Header="Hy" Binding="{Binding HeadY, StringFormat=F2}" Width="56"/>
                        <DataGridTextColumn Header="Tx" Binding="{Binding TailX, StringFormat=F2}" Width="56"/>
                        <DataGridTextColumn Header="Ty" Binding="{Binding TailY, StringFormat=F2}" Width="56"/>
                        <DataGridTextColumn Header="L" Binding="{Binding LengthM, StringFormat=F2}" Width="50" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Content="Delete selected" Width="120" Margin="0,8,0,0" HorizontalAlignment="Left"
                        Command="{Binding DeleteElementCommand}"/>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
