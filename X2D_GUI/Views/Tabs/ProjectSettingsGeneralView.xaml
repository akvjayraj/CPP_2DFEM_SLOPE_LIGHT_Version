<UserControl x:Class="GeotechSlopeApp.Views.Tabs.ProjectSettingsGeneralView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12" Background="#FFF8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Project Title:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox Grid.Row="0" Grid.Column="1" Width="280"
                 Text="{Binding Project.ProjectName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Author:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox Grid.Row="1" Grid.Column="1" Width="280"
                 Text="{Binding Project.Author, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Created On:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <DatePicker Grid.Row="2" Grid.Column="1" Width="180"
                    SelectedDate="{Binding Project.CreatedOn, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Unit System:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <ComboBox Grid.Row="3" Grid.Column="1" Width="180"
                  ItemsSource="{Binding AvailableUnits}"
                  SelectedItem="{Binding Project.Units}"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Bishop max iterations:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox Grid.Row="4" Grid.Column="1" Width="120"
                 Text="{Binding Project.BishopMaxIterations, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Convergence tolerance:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox Grid.Row="5" Grid.Column="1" Width="120"
                 Text="{Binding Project.BishopConvergenceTolerance, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, StringFormat=G6}"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Initial factor guess:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox Grid.Row="6" Grid.Column="1" Width="120"
                 Text="{Binding Project.BishopInitialFactor, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, StringFormat=F3}"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="CRS EPSG:" VerticalAlignment="Center" Margin="0,8,8,8"/>
        <TextBox Grid.Row="7" Grid.Column="1" Width="120"
                 Text="{Binding Project.CoordinateSystem.EpsgCode, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="CRS name:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox Grid.Row="8" Grid.Column="1" Width="280"
                 Text="{Binding Project.CoordinateSystem.Name, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="9" Grid.Column="0" Text="Origin easting:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox Grid.Row="9" Grid.Column="1" Width="180"
                 Text="{Binding Project.CoordinateSystem.OriginEasting, UpdateSourceTrigger=PropertyChanged, StringFormat=G6}"/>

        <TextBlock Grid.Row="10" Grid.Column="0" Text="Origin northing:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox Grid.Row="10" Grid.Column="1" Width="180"
                 Text="{Binding Project.CoordinateSystem.OriginNorthing, UpdateSourceTrigger=PropertyChanged, StringFormat=G6}"/>

        <TextBlock Grid.Row="11" Grid.Column="0" Text="Rotation (deg):" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox Grid.Row="11" Grid.Column="1" Width="120"
                 Text="{Binding Project.CoordinateSystem.RotationDeg, UpdateSourceTrigger=PropertyChanged, StringFormat=G6}"/>

        <TextBlock Grid.Row="12" Grid.Column="0" Text="Scale:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox Grid.Row="12" Grid.Column="1" Width="120"
                 Text="{Binding Project.CoordinateSystem.Scale, UpdateSourceTrigger=PropertyChanged, StringFormat=G6}"/>
    </Grid>
</UserControl>
