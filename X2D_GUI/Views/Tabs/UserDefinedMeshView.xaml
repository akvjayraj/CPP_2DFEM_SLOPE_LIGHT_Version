<UserControl x:Class="GeotechSlopeApp.Views.Tabs.UserDefinedMeshView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GeotechSlopeApp.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvBoolToVis"/>

        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#FF374151"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="#FF94A3B8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="BorderBrush" Value="#FFCBD5E1"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#FF2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#FFFEF2F2"/>
            <Setter Property="BorderBrush" Value="#FFFCA5A5"/>
            <Setter Property="Foreground" Value="#FFB91C1C"/>
        </Style>
        <Style x:Key="SmallBtn" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="BorderBrush" Value="#FFCBD5E1"/>
        </Style>
        <Style x:Key="EditableCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,8,12,16">

            <!-- ══ Intro banner ═══════════════════════════════════════════════ -->
            <Border Background="#FFF0FDF4" BorderBrush="#FF86EFAC" BorderThickness="0,0,0,2"
                    CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⊞ " FontSize="18" Foreground="#FF16A34A" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Structured Mesh"
                                   FontWeight="SemiBold" FontSize="13" Foreground="#FF15803D"/>
                        <TextBlock FontSize="11" Foreground="#FF166534" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="Build structured Q4 or Q8 meshes (embankment, rectangular grid) or enter node/element tables by hand. Paste space-delimited text or use the Q4/Q8 example buttons."/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ══ Section 1: Element type + quick examples ═══════════════════ -->
            <GroupBox Margin="0,0,0,10" Padding="12">
                <GroupBox.Header>
                    <TextBlock Text="Element Type" FontWeight="SemiBold" FontSize="12"/>
                </GroupBox.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Type:" Style="{StaticResource ParamLabel}" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding ElementTypeOptions}"
                                  SelectedItem="{Binding ElementType, Mode=TwoWay}"
                                  Width="90" VerticalAlignment="Center"
                                  ToolTip="Q4 = 4-node quadrilateral  Q8 = 8-node serendipity quadrilateral"/>
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="#FF64748B">
                            <Run Text="Connectivity per element: "/>
                            <Run FontWeight="SemiBold">
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="Text" Value="4 nodes (N1 N2 N3 N4)"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementType}" Value="Q8">
                                                <Setter Property="Text" Value="8 nodes (N1..N8, Smith emb_2d order)"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- ══ Mesh Refinement (drives Generate Hybrid / Quad mesh) ═══════════ -->
            <GroupBox Margin="0,0,0,10" Padding="12">
                <GroupBox.Header>
                    <TextBlock Text="Mesh Refinement" FontWeight="SemiBold" FontSize="12"/>
                </GroupBox.Header>
                <StackPanel>
                    <TextBlock FontSize="10" Foreground="#FF64748B" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="Controls element size for Generate Hybrid Mesh and Generate Quad Mesh. The mesh conforms to material-layer interfaces (horizontal and inclined) defined in Geometry / Material Properties."/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Density preset:" Style="{StaticResource ParamLabel}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding GlobalDensityPresets}"
                                  SelectedItem="{Binding GlobalDensityPreset, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  ToolTip="Preset element size (scales with model). Choose User-defined to type an exact global size."/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Global element size:" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding GlobalMeshSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Courier New" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource HintText}"
                                   Text="Target edge length for interior elements."/>
                    </Grid>
                    <CheckBox Content="Refine toward boundaries (gradation)"
                              IsChecked="{Binding BoundaryGradationEnabled, Mode=TwoWay}"
                              Margin="0,0,0,8"
                              ToolTip="Grade element size from the near-boundary size up to the global size."/>
                    <Grid Margin="0,0,0,8" IsEnabled="{Binding BoundaryGradationEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Near-boundary size:" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding NearBoundaryMeshSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Courier New" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource HintText}"
                                   Text="Smaller edge length next to boundaries and layer interfaces."/>
                    </Grid>
                    <Grid IsEnabled="{Binding BoundaryGradationEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Growth factor:" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding BoundaryGrowthFactor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Courier New" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource HintText}"
                                   Text="Element size multiplier per layer away from boundaries (&gt; 1)."/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- ══ Section 5: Action bar ══════════════════════════════════════ -->
            <Border Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1"
                    CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontSize="11" Foreground="#FF475569" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Run Text="Nodes: "/>
                            <Run FontWeight="SemiBold" Foreground="#FF0369A1"
                                 Text="{Binding NodeRows.Count, Mode=OneWay}"/>
                            <Run Text="   Elements: "/>
                            <Run FontWeight="SemiBold" Foreground="#FF0369A1"
                                 Text="{Binding ElementRows.Count, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource PrimaryBtn}"
                                Command="{Binding DiscretizeCommand}"
                                ToolTip="Discretize all boundaries and material-layer interfaces (horizontal and inclined), same as the Unstructured Mesh Discretize.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x25C8; " FontSize="13"/>
                                <TextBlock Text="Discretize"/>
                            </StackPanel>
                        </Button>
                        <Button Content="Clear" Style="{StaticResource DangerBtn}"
                                Command="{Binding ClearCommand}"
                                ToolTip="Clear the generated mesh from the canvas"/>
                        <Button Style="{StaticResource PrimaryBtn}"
                                Command="{Binding GenerateHybridMeshCommand}"
                                ToolTip="Generate a hybrid mesh from the project geometry: structured quads where the region is a clean quad, graded conforming triangles elsewhere (sizing-field driven).">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◈ " FontSize="13"/>
                                <TextBlock Text="Generate Hybrid Mesh"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryBtn}"
                                Command="{Binding GenerateQuadSweepMeshCommand}"
                                ToolTip="Generate an all-quad mesh: imaginary vertical lines and horizontal rows divide the slope/complex domain into rectangle/trapezium columns meshed with quads only (sloped tops become trapezoidal quads).">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▦ " FontSize="13"/>
                                <TextBlock Text="Generate Quad Mesh"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ Section 6: Status bar ══════════════════════════════════════ -->
            <Border Padding="10,6" CornerRadius="4" Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FFF0FDF4"/>
                        <Setter Property="BorderBrush" Value="#FF86EFAC"/>
                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Background" Value="#FFFFF5F5"/>
                                <Setter Property="BorderBrush" Value="#FFFCA5A5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#FF166534"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="#FF991B1B"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
