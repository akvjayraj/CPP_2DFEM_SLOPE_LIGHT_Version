<UserControl x:Class="GeotechSlopeApp.Views.Tabs.ProjectSettingsAnalysisTypeView"
             x:Name="AnalysisTypeRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GeotechSlopeApp.Converters"
             xmlns:vm="clr-namespace:GeotechSlopeApp.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:ProblemDimensionToBooleanConverter x:Key="ProblemDimensionToBooleanConverter"/>

        <HierarchicalDataTemplate x:Key="AnalysisCategoryTemplate"
                                  DataType="{x:Type vm:AnalysisCategoryNode}"
                                  ItemsSource="{Binding Types}">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Padding="0,2"/>
        </HierarchicalDataTemplate>

        <DataTemplate x:Key="EmptyAnalysisDetailTemplate">
            <TextBlock Text="Select an analysis type from the list to view its options."
                       Foreground="#FF64748B"
                       TextWrapping="Wrap"
                       Margin="4"
                       VerticalAlignment="Top"/>
        </DataTemplate>

        <DataTemplate x:Key="GenericCategoryAnalysisDetailTemplate">
            <StackPanel Margin="4">
                <TextBlock Text="{Binding Name}"
                           FontSize="15"
                           FontWeight="Bold"
                           Margin="0,0,0,10"
                           TextWrapping="Wrap"/>
                <CheckBox Content="ON"
                          FontWeight="SemiBold"
                          IsChecked="{Binding IsOn, Mode=TwoWay}"
                          ToolTip="When ON, analysis functions for this category are available. When OFF, related options and run routing for this category are disabled."
                          Margin="0,0,0,12"/>
                <TextBlock Text="Select a type under this category to view its options."
                           Foreground="#FF64748B"
                           TextWrapping="Wrap"
                           IsEnabled="{Binding IsOn}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="GenericAnalysisDetailTemplate">
            <StackPanel Margin="4">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.AreSelectedCategoryTypeOptionsEnabled, ElementName=AnalysisTypeRoot}" Value="False">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Turn ON this analysis category in the category panel before these options can be changed."
                           Foreground="#FFB45309"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.AreSelectedCategoryTypeOptionsEnabled, ElementName=AnalysisTypeRoot}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Name}"
                           FontSize="15"
                           FontWeight="Bold"
                           Margin="0,0,0,10"
                           TextWrapping="Wrap"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Category:" FontWeight="SemiBold" Margin="0,0,8,8"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Category}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Type:" FontWeight="SemiBold" Margin="0,0,8,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Name}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Dimension:" FontWeight="SemiBold" Margin="0,0,8,8"/>
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="{Binding DataContext.SelectedDimensionLabel, ElementName=AnalysisTypeRoot}"
                               Margin="0,0,0,8"/>
                </Grid>
                <TextBlock Text="No additional options are available for this analysis type."
                           Foreground="#FF64748B"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="GroundwaterCategoryAnalysisDetailTemplate">
            <StackPanel Margin="4">
                <TextBlock Text="Flow-Seepage/Groundwater"
                           FontSize="15"
                           FontWeight="Bold"
                           Margin="0,0,0,12"/>

                <CheckBox Content="ON"
                          FontWeight="SemiBold"
                          IsChecked="{Binding IsOn, Mode=TwoWay}"
                          ToolTip="When ON, Flow-Seepage/Groundwater functions (Groundwater tab, seepage solves, pore-pressure options) are available."
                          Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                            IsEnabled="{Binding IsOn}">
                    <TextBlock Text="{Binding DataContext.GammaWPrompt, ElementName=AnalysisTypeRoot}"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               ToolTip="Pore fluid unit weight (follows Project Settings → General → Unit System). Also sets ponded free-water face-load magnitude (RS2 Pore Fluid Unit Weight)."/>
                    <TextBox Width="80"
                             Text="{Binding DataContext.GroundwaterVM.GammaW, ElementName=AnalysisTypeRoot, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>
                </StackPanel>
                <TextBlock Text="{Binding DataContext.UnitWeightUnitLabel, ElementName=AnalysisTypeRoot, StringFormat=γw uses project unit-weight units ({0}) for hydrostatic pore pressure and ponded free-water face loads.}"
                           TextWrapping="Wrap"
                           Foreground="#FF64748B"
                           Margin="0,0,0,8"
                           IsEnabled="{Binding IsOn}"/>

                <TextBlock Text="After enabling this category (ON), pick a leaf: Static (prescribed pore pressure), Steady State (one-way seepage transfer), or Transient State (θ-method dissipation). Sequential and Fully coupled are listed for the coupling ladder but are not in this release."
                           TextWrapping="Wrap"
                           Foreground="#FF64748B"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="GroundwaterStaticAnalysisDetailTemplate">
            <StackPanel Margin="4">
                <TextBlock Text="Turn ON Flow-Seepage/Groundwater before Static options can be changed."
                           Foreground="#FFB45309"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.AreGroundwaterTypeOptionsEnabled, ElementName=AnalysisTypeRoot}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="Static"
                           FontSize="15"
                           FontWeight="Bold"
                           Margin="0,0,0,6"/>
                <TextBlock Text="Prescribed pore pressure (water table, Ru, B-bar, or grid) is applied as Terzaghi effective stress σ′ = σ + u. This is not a seepage solve and not two-way solid–fluid coupling."
                           TextWrapping="Wrap"
                           Foreground="#FF475569"
                           Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12"
                      IsEnabled="{Binding DataContext.AreGroundwaterTypeOptionsEnabled, ElementName=AnalysisTypeRoot}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Method:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Grid.Column="1"
                            Background="White"
                            BorderBrush="#FFCBD5E1"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="8,4"
                            HorizontalAlignment="Stretch">
                        <TextBlock Text="Prescribed pore pressure"/>
                    </Border>
                </Grid>

                <GroupBox Header="Options" Padding="4" Margin="0,0,0,12"
                          IsEnabled="{Binding DataContext.AreGroundwaterTypeOptionsEnabled, ElementName=AnalysisTypeRoot}">
                    <StackPanel Margin="8"
                                DataContext="{Binding DataContext.GroundwaterStaticSettings, ElementName=AnalysisTypeRoot}">
                        <CheckBox Content="Water Surfaces"
                                  IsChecked="{Binding IncludeWaterSurfaces, Mode=TwoWay}"
                                  Margin="0,0,0,4"/>
                        <CheckBox Content="Ponded free-water pressures"
                                  IsChecked="{Binding IncludePondedFreeWater, Mode=TwoWay}"
                                  IsEnabled="{Binding IncludeWaterSurfaces}"
                                  Margin="20,0,0,10"
                                  ToolTip="Sub-option of Water Surfaces. Applies hydrostatic face loads where free water lies above the ground (RS2 Ponded Water Load / Auto Assign). Water level is defined on the Groundwater tab; magnitude uses γw."/>

                        <CheckBox Content="Ru / B-bar Coefficients"
                                  IsChecked="{Binding IncludeRuCoefficients, Mode=TwoWay}"
                                  Margin="0,0,0,10"
                                  ToolTip="Enables Ru (u = Ru·σv) and B-bar (u = B̄·σv) pore-pressure methods on the Groundwater tab."/>

                        <CheckBox Content="Water Pressure Grid (Total Head)"
                                  IsChecked="{Binding IncludeWaterPressureGridTotalHead, Mode=TwoWay}"
                                  Margin="0,0,0,8"/>
                        <CheckBox Content="Water Pressure Grid (Pressure Head)"
                                  IsChecked="{Binding IncludeWaterPressureGridPressureHead, Mode=TwoWay}"
                                  Margin="0,0,0,8"/>
                        <CheckBox Content="Water Pressure Grid (Pore Pressure)"
                                  IsChecked="{Binding IncludeWaterPressureGridPorePressure, Mode=TwoWay}"/>
                    </StackPanel>
                </GroupBox>

                <TextBlock Text="Water Surfaces and Ru Coefficients control which pore-pressure inputs appear on the Groundwater tab. Ponded free-water pressures is a sub-option of Water Surfaces (face loads for free water above ground). Water Pressure Grid options define an internal pore-pressure field and control exported solver / Results grids. Water Head BCs for seepage are under Steady State. γw (above) sets hydrostatic and ponded load magnitude."
                           TextWrapping="Wrap"
                           Foreground="#FF64748B"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TransientAnalysisDetailTemplate">
            <StackPanel Margin="4">
                <TextBlock Text="Transient State"
                           FontSize="15"
                           FontWeight="Bold"
                           Margin="0,0,0,6"
                           TextWrapping="Wrap"/>
                <TextBlock Text="Transient dissipation of excess pore pressure using the θ-method (p84 / p88). This is not two-way solid–fluid coupling."
                           TextWrapping="Wrap"
                           Foreground="#FF475569"
                           Margin="0,0,0,10"/>
                <TextBlock Text="Turn ON Flow-Seepage/Groundwater before transient options can be changed."
                           Foreground="#FFB45309"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.AreSelectedCategoryTypeOptionsEnabled, ElementName=AnalysisTypeRoot}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel IsEnabled="{Binding DataContext.AreSelectedCategoryTypeOptionsEnabled, ElementName=AnalysisTypeRoot}">
                    <TextBlock Text="{Binding DataContext.TransientSolverNote, ElementName=AnalysisTypeRoot}"
                               Foreground="#FF64748B"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <GroupBox Header="Transient solver" Padding="4" Margin="0,0,0,12">
                        <StackPanel Margin="8">
                            <CheckBox Content="Structured Q4 (p84)"
                                      IsChecked="{Binding DataContext.IsTransientP84Checked, ElementName=AnalysisTypeRoot, Mode=TwoWay}"
                                      Margin="0,0,0,4"
                                      ToolTip="θ-method dissipation on structured Q4 (axisymmetric optional). Other homogeneous meshes auto-route to p88."/>
                            <CheckBox Content="Axisymmetric (p84 structured Q4 only)"
                                      IsChecked="{Binding DataContext.TransientSettings.Axisymmetric, ElementName=AnalysisTypeRoot, Mode=TwoWay}"
                                      Margin="20,0,0,8"
                                      Visibility="{Binding DataContext.IsTransientP84Selected, ElementName=AnalysisTypeRoot, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      ToolTip="Uses 'axisymmetric' 'r' in the p84 deck. Requires a structured rectangular Q4 mesh. Continuum SRF idealization is set in the header above."/>
                            <CheckBox Content="General mesh (p88)"
                                      IsChecked="{Binding DataContext.IsTransientP88Checked, ElementName=AnalysisTypeRoot, Mode=TwoWay}"
                                      Margin="0,0,0,0"
                                      ToolTip="fem_cpp p88 θ-method dissipation for homogeneous T3/T6/Q4/Q8 meshes"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Time integration" Padding="4" Margin="0,0,0,12">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Δt (dtim)" VerticalAlignment="Center" Margin="0,0,12,6"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DataContext.TransientSettings.TimeStep, ElementName=AnalysisTypeRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Steps (nstep)" VerticalAlignment="Center" Margin="0,0,12,6"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DataContext.TransientSettings.NumberOfSteps, ElementName=AnalysisTypeRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Theta (θ)" VerticalAlignment="Center" Margin="0,0,12,6"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DataContext.TransientSettings.Theta, ElementName=AnalysisTypeRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Print interval" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DataContext.TransientSettings.PrintInterval, ElementName=AnalysisTypeRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </GroupBox>

                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SeepageAnalysisDetailTemplate">
            <StackPanel Margin="4">
                <TextBlock Text="Steady State"
                           FontSize="15"
                           FontWeight="Bold"
                           Margin="0,0,0,6"
                           TextWrapping="Wrap"/>
                <TextBlock Text="FE seepage computes heads, then pore pressure u. When SRF is also ON, one-way seepage transfer installs that u in the mechanical run. This is not two-way solid–fluid coupling."
                           TextWrapping="Wrap"
                           Foreground="#FF475569"
                           Margin="0,0,0,10"/>
                <TextBlock Text="Turn ON Flow-Seepage/Groundwater before seepage options can be changed."
                           Foreground="#FFB45309"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.AreSelectedCategoryTypeOptionsEnabled, ElementName=AnalysisTypeRoot}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel IsEnabled="{Binding DataContext.AreSelectedCategoryTypeOptionsEnabled, ElementName=AnalysisTypeRoot}">
                <TextBlock Text="{Binding DataContext.SeepageSolverNote, ElementName=AnalysisTypeRoot}"
                           Foreground="#FF64748B"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <GroupBox Header="Steady seepage solver" Padding="4" Margin="0,0,0,12"
                          Visibility="{Binding DataContext.IsSteadyState2DPanelVisible, ElementName=AnalysisTypeRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="8">
                        <CheckBox Content="Free-surface seepage (unconfined)"
                                  IsChecked="{Binding DataContext.IsSteadyStateFreeSurfaceChecked, ElementName=AnalysisTypeRoot, Mode=TwoWay}"
                                  Margin="0,0,0,4"
                                  ToolTip="Activate fem_cpp p73 unconfined / free-surface seepage"/>
                        <CheckBox Content="Water Head"
                                  IsChecked="{Binding DataContext.SeepageSettings.IncludeWaterHeadFreeSurface, ElementName=AnalysisTypeRoot, Mode=TwoWay}"
                                  IsEnabled="{Binding DataContext.IsSteadyStateFreeSurfaceChecked, ElementName=AnalysisTypeRoot}"
                                  Margin="20,0,0,10"
                                  ToolTip="Enables Add Water Head on the Groundwater tab for this solver (typed and/or mouse-placed total-head BCs)."/>

                        <CheckBox Content="General-mesh seepage"
                                  IsChecked="{Binding DataContext.IsSteadyStateGeneral2DChecked, ElementName=AnalysisTypeRoot, Mode=TwoWay}"
                                  Margin="0,0,0,4"
                                  ToolTip="Activate fem_cpp p74 general-mesh seepage"/>
                        <CheckBox Content="Water Head"
                                  IsChecked="{Binding DataContext.SeepageSettings.IncludeWaterHeadGeneral2D, ElementName=AnalysisTypeRoot, Mode=TwoWay}"
                                  IsEnabled="{Binding DataContext.IsSteadyStateGeneral2DChecked, ElementName=AnalysisTypeRoot}"
                                  Margin="20,0,0,0"
                                  ToolTip="Enables Add Water Head on the Groundwater tab for this solver (typed and/or mouse-placed total-head BCs)."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Steady seepage solver" Padding="4" Margin="0,0,0,12"
                          Visibility="{Binding DataContext.IsSteadyState3DPanelVisible, ElementName=AnalysisTypeRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="8">
                        <CheckBox Content="General 3D seepage"
                                  IsChecked="{Binding DataContext.IsSteadyStateGeneral3DChecked, ElementName=AnalysisTypeRoot, Mode=TwoWay}"
                                  Margin="0,0,0,4"/>
                        <CheckBox Content="Water Head"
                                  IsChecked="{Binding DataContext.SeepageSettings.IncludeWaterHeadGeneral3D, ElementName=AnalysisTypeRoot, Mode=TwoWay}"
                                  IsEnabled="{Binding DataContext.IsSteadyStateGeneral3DChecked, ElementName=AnalysisTypeRoot}"
                                  Margin="20,0,0,0"
                                  ToolTip="Enables Add Water Head on the Groundwater tab for this solver."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Free-surface iteration" Padding="4" Margin="0,0,0,12"
                          Visibility="{Binding DataContext.IsFreeSurfaceSeepageSelected, ElementName=AnalysisTypeRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Convergence tolerance:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                                 Text="{Binding DataContext.SeepageSettings.FreeSurfaceTolerance, ElementName=AnalysisTypeRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Max iterations:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding DataContext.SeepageSettings.FreeSurfaceMaxIterations, ElementName=AnalysisTypeRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </GroupBox>

                <TextBlock Text="Check one solver to activate it. Enable Water Head under that solver, then define Upstream/Downstream (and custom) total-head BCs on the Groundwater tab. Material permeabilities (kx, ky) come from Material Properties; results appear as Total Head and Pressure Head contours."
                           Foreground="#FF64748B"
                           TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="GroundwaterFutureLeafDetailTemplate">
            <StackPanel Margin="4">
                <TextBlock Text="{Binding Name}"
                           FontSize="15"
                           FontWeight="Bold"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap"/>
                <TextBlock Text="Not in this release."
                           FontWeight="SemiBold"
                           Foreground="#FFB45309"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Sequential would apply an undrained increment, dissipate excess pore pressure, then update effective stress. Fully coupled solid–fluid (Biot, 1941) is theory only and is not implemented."
                           TextWrapping="Wrap"
                           Foreground="#FF475569"/>
            </StackPanel>
        </DataTemplate>

        <x:Array x:Key="StageTypeOptions" Type="sys:String">
            <sys:String>Initial Stress</sys:String>
            <sys:String>Gravity Turn-on</sys:String>
            <sys:String>Excavation</sys:String>
            <sys:String>Construction</sys:String>
            <sys:String>Loading</sys:String>
            <sys:String>Consolidation</sys:String>
            <sys:String>Groundwater Change</sys:String>
            <sys:String>Seismic / Dynamic</sys:String>
            <sys:String>Reset Displacements</sys:String>
        </x:Array>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0">
        <StackPanel Margin="12" Background="#FFF8FAFC">
            <Border Background="White"
                    BorderBrush="#FFCBD5E1"
                    BorderThickness="1"
                    Padding="10,8"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Idealization:"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,8"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton Content="Plane strain"
                                     IsChecked="{Binding IsPlaneStrainIdealization, Mode=TwoWay}"
                                     Margin="0,0,16,0"
                                     ToolTip="Standard 2D continuum (plane strain). Mechanical SRF uses the plane-strain solver."/>
                        <RadioButton Content="Axisymmetric"
                                     IsChecked="{Binding IsAxisymmetricIdealization, Mode=TwoWay}"
                                     ToolTip="Axisymmetric continuum (S&amp;G ×r, εθ=u/r). Routes Slope SRF to *_SRF_axisym."/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Engine:"
                               FontWeight="SemiBold"
                               VerticalAlignment="Top"
                               Margin="0,2,8,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding AnalysisEngineSummary}"
                               TextWrapping="Wrap"
                               Foreground="#FF334155"/>
                </Grid>
            </Border>

            <GroupBox Header="Analysis" Margin="0,0,0,0" Padding="8">
                <Grid MinHeight="320">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" MinWidth="140"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="220"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="White"
                            BorderBrush="#FFCBD5E1"
                            BorderThickness="1">
                        <TreeView x:Name="AnalysisTree"
                                  ItemsSource="{Binding AnalysisTree}"
                                  ItemTemplate="{StaticResource AnalysisCategoryTemplate}"
                                  BorderThickness="0"
                                  Background="White"
                                  Padding="4"
                                  SelectedItemChanged="OnAnalysisTreeSelectedItemChanged"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                                    <Setter Property="ToolTip" Value="{Binding DisabledReason}"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <DataTemplate DataType="{x:Type vm:AnalysisTypeNode}">
                                    <TextBlock Text="{Binding Name}"
                                               Padding="0,2"
                                               ToolTip="{Binding DisabledReason}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FF0F172A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Foreground" Value="#FF94A3B8"/>
                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </Border>

                    <GridSplitter Grid.Column="1"
                                  Width="6"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Stretch"
                                  Background="Transparent"
                                  ShowsPreview="False"
                                  ResizeBehavior="PreviousAndNext"
                                  ToolTip="Drag to resize panels">
                        <GridSplitter.Template>
                            <ControlTemplate TargetType="GridSplitter">
                                <Border Background="Transparent" Width="6">
                                    <Rectangle Width="1"
                                               Fill="#FFCBD5E1"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Stretch"/>
                                </Border>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>

                    <Border Grid.Column="2"
                            Background="White"
                            BorderBrush="#FFCBD5E1"
                            BorderThickness="1"
                            Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ContentControl Content="{Binding SelectedAnalysisDetail}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate" Value="{StaticResource GenericAnalysisDetailTemplate}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedAnalysisDetail}" Value="{x:Null}">
                                                <Setter Property="ContentTemplate" Value="{StaticResource EmptyAnalysisDetailTemplate}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsGenericCategoryDetailSelected}" Value="True">
                                                <Setter Property="ContentTemplate" Value="{StaticResource GenericCategoryAnalysisDetailTemplate}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsGroundwaterCategorySelected}" Value="True">
                                                <Setter Property="ContentTemplate" Value="{StaticResource GroundwaterCategoryAnalysisDetailTemplate}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsGroundwaterStaticDetailSelected}" Value="True">
                                                <Setter Property="ContentTemplate" Value="{StaticResource GroundwaterStaticAnalysisDetailTemplate}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSteadyStateDetailSelected}" Value="True">
                                                <Setter Property="ContentTemplate" Value="{StaticResource SeepageAnalysisDetailTemplate}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsTransientStateDetailSelected}" Value="True">
                                                <Setter Property="ContentTemplate" Value="{StaticResource TransientAnalysisDetailTemplate}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsGroundwaterFutureDetailSelected}" Value="True">
                                                <Setter Property="ContentTemplate" Value="{StaticResource GroundwaterFutureLeafDetailTemplate}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </GroupBox>

            <StackPanel Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="Deterministic"
                              IsChecked="{Binding IsDeterministicAnalysis}"
                              FontSize="13"
                              Margin="0,0,16,0"/>
                    <CheckBox Content="Probabilistic"
                              IsChecked="{Binding IsProbabilisticAnalysis}"
                              FontSize="13"/>
                </StackPanel>
                <TextBlock Text="Deterministic uses single-value parameters. Probabilistic enables sensitivity / reliability workflows."
                           Foreground="#FF64748B"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <GroupBox Header="Rapid drawdown" Margin="0,16,0,0" Padding="8"
                      DataContext="{Binding DrawdownSettings}"
                      Visibility="{Binding DataContext.IsRapidDrawdownSectionVisible, ElementName=AnalysisTypeRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <CheckBox Content="Enable staged reservoir drawdown"
                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                              FontWeight="SemiBold"
                              ToolTip="Builds pre/post water-table stages for sequential SRF. Apply a stage to the Groundwater tab, then run FE Analysis."/>
                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Duncan three-stage (drained → undrained hold → lower of drained/undrained), USACE two-stage, or instantaneous drained. Surfaces are prescribed water tables; the undrained stage can hold B-bar pore pressure."
                                   Foreground="#FF475569" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
                        <RadioButton Content="Duncan three-stage" IsChecked="{Binding IsDuncanThreeStage, Mode=TwoWay}" Margin="0,0,0,4"/>
                        <RadioButton Content="USACE two-stage (R envelope)" IsChecked="{Binding IsCorpsTwoStage, Mode=TwoWay}" Margin="0,0,0,4"/>
                        <RadioButton Content="Instantaneous drained" IsChecked="{Binding IsInstantaneousDrained, Mode=TwoWay}" Margin="0,0,0,8"/>
                        <CheckBox Content="Take lower of undrained and drained (Duncan stage 3)"
                                  IsChecked="{Binding TakeLowerOfUndrainedAndDrained, Mode=TwoWay}"
                                  Margin="0,0,0,8"
                                  Visibility="{Binding IsDuncanThreeStage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Pre-drawdown level:" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PreReservoirLevel, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Post-drawdown level:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PostReservoirLevel, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <TextBlock Text="Pre-drawdown water surface" FontWeight="SemiBold" Margin="0,4,0,4"/>
                        <DataGrid ItemsSource="{Binding PreDrawdownSurface}"
                                  AutoGenerateColumns="False" CanUserAddRows="True" Height="90" Margin="0,0,0,4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="X" Binding="{Binding X, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn Header="Y" Binding="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Post-drawdown water surface" FontWeight="SemiBold" Margin="0,4,0,4"/>
                        <DataGrid ItemsSource="{Binding PostDrawdownSurface}"
                                  AutoGenerateColumns="False" CanUserAddRows="True" Height="90" Margin="0,0,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="X" Binding="{Binding X, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn Header="Y" Binding="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Apply pre-drawdown to Groundwater"
                                    Command="{Binding DataContext.ApplyPreDrawdownToGroundwaterCommand, ElementName=AnalysisTypeRoot}"
                                    Padding="8,4" Margin="0,0,8,0"/>
                            <Button Content="Apply post-drawdown to Groundwater"
                                    Command="{Binding DataContext.ApplyPostDrawdownToGroundwaterCommand, ElementName=AnalysisTypeRoot}"
                                    Padding="8,4"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Dimension" Margin="0,16,0,0" Padding="8">
                <StackPanel>
                    <RadioButton Content="1D Problem" IsChecked="{Binding SelectedDimension, Converter={StaticResource ProblemDimensionToBooleanConverter}, ConverterParameter=OneD, Mode=TwoWay}" Margin="0,0,0,4"/>
                    <RadioButton Content="2D Problem" IsChecked="{Binding SelectedDimension, Converter={StaticResource ProblemDimensionToBooleanConverter}, ConverterParameter=TwoD, Mode=TwoWay}" Margin="0,0,0,4"/>
                    <RadioButton Content="3D Problem" IsChecked="{Binding SelectedDimension, Converter={StaticResource ProblemDimensionToBooleanConverter}, ConverterParameter=ThreeD, Mode=TwoWay}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Stage Analysis" Margin="0,16,0,0" Padding="8">
                <StackPanel>
                    <CheckBox Content="Enable Staged Analysis"
                              IsChecked="{Binding StagedExcavationEnabled, Mode=TwoWay}"
                              FontWeight="SemiBold"
                              ToolTip="Perform sequential analysis for each construction/excavation stage."/>

                    <StackPanel Margin="0,10,0,0"
                                Visibility="{Binding StagedExcavationEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,12,0">
                                <Run Text="{Binding StageDefinitionCount, Mode=OneWay, StringFormat='{}{0} stage(s) defined.'}"/>
                            </TextBlock>
                            <CheckBox Content="Edit stages…"
                                      IsChecked="{Binding IsStageEditorExpanded, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      ToolTip="Show or hide the stage table. Enable + count stay visible."/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsStageEditorExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Background="#FFEFF6FF"
                                BorderBrush="#FFB3D1FF"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,7"
                                Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x24D8;  " Foreground="#FF2563EB" FontSize="13"/>
                                <TextBlock Foreground="#FF1E3A8A" FontSize="12" TextWrapping="Wrap">
                                    <Run Text="Define construction stages sequentially. Each stage inherits the stress state from the previous one."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <ToolBar Background="Transparent" Margin="0,0,0,4" Padding="0">
                            <Button Command="{Binding AddStageDefinitionCommand}"
                                    Padding="10,4" ToolTip="Add a new stage below the last">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="+" FontWeight="Bold" Margin="0,0,4,0"/>
                                    <TextBlock Text="Add Stage"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RemoveStageDefinitionCommand}"
                                    Padding="10,4" ToolTip="Delete the selected stage">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="−" FontWeight="Bold" Margin="0,0,4,0"/>
                                    <TextBlock Text="Remove"/>
                                </StackPanel>
                            </Button>
                            <Separator/>
                            <Button Command="{Binding MoveStageUpCommand}"
                                    Padding="10,4" ToolTip="Move selected stage up">
                                <TextBlock Text="▲  Up"/>
                            </Button>
                            <Button Command="{Binding MoveStageDownCommand}"
                                    Padding="10,4" ToolTip="Move selected stage down">
                                <TextBlock Text="▼  Down"/>
                            </Button>
                        </ToolBar>

                        <DataGrid ItemsSource="{Binding StageDefinitions}"
                                  SelectedItem="{Binding SelectedStageDefinition, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="False"
                                  CanUserResizeColumns="True"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  MinHeight="120"
                                  MaxHeight="300"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#FFF8FAFC"
                                  Background="White"
                                  BorderBrush="#FFCBD5E1"
                                  BorderThickness="1"
                                  RowHeight="28"
                                  FontSize="12">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#FFF1F5F9"/>
                                    <Setter Property="BorderBrush" Value="#FFCBD5E1"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Stage #"
                                                    Binding="{Binding StageNumber}"
                                                    Width="130"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#FF475569"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Stage Name"
                                                    Binding="{Binding StageName, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*"
                                                    MinWidth="200">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="4,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Stage Type" Width="340">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StageType}"
                                                       VerticalAlignment="Center"
                                                       Padding="4,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedItem="{Binding StageType, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{StaticResource StageTypeOptions}"
                                                      IsEditable="False"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Description"
                                                    Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*"
                                                    MinWidth="200">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="4,0"/>
                                            <Setter Property="Foreground" Value="#FF64748B"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridCheckBoxColumn Header="Active"
                                                        Binding="{Binding IsActive}"
                                                        Width="116">
                                    <DataGridCheckBoxColumn.ElementStyle>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridCheckBoxColumn.ElementStyle>
                                </DataGridCheckBoxColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Double-click a cell to edit. Stage Type determines how loads and geometry changes are applied."
                                   Foreground="#FF94A3B8"
                                   FontSize="11"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
