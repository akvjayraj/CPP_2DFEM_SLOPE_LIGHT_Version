<UserControl x:Class="GeotechSlopeApp.Views.Tabs.FieldStationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GeotechSlopeApp.Converters">
    <UserControl.Resources>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
    </UserControl.Resources>
    <DockPanel Margin="4">
        <TextBlock DockPanel.Dock="Top" Text="Field Stations"
                   FontSize="15" FontWeight="Bold" Foreground="#FF2E74B5" Margin="0,0,0,8"/>

        <Border DockPanel.Dock="Bottom" BorderBrush="#FFE2E8F0" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
            <StackPanel>
                <CheckBox Content="Field Stations active"
                          IsChecked="{Binding FieldStationsActive, Mode=TwoWay}"
                          FontWeight="SemiBold"
                          Margin="0,0,0,6"/>
                <CheckBox Content="Plot boreholes on canvas"
                          IsChecked="{Binding PlotBoreholes, Mode=TwoWay}"
                          Margin="0,0,0,6"
                          ToolTip="Show borehole columns on the Geometry Definition and Material Properties canvases. Use the Plot Boreholes toolbar button on each tab to show or hide that canvas only."/>
                <CheckBox Content="Extend outer contacts to model boundary"
                          IsChecked="{Binding ExtendSoilRegionsToBoundary, Mode=TwoWay}"
                          Margin="0,0,0,6"
                          ToolTip="When finishing a drawn non-horizontal layer, extend it to the left and right of the soil block."/>
                <WrapPanel Margin="0,0,0,6">
                    <DockPanel Margin="0,0,16,4">
                        <TextBlock Text="Block margin" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding FieldStationSoilBlockMargin, UpdateSourceTrigger=PropertyChanged}"
                                 Width="72" VerticalAlignment="Center"
                                 ToolTip="Padding around the borehole bounding box when creating the soil block."/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Reference elevation" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding FieldStationReferenceElevation, UpdateSourceTrigger=PropertyChanged}"
                                 Width="72" VerticalAlignment="Center"
                                 ToolTip="Added to every imported collar / Top Y / Bottom Y (model Y = imported + this). 0 = use imported elevations as-is. Changing this does not rewrite existing geometry; re-create the soil block and re-commit if cuts should move."/>
                    </DockPanel>
                </WrapPanel>
                <TextBlock Text="Horizontal: Commit interfaces. Non-horizontal: Draw non-horizontal layer (snaps to borehole contacts). Cut the slope with Geometry Definition."
                           Foreground="#FF64748B" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Left" Content="Import…" MinWidth="88" Padding="10,3" Margin="0,0,8,0"
                        Command="{Binding ImportFieldStationsCommand}"/>
                <Button DockPanel.Dock="Left" Content="Commit interfaces" MinWidth="130" Padding="10,3" Margin="0,0,8,0"
                        Command="{Binding CommitFieldStationsCommand}"
                        IsEnabled="{Binding CanCommitFieldStations}"
                        ToolTip="{Binding FieldStationCommitHint}"
                        ToolTipService.ShowOnDisabled="True"/>
                <Button DockPanel.Dock="Left" Content="Create material" MinWidth="110" Padding="10,3" Margin="0,0,8,0"
                        Command="{Binding CreateMaterialForSelectedUnitCommand}"
                        ToolTip="Create a Mohr–Coulomb library material for each unmapped unit and assign it."/>
                <Button DockPanel.Dock="Left" Content="Create soil block" MinWidth="120" Padding="10,3" Margin="0,0,8,0"
                        Command="{Binding CreateSoilBlockCommand}"
                        IsEnabled="{Binding CanCreateSoilBlock}"
                        ToolTip="Create a closed rectangle that contains every borehole (plus Block margin)."/>
                <Button DockPanel.Dock="Left" Content="Draw non-horizontal layer…" MinWidth="170" Padding="10,3"
                        Command="{Binding DrawNonHorizontalFieldStationLayerCommand}"
                        IsEnabled="{Binding CanCreateSoilBlock}"
                        ToolTip="Draw an inclined interface. Clicks snap to borehole contacts. Finish with Add Layer on Material Properties or Geometry."/>
                <TextBlock Text="{Binding FieldStationStatusText}" VerticalAlignment="Center"
                           Foreground="#FF334155" Margin="12,0,0,0" TextWrapping="Wrap"/>
            </DockPanel>

            <GroupBox Header="Unit → Material" DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="6" MaxHeight="200">
                <DataGrid ItemsSource="{Binding FieldStations.UnitMaterialMap}"
                          SelectedItem="{Binding SelectedFieldUnitMapRow, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          GridLinesVisibility="Horizontal"
                          MaxHeight="180">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Unit" Binding="{Binding UnitCode}" Width="*" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Colour" Width="52">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="24" Height="14" CornerRadius="2"
                                            Background="{Binding ColourBrush}" Margin="4,2"
                                            ToolTip="Double-click to pick a colour for this unit (borehole log and Create material)"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ListBox ItemsSource="{Binding DataContext.FieldStationColourPalette, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             SelectedItem="{Binding Colour, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MaxHeight="120" BorderThickness="1" BorderBrush="#FFE2E8F0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="18" Height="14" CornerRadius="2"
                                                        Background="{Binding Converter={StaticResource ColorToBrushConverter}}" Margin="1"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Material" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.FieldStationMaterialChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedValue="{Binding MaterialId, UpdateSourceTrigger=PropertyChanged, TargetNullValue=0}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Name"
                                              Margin="0,1"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Header="Stations" Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="90"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="80"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding FieldStations.Stations}"
                              SelectedItem="{Binding SelectedFieldStation, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Station" Binding="{Binding Id}" Width="80"/>
                            <DataGridTextColumn Header="X" Binding="{Binding X}" Width="70"/>
                            <DataGridTextColumn Header="Collar Y" Binding="{Binding CollarY}" Width="80"/>
                            <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="Unit stack (selected station)" FontWeight="SemiBold"
                               Margin="0,8,0,4" Foreground="#FF475569"/>
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding SelectedFieldStation.Intervals}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Top Y" Binding="{Binding TopY}" Width="80"/>
                            <DataGridTextColumn Header="Bottom Y" Binding="{Binding BottomY}" Width="80"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding UnitCode}" Width="100"/>
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
        </DockPanel>
    </DockPanel>
</UserControl>
