<UserControl x:Class="GeotechSlopeApp.Views.Controls.FEVectorCanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ZoomPanBorder hosts mouse events for wheel-zoom, middle-button pan, and
         left-drag zoom-box select. Double-click resets the view, matching the
         contour view's UX so the two visualisations behave identically. -->
    <Border x:Name="ZoomPanBorder" Background="White" ClipToBounds="True"
            PreviewMouseWheel="VectorCanvas_PreviewMouseWheel"
            MouseLeftButtonDown="VectorCanvas_MouseLeftButtonDown"
            MouseDown="VectorCanvas_MouseDown"
            MouseMove="VectorCanvas_MouseMove"
            MouseLeftButtonUp="VectorCanvas_MouseLeftButtonUp"
            MouseUp="VectorCanvas_MouseUp"
            MouseLeave="VectorCanvas_MouseLeave">
        <Grid>
            <Canvas x:Name="VectorCanvas">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ZoomScaleTransform" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="ZoomTranslateTransform" X="0" Y="0"/>
                    </TransformGroup>
                </Canvas.RenderTransform>
                <!-- Vector arrows + mesh wireframe will be rendered here -->
            </Canvas>
            <Canvas x:Name="AxisOverlayCanvas" IsHitTestVisible="False"/>
            <Canvas IsHitTestVisible="False">
                <Rectangle x:Name="ZoomRect"
                           Visibility="Collapsed"
                           Stroke="#FF0EA5E9"
                           StrokeThickness="1.5"
                           StrokeDashArray="3 3"
                           Fill="#4010B981"/>
            </Canvas>
        </Grid>
    </Border>
</UserControl>
