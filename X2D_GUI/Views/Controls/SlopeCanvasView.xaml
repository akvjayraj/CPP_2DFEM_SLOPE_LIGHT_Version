                              Panel.ZIndex="10"
                              IsHitTestVisible="False"
                              Visibility="{Binding IsPondedHeadIsobarsVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Line X1="{Binding X1}" Y1="{Binding Y1}"
                                  X2="{Binding X2}" Y2="{Binding Y2}"
                                  Stroke="#990F766E"
                                  StrokeThickness="1"
                                  StrokeDashArray="4 3"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Auto-assigned ponded face pressures (DistributedEdgeLoads) as load arrows -->
                <controls:LineLoadOverlayView ItemsSource="{Binding PondedFacePressureOverlays}"
                                              Panel.ZIndex="17"
                                              IsHitTestVisible="False"
                                              Visibility="{Binding IsPondedFacePressureArrowsVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>
                <!-- Transient p84/p88 prescribed-pressure bbox faces -->
                <ItemsControl ItemsSource="{Binding TransientPressureBoundaryOverlays}"
                              Width="{Binding CanvasWidth}"
                              Height="{Binding CanvasHeight}"
                              Panel.ZIndex="18"
                              IsHitTestVisible="False"
                              Visibility="{Binding IsTransientPressureOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas ClipToBounds="False"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas ClipToBounds="False">
                                <Polyline Points="{Binding EdgePoints}"
                                          Stroke="{Binding Stroke, TargetNullValue=#FFBE123C}"
                                          StrokeThickness="{Binding StrokeThickness}"
                                          StrokeDashArray="7 3"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent"/>
                                <ItemsControl ItemsSource="{Binding Labels}" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}"
                                                       FontSize="{Binding FontSize}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FF9F1239"
                                                       Background="#F2FFF1F2"
                                                       Padding="3,1">
                                                <TextBlock.RenderTransform>
                                                    <TranslateTransform X="{Binding OffsetX}" Y="{Binding OffsetY}"/>
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Groundwater Add Water Head → Mouse select line segments -->
                <ItemsControl ItemsSource="{Binding WaterHeadOverlays}"
                              Width="{Binding CanvasWidth}"
                              Height="{Binding CanvasHeight}"
                              Panel.ZIndex="19"
                              IsHitTestVisible="False"
                              Visibility="{Binding IsWaterHeadOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas ClipToBounds="False"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas ClipToBounds="False">
                                <Polyline Points="{Binding EdgePoints}"
                                          Stroke="{Binding Stroke, TargetNullValue=#FF1D4ED8}"
                                          StrokeThickness="{Binding StrokeThickness}"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent"/>
                                <Line X1="{Binding BracketStart.X}"
                                      Y1="{Binding BracketStart.Y}"
                                      X2="{Binding BracketEnd.X}"
                                      Y2="{Binding BracketEnd.Y}"
                                      Stroke="{Binding Stroke, TargetNullValue=#FF2563EB}"
                                      StrokeThickness="{Binding StrokeThickness}"/>
                                <ItemsControl ItemsSource="{Binding Labels}" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}"
                                                       FontSize="{Binding FontSize}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FF1E3A8A"
                                                       Background="#E6FFFFFF"
                                                       Padding="2,0">
                                                <TextBlock.RenderTransform>
                                                    <TranslateTransform X="{Binding OffsetX}" Y="{Binding OffsetY}"/>
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding PondedWaterCallouts}"
                              Panel.ZIndex="12"
                              IsHitTestVisible="False"
                              Visibility="{Binding IsPondedFreeWaterOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Canvas.Left="{Binding X}"
                                       Canvas.Top="{Binding Y}"
                                       Text="{Binding Text}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="#FF134E4A"
                                       Background="#E0F0FDFA"
                                       Padding="3,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Transient initial pressure is a domain initial condition, not a fixed face. -->
                <ItemsControl ItemsSource="{Binding TransientPressureCallouts}"
                              Panel.ZIndex="18"
                              IsHitTestVisible="False"
                              Visibility="{Binding IsTransientPressureOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Canvas.Left="{Binding X}"
                                       Canvas.Top="{Binding Y}"
                                       Text="{Binding Text}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#FF7C2D12"
                                       Background="#F2FFF7ED"
                                       Padding="4,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding TransientFixedPressureNodeOverlays}"
                              Panel.ZIndex="20"
                              IsHitTestVisible="False"
                              Visibility="{Binding IsTransientPressureOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas ClipToBounds="False"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas>
                                <Ellipse Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}"
                                         Width="12" Height="12">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="-6" Y="-6"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#FFFDA4AF"/>
                                            <Setter Property="Stroke" Value="#FFBE123C"/>
                                            <Setter Property="StrokeThickness" Value="2"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Fill" Value="#FFFFEDD5"/>
                                                    <Setter Property="Stroke" Value="#FFEA580C"/>
                                                    <Setter Property="StrokeThickness" Value="3"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}"
                                           Text="{Binding Text}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#FF9F1239"
                                           Background="#F2FFFFFF"
                                           Padding="3,1">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform X="8" Y="-18"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Polyline Points="{Binding PondedWaterLevelPolyline}"
                          Panel.ZIndex="11"
                          Stroke="#FF0F766E"
                          StrokeThickness="2"
                          StrokeDashArray="6 3"
                          Fill="Transparent"
                          IsHitTestVisible="False"
                          Visibility="{Binding IsPondedFreeWaterOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>
                <Polyline Points="{Binding GroundwaterPhreaticPolyline}"
                          Panel.ZIndex="11"
                          Stroke="#FF0284C7"
                          StrokeThickness="2.5"
                          Fill="Transparent"
                          IsHitTestVisible="False"
                          Visibility="{Binding IsGroundwaterPhreaticVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>
                <ItemsControl ItemsSource="{Binding GroundwaterSurfPointMarkers}"
                              Panel.ZIndex="12"
                              IsHitTestVisible="False"
                              Visibility="{Binding IsGroundwaterPhreaticVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas>
                                <Ellipse Canvas.Left="{Binding X}"
                                         Canvas.Top="{Binding Y}">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <TranslateTransform X="-4" Y="-4"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Width" Value="8"/>
                                            <Setter Property="Height" Value="8"/>
                                            <Setter Property="Fill" Value="#FF1D4ED8"/>
                                            <Setter Property="Stroke" Value="White"/>
                                            <Setter Property="StrokeThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                    <Setter Property="Width" Value="10"/>
                                                    <Setter Property="Height" Value="10"/>
                                                    <Setter Property="Fill" Value="#FFF97316"/>
                                                    <Setter Property="StrokeThickness" Value="2"/>
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <TranslateTransform X="-5" Y="-5"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Canvas.Left="{Binding X}"
                                           Canvas.Top="{Binding Y}"
                                           Text="{Binding Index}"
                                           FontSize="7"
                                           FontWeight="SemiBold"
                                           Foreground="#FF0F172A"
                                           Background="#F9FFFFFF"
                                           Padding="1,0.5"
                                           Panel.ZIndex="1">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform X="6" Y="-12"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- Mesh discretization nodes: tiny red + (RS2D boundary preview) -->
                <ItemsControl ItemsSource="{Binding MeshDiscretizationNodes}"
                              Panel.ZIndex="15"
                              IsHitTestVisible="False"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              Visibility="{Binding ShowMeshDiscretizationMarkers, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Location.X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Location.Y}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas>
                                <Line X1="-2" Y1="0" X2="2" Y2="0" Stroke="Red" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="0" Y1="-2" X2="0" Y2="2" Stroke="Red" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="-1.5" Y1="0" X2="1.5" Y2="0" Stroke="#FFEF4444" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="{Binding IsHighlighted, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <Line X1="0" Y1="-1.5" X2="0" Y2="1.5" Stroke="#FFEF4444" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="{Binding IsHighlighted, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- User-defined / table-selected node (visible even when discretization markers are off) -->
                <ItemsControl ItemsSource="{Binding HighlightedMeshDiscretizationNodes}"
                              Panel.ZIndex="17"
                              IsHitTestVisible="False"
                              Visibility="{Binding ShowHighlightedMeshNodeOverlay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Location.X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Location.Y}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas>
                                <Ellipse Width="7" Height="7" Canvas.Left="-3.5" Canvas.Top="-3.5"
                                         Fill="#40EF4444" Stroke="#FFEF4444" StrokeThickness="1"/>
                                <Line X1="-2" Y1="0" X2="2" Y2="0" Stroke="#FFEF4444" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="0" Y1="-2" X2="0" Y2="2" Stroke="#FFEF4444" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- Mesh Node Numbers (Red) - 0-based, matches FE solver / BC DataGrid -->
                <ItemsControl ItemsSource="{Binding MeshNodeLabelItems}"
                              Panel.ZIndex="16"
                              IsHitTestVisible="False"
                              Visibility="{Binding ShowMeshNodes, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Counter-scale label so it stays roughly constant on-screen pixel size at any
                                 world-zoom level, preventing overlapping when the user zooms tight on the mesh. -->
                            <TextBlock Text="{Binding NodeId}"
                                       FontFamily="Segoe UI"
                                       FontSize="7"
                                       FontWeight="Normal"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="6" Y="-12"/>
                                </TextBlock.RenderTransform>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFDC2626"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ShowMeshNodes, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                <Setter Property="Foreground" Value="#FFEF4444"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- Mesh Elements - Smith / textbook style: thick black quad outlines (always shown when discretized) -->
                <ItemsControl ItemsSource="{Binding MeshElements}"
                              Panel.ZIndex="11"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas IsHitTestVisible="False"
                                    Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Polygon Points="{Binding Nodes}"
                                         Stretch="None"
                                         FillRule="NonZero"
                                         SnapsToDevicePixels="True"
                                         RenderOptions.EdgeMode="Aliased">
                                    <Polygon.Style>
                                        <Style TargetType="Polygon">
                                            <Setter Property="Stroke" Value="#FF000000"/>
                                            <Setter Property="StrokeThickness" Value="1.25"/>
                                            <Setter Property="StrokeLineJoin" Value="Miter"/>
                                            <Setter Property="Fill" Value="{Binding Fill, TargetNullValue={x:Static Brushes.Transparent}, FallbackValue={x:Static Brushes.Transparent}}"/>
                                            <Setter Property="Opacity" Value="1.0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                    <Setter Property="Stroke" Value="#FFEF4444"/>
                                                    <Setter Property="StrokeThickness" Value="1.75"/>
                                                    <Setter Property="Fill" Value="#40EF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Polygon.Style>
                                </Polygon>
                                <ItemsControl ItemsSource="{Binding MidsideMarkerPoints}"
                                              IsHitTestVisible="False"
                                              Visibility="Collapsed">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="2.5"
                                                     Height="2.5"
                                                     Fill="#FFE9D5FF"
                                                     Stroke="#FF6D28D9"
                                                     StrokeThickness="0.5"
                                                     Opacity="0.95"
                                                     SnapsToDevicePixels="True"
                                                     RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <TranslateTransform X="-1.25" Y="-1.25"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- Element Numbers (blue, shown only when element checkbox is checked) -->
                <ItemsControl ItemsSource="{Binding MeshElementLabelItems}"
                              Panel.ZIndex="12"
                              IsHitTestVisible="False"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              Visibility="{Binding ShowMeshElements, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding CenterX}"/>
                            <Setter Property="Canvas.Top" Value="{Binding CenterY}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Counter-scale label so it stays roughly constant on-screen pixel size at any
                                 world-zoom level, preventing overlapping when the user zooms tight on excavations. -->
                            <TextBlock Text="{Binding DisplayId}"
                                       FontFamily="Segoe UI"
                                       FontSize="8"
                                       FontWeight="Normal"
                                       Width="{Binding LabelWidth}"
                                       TextAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="{Binding LabelOffsetX}" Y="{Binding LabelOffsetY}"/>
                                </TextBlock.RenderTransform>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FF1D4ED8"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsActive}" Value="True"/>
                                                    <Condition Binding="{Binding DataContext.ShowMeshElements, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- ══ Boundary Condition markers (BC tab only) ══
                     RS2-style color-coded glyphs per BC type / analysis family.
                     Visibility is gated by ShowBcMarkers (Boundary Conditions canvas wrapper only). -->
                <ItemsControl ItemsSource="{Binding BcCanvasMarkers}"
                              Panel.ZIndex="16"
                              IsHitTestVisible="True"
                              Visibility="{Binding ShowBcMarkers, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:BcSymbolGlyph Kind="{Binding Kind}"
                                                    Width="8" Height="8"
                                                    ToolTip="{Binding ToolTipText}"
                                                    IsHitTestVisible="True"
                                                    RenderTransformOrigin="0.5,0.5"
                                                    Opacity="0.95">
                                <controls:BcSymbolGlyph.RenderTransform>
                                    <TranslateTransform X="-4" Y="-4"/>
                                </controls:BcSymbolGlyph.RenderTransform>
                            </controls:BcSymbolGlyph>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- RS2D-style distributed line loads (Load / BC / Groundwater tabs) -->
                <controls:LineLoadOverlayView ItemsSource="{Binding LineLoadOverlays}"
                                              Panel.ZIndex="18"
                                              IsHitTestVisible="False"
                                              Visibility="{Binding ShowLineLoadOverlaysOnCanvas, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <controls:PointLoadOverlayView ItemsSource="{Binding PointLoadOverlays}"
                                               Panel.ZIndex="18"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding ShowPointLoadOverlaysOnCanvas, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <!-- Boundary Edges - Inside ScaledGeometryLayer -->
                <ItemsControl ItemsSource="{Binding BoundaryEdgeNodes}"
                              Panel.ZIndex="12"
                              IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Line X1="{Binding NodeAPosition.X}"
                                  Y1="{Binding NodeAPosition.Y}"
                                  X2="{Binding NodeBPosition.X}"
                                  Y2="{Binding NodeBPosition.Y}"
                                  SnapsToDevicePixels="True"
                                  RenderOptions.EdgeMode="Aliased">
                                <Line.Style>
                                    <Style TargetType="Line">
                                        <Setter Property="Stroke" Value="#FF3B82F6"/>
                                        <Setter Property="StrokeThickness" Value="1.5"/>
                                        <Setter Property="Opacity" Value="0.8"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                <Setter Property="Stroke" Value="#FFEF4444"/>
                                                <Setter Property="StrokeThickness" Value="4"/>
                                                <Setter Property="Opacity" Value="1.0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Line.Style>
                            </Line>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
</Canvas>
                <!-- End of ScaledGeometryLayer -->
                <Border Canvas.Left="{Binding GeometryHudCanvasPosition.X}"
                        Canvas.Top="{Binding GeometryHudCanvasPosition.Y}"
                        Background="#CC0F172A"
                        CornerRadius="3"
                        Padding="4,1"
                        Panel.ZIndex="500"
                        Visibility="{Binding GeometryHudVisibility}">
                    <TextBlock Text="{Binding GeometryCanvasCoordinates}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                </Border>
                <Border Canvas.Left="12"
                        Canvas.Top="12"
                        Padding="6,3"
                        Background="#CCFEF3C7"
                        BorderBrush="#FFF59E0B"
                        BorderThickness="1"
                        CornerRadius="3"
                        Panel.ZIndex="510"
                        Visibility="{Binding IsElementExcavationModeActive, RelativeSource={RelativeSource AncestorType=controls:SlopeCanvasView}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Excavate Elements mode: click an active element"
                               Foreground="#FF92400E"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                </Border>
                <Rectangle x:Name="ZoomRect"
                           Visibility="Collapsed"
                           Stroke="#FF0EA5E9"
                           StrokeThickness="1.5"
                           StrokeDashArray="3 3"
                           Fill="#4010B981"
                           IsHitTestVisible="False"
                           Panel.ZIndex="600"/>
            </Canvas>
        </Viewbox>
    </Border>
</UserControl>


