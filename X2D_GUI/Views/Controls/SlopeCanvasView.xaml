<UserControl x:Class="GeotechSlopeApp.Views.Controls.SlopeCanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GeotechSlopeApp.Views.Controls"
             xmlns:converters="clr-namespace:GeotechSlopeApp.Converters">
    <UserControl.Resources>
        <converters:SliceSelectionMatchConverter x:Key="SliceSelectionMatchConverter" />
        <converters:BooleanToDoubleConverter x:Key="BooleanToDoubleConverter" TrueValue="1.0" FalseValue="0.7" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Border BorderBrush="#FFCBD5E1"
            BorderThickness="1"
            CornerRadius="4"
            Padding="8"
            Background="#FFF7FAFC"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <!-- Fill the host panel. Do not resize CanvasWidth/Height to the host — that remaps
             geometry and fights the zoom matrix (looks like automatic zoom-out). -->
        <Viewbox Stretch="Fill">
            <Canvas x:Name="GeometryCanvas"
                    Width="{Binding CanvasWidth}"
                    Height="{Binding CanvasHeight}"
                    Background="#FFFFFF"
                    Cursor="Arrow"
                    ClipToBounds="True"
                    SnapsToDevicePixels="True"
                    SizeChanged="GeometryCanvas_SizeChanged"
                    PreviewMouseWheel="GeometryCanvas_OnMouseWheel"
                    MouseDown="GeometryCanvas_OnMouseDown"
                    MouseLeftButtonDown="GeometryCanvas_OnMouseLeftButtonDown"
                    MouseMove="GeometryCanvas_OnMouseMove"
                    MouseUp="GeometryCanvas_OnMouseUp"
                    MouseLeave="GeometryCanvas_OnMouseLeave"
                    ContextMenuOpening="GeometryCanvas_OnContextMenuOpening">
                <Canvas.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="CanvasFinishMenuItem" Header="Finish" Click="CanvasFinish_Click"/>
                        <MenuItem x:Name="CanvasPanDoneMenuItem" Header="Done" Click="PanModeDone_Click"/>
                    </ContextMenu>
                </Canvas.ContextMenu>
                <Canvas.Style>
                    <Style TargetType="Canvas">
                        <Setter Property="Cursor" Value="Arrow"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ZoomPanModeEnabled, RelativeSource={RelativeSource AncestorType=controls:SlopeCanvasView}}" Value="True">
                                <Setter Property="Cursor" Value="Hand"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsElementExcavationModeActive, RelativeSource={RelativeSource AncestorType=controls:SlopeCanvasView}}" Value="True">
                                <Setter Property="Cursor" Value="Cross"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Canvas.Style>
                <Line X1="0"
                      Y1="{Binding ElementName=GeometryCanvas, Path=ActualHeight}"
                      X2="{Binding ElementName=GeometryCanvas, Path=ActualWidth}"
                      Y2="{Binding ElementName=GeometryCanvas, Path=ActualHeight}"
                      Stroke="#FF475569"
                      StrokeThickness="1"
                      Panel.ZIndex="0"/>
                <Line X1="0"
                      Y1="0"
                      X2="0"
                      Y2="{Binding ElementName=GeometryCanvas, Path=ActualHeight}"
                      Stroke="#FF475569"
                      StrokeThickness="1"
                      Panel.ZIndex="0"/>
                <ItemsControl ItemsSource="{Binding GridLines}"
                              Panel.ZIndex="0"
                              IsHitTestVisible="False"
                              Visibility="{Binding ShowGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas>
                                <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                      Stroke="#FFD1D5DB" StrokeThickness="0.75"/>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding XAxisMinorTicks}"
                              Panel.ZIndex="1"
                              IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas>
                                <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#FF94A3B8" StrokeThickness="0.85"/>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding XAxisTicks}"
                              Panel.ZIndex="1"
                              IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas>
                                <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#FF334155" StrokeThickness="1"/>
                                <TextBlock Text="{Binding Label}" Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}"
                                           FontSize="10" FontWeight="SemiBold" Foreground="#FF1E293B"/>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding YAxisMinorTicks}"
                              Panel.ZIndex="1"
                              IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas>
                                <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#FF94A3B8" StrokeThickness="0.85"/>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding YAxisTicks}"
                              Panel.ZIndex="1"
                              IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas>
                                <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#FF334155" StrokeThickness="1"/>
                                <TextBlock Text="{Binding Label}" Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}"
                                           FontSize="10" FontWeight="SemiBold" Foreground="#FF1E293B"/>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Canvas Canvas.Left="{Binding OriginAxisOriginCanvasX}"
                        Canvas.Top="{Binding OriginAxisOriginCanvasY}"
                        Panel.ZIndex="2"
                        IsHitTestVisible="False"
                        Visibility="{Binding ShowAxes, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Ellipse Canvas.Left="-3"
                             Canvas.Top="-3"
                             Width="6"
                             Height="6"
                             Fill="#FF475569"/>
                    <Line X1="0"
                          Y1="0"
                          X2="{Binding OriginAxisArrowLengthPx}"
                          Y2="0"
                          Stroke="#FFDC2626"
                          StrokeThickness="2"
                          StrokeEndLineCap="Triangle"/>
                    <Line X1="0"
                          Y1="0"
                          X2="0"
                          Y2="{Binding OriginAxisYTipOffset}"
                          Stroke="#FF16A34A"
                          StrokeThickness="2"
                          StrokeEndLineCap="Triangle"/>
                    <TextBlock Text="X"
                               Canvas.Left="{Binding OriginAxisArrowLengthPx}"
                               Canvas.Top="-8"
                               Margin="4,0,0,0"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#FFDC2626"/>
                    <TextBlock Text="Y"
                               Canvas.Left="-8"
                               Canvas.Top="{Binding OriginAxisYTipOffset}"
                               Margin="0,0,0,4"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#FF16A34A"/>
                </Canvas>
                <!-- Axis of symmetry (r = 0) when seepage Axisymmetric is enabled -->
                <Canvas Panel.ZIndex="2"
                        IsHitTestVisible="False"
                        Visibility="{Binding ShowAxisOfSymmetry, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Line X1="{Binding AxisOfSymmetryX1}"
                          Y1="{Binding AxisOfSymmetryY1}"
                          X2="{Binding AxisOfSymmetryX2}"
                          Y2="{Binding AxisOfSymmetryY2}"
                          Stroke="#FF7C3AED"
                          StrokeThickness="2"
                          StrokeDashArray="8 4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                    <TextBlock Text="Axis of symmetry"
                               Canvas.Left="{Binding AxisOfSymmetryLabelX}"
                               Canvas.Top="{Binding AxisOfSymmetryLabelY}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#FF6D28D9"
                               Background="#E6FFFFFF"
                               Padding="2,0"/>
                </Canvas>
                <Canvas x:Name="ScaledGeometryLayer"
                        Width="{Binding CanvasWidth}"
                        Height="{Binding CanvasHeight}"
                        Panel.ZIndex="2">
                    <Canvas.RenderTransform>
                        <MatrixTransform x:Name="WorldTransform"/>
                    </Canvas.RenderTransform>

                    <!-- Slope image underlay (georeferenced); digitize tools paint above this. -->
                    <Image Source="{Binding SlopeImageBitmap}"
                           Width="{Binding SlopeImagePixelWidth}"
                           Height="{Binding SlopeImagePixelHeight}"
                           Opacity="{Binding SlopeImageOpacity}"
                           Stretch="Fill"
                           Canvas.Left="0"
                           Canvas.Top="0"
                           Panel.ZIndex="1"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           IsHitTestVisible="False"
                           Visibility="{Binding ShowSlopeImageUnderlay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Image.RenderTransform>
                            <MatrixTransform Matrix="{Binding SlopeImageCanvasTransform}"/>
                        </Image.RenderTransform>
                    </Image>

                    <!-- Geological features: committed weak plane / bedding / tension crack -->
                    <ItemsControl ItemsSource="{Binding GeologicalFeatureOverlays}"
                                  Panel.ZIndex="24"
                                  IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Canvas>
                                    <Polyline Points="{Binding Points}"
                                              Stroke="{Binding Stroke}"
                                              StrokeThickness="2.5"
                                              StrokeDashArray="8 3"
                                              Fill="Transparent"
                                              IsHitTestVisible="False"
                                              SnapsToDevicePixels="True"/>
                                    <TextBlock Canvas.Left="{Binding LabelLeft}"
                                               Canvas.Top="{Binding LabelTop}"
                                               Text="{Binding Name}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding Stroke}"
                                               Background="#F2FFFFFF"
                                               Padding="3,1"
                                               Visibility="{Binding ShowLabel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform X="6" Y="-16"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Field Stations: borehole stems + unit-stack columns + collar pins -->
                    <ItemsControl ItemsSource="{Binding FieldStationOverlays}"
                                  Panel.ZIndex="25"
                                  IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Canvas>
                                    <Line X1="{Binding StemX1}"
                                          Y1="{Binding StemY1}"
                                          X2="{Binding StemX2}"
                                          Y2="{Binding StemY2}"
                                          Stroke="#FF334155"
                                          StrokeThickness="1.2"
                                          IsHitTestVisible="False"
                                          Visibility="{Binding ShowStem, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <ItemsControl ItemsSource="{Binding Bands}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Canvas>
                                                    <Rectangle Canvas.Left="{Binding Left}"
                                                               Canvas.Top="{Binding Top}"
                                                               Width="{Binding Width}"
                                                               Height="{Binding Height}"
                                                               Fill="{Binding Fill}"
                                                               Stroke="#FF1E293B"
                                                               StrokeThickness="{Binding StrokeThickness}"
                                                               IsHitTestVisible="False"/>
                                                    <TextBlock Canvas.Left="{Binding Left}"
                                                               Canvas.Top="{Binding Top}"
                                                               Text="{Binding UnitCode}"
                                                               FontSize="8"
                                                               FontWeight="SemiBold"
                                                               Foreground="#FF0F172A"
                                                               Background="#CCFFFFFF"
                                                               Padding="1,0"
                                                               IsHitTestVisible="False"
                                                               Visibility="{Binding ShowUnitLabel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock.RenderTransform>
                                                            <TranslateTransform X="18" Y="2"/>
                                                        </TextBlock.RenderTransform>
                                                    </TextBlock>
                                                </Canvas>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Ellipse Canvas.Left="{Binding PinLeft}"
                                             Canvas.Top="{Binding PinTop}"
                                             Width="{Binding PinSize}" Height="{Binding PinSize}"
                                             Fill="{Binding PinFill}"
                                             Stroke="White"
                                             StrokeThickness="1.5"
                                             IsHitTestVisible="False"/>
                                    <TextBlock Canvas.Left="{Binding PinLeft}"
                                               Canvas.Top="{Binding PinTop}"
                                               Text="{Binding Label}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#FF0F172A"
                                               Background="#F2FFFFFF"
                                               Padding="3,1">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform X="12" Y="-14"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Geological draw mode: live draft polyline + vertex markers -->
                    <Polyline Points="{Binding GeologicalDraftPreviewPoints}"
                              Stroke="#FFEA580C"
                              StrokeThickness="2.5"
                              StrokeDashArray="5 3"
                              Fill="Transparent"
                              Panel.ZIndex="26"
                              IsHitTestVisible="False"
                              SnapsToDevicePixels="True"
                              Visibility="{Binding IsGeologicalDraftPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <ItemsControl ItemsSource="{Binding GeologicalDraftMarkers}"
                                  Panel.ZIndex="27"
                                  IsHitTestVisible="False"
                                  Visibility="{Binding IsDrawingGeologicalFeature, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="9" Height="9"
                                         Canvas.Left="{Binding X}"
                                         Canvas.Top="{Binding Y}"
                                         Fill="#FFEA580C"
                                         Stroke="#FFFFFFFF"
                                         StrokeThickness="1"
                                         IsHitTestVisible="False"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="-4.5" Y="-4.5"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Rectangle Canvas.Left="{Binding SnapIndicatorX}"
                               Canvas.Top="{Binding SnapIndicatorY}"
                               Width="22"
                               Height="22"
                               Fill="#33F59E0B"
                               Stroke="#FFB45309"
                               StrokeThickness="1.5"
                               Panel.ZIndex="40"
                               Visibility="{Binding HasSnapIndicator, Converter={StaticResource BooleanToVisibilityConverter}}"
                               IsHitTestVisible="False"/>

                    <ItemsControl ItemsSource="{Binding MeasureOverlays}"
                                  Panel.ZIndex="41"
                                  IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Canvas>
                                    <Line X1="{Binding X1}" Y1="{Binding Y1}"
                                          X2="{Binding X2}" Y2="{Binding Y2}"
                                          Stroke="#FFB45309"
                                          StrokeThickness="1.6"
                                          StrokeDashArray="5 3"/>
                                    <TextBlock Canvas.Left="{Binding LabelX}"
                                               Canvas.Top="{Binding LabelY}"
                                               Text="{Binding Label}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#FF7C2D12"
                                               Background="#F2FFFFFF"
                                               Padding="3,1"/>
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Vertices are drawn via GeometryVertices; boundary ring from mesh import uses ordered vertex walk. -->
                    <Polyline Points="{Binding BoundaryOutlinePoints}"
                              Stroke="#FF0F172A"
                              StrokeThickness="1.5"
                              Fill="Transparent"
                              Panel.ZIndex="2"
                              IsHitTestVisible="False"
                              SnapsToDevicePixels="True">
                        <Polyline.Style>
                            <Style TargetType="Polyline">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowBoundaryPolylineOutline}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Polyline.Style>
                    </Polyline>
                    <!-- Shared/internal edges (dashed blue); Material Properties tab only -->
                    <ItemsControl ItemsSource="{Binding InternalEdgeCanvasLines}"
                                  Panel.ZIndex="3"
                                  IsHitTestVisible="False"
                                  Visibility="{Binding ShowInternalEdgeLinesOnCanvas, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Polyline Points="{Binding Points}"
                                          Stroke="#FF2563EB" StrokeThickness="1.5" StrokeDashArray="4 3"
                                          Fill="Transparent"
                                          SnapsToDevicePixels="True"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Add Layer cut chords (_materialLayerCutElevations); Material Properties tab only -->
                    <ItemsControl ItemsSource="{Binding HorizontalLayerCanvasLines}"
                                  Panel.ZIndex="4"
                                  IsHitTestVisible="False"
                                  Visibility="{Binding ShowMaterialLayerCutLinesOnCanvas, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Polyline Points="{Binding Points}"
                                          Stroke="#FFE67E22" StrokeThickness="1.5"
                                          Fill="Transparent"
                                          SnapsToDevicePixels="True"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Non-horizontal layer cut polylines (teal); Material Properties tab only -->
                    <ItemsControl ItemsSource="{Binding NonHorizontalLayerCanvasLines}"
                                  Panel.ZIndex="4"
                                  IsHitTestVisible="False"
                                  Visibility="{Binding ShowMaterialLayerCutLinesOnCanvas, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Polyline Points="{Binding Points}"
                                          Stroke="#FF0D9488" StrokeThickness="1.5"
                                          Fill="Transparent"
                                          SnapsToDevicePixels="True"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- In-progress non-horizontal layer preview (dashed teal) -->
                    <Polyline Points="{Binding NonHorizontalLayerPreviewPoints}"
                              Panel.ZIndex="5"
                              IsHitTestVisible="False"
                              Stroke="#FF0D9488" StrokeThickness="1.5" StrokeDashArray="5 3"
                              Fill="Transparent"
                              SnapsToDevicePixels="True"
                              Visibility="{Binding IsNonHorizontalLayerDrawMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <!-- Clicked-point markers for the in-progress non-horizontal layer (teal dots) -->
                    <ItemsControl ItemsSource="{Binding NonHorizontalLayerPreviewVertexMarkers}"
                                  Panel.ZIndex="6"
                                  IsHitTestVisible="False"
                                  Visibility="{Binding IsNonHorizontalLayerDrawMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="8" Height="8" Margin="-4,-4,0,0"
                                         Fill="#FF0D9488" Stroke="White" StrokeThickness="1"
                                         SnapsToDevicePixels="True"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- User-defined surface regions (Surface grid): multiple named polygons, distinct colors; selected region on top -->
                    <ItemsControl ItemsSource="{Binding SurfaceRegionOverlays}"
                                  Panel.ZIndex="9"
                                  IsHitTestVisible="False"
                                  Visibility="{Binding ShowGeometrySurfaceFillsOnCanvas, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Visible}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Canvas>
                                    <Polygon Points="{Binding PolygonPoints}"
                                             Fill="{Binding Fill}"
                                             SnapsToDevicePixels="True"
                                             RenderOptions.EdgeMode="Aliased"
                                             IsHitTestVisible="False"
                                             Opacity="{Binding DataContext.MaterialLayerOverlayOpacity, RelativeSource={RelativeSource AncestorType=ItemsControl}, FallbackValue=1.0}">
                                        <Polygon.Style>
                                            <Style TargetType="Polygon">
                                                <Setter Property="Stroke" Value="#FF334155"/>
                                                <Setter Property="StrokeThickness" Value="1"/>
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasFillGeometry}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Stroke" Value="#FF0F172A"/>
                                                        <Setter Property="StrokeThickness" Value="2.5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Polygon.Style>
                                    </Polygon>
                                    <Path Data="{Binding FillGeometry}"
                                          Fill="{Binding Fill}"
                                          SnapsToDevicePixels="True"
                                          IsHitTestVisible="False"
                                          Opacity="{Binding DataContext.MaterialLayerOverlayOpacity, RelativeSource={RelativeSource AncestorType=ItemsControl}, FallbackValue=1.0}">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Stroke" Value="#FF334155"/>
                                                <Setter Property="StrokeThickness" Value="1"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasFillGeometry}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Stroke" Value="#FF0F172A"/>
                                                        <Setter Property="StrokeThickness" Value="2.5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Text="{Binding DisplayName}"
                                               Canvas.Left="{Binding LabelLeft}"
                                               Canvas.Top="{Binding LabelTop}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#FF0F172A"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ShowLabel}" Value="True"/>
                                                            <Condition Binding="{Binding DataContext.ShowMaterialLayerLabelsOnCanvas, RelativeSource={RelativeSource AncestorType=ItemsControl}, FallbackValue=True}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="2" ShadowDepth="0" Color="White" Opacity="0.92"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Polyline Points="{Binding HighlightedSegmentPoints}"
                              Stroke="#22C55E"
                              StrokeThickness="4"
                              Panel.ZIndex="10"
                              IsHitTestVisible="False"
                              SnapsToDevicePixels="True"/>
                    <ItemsControl ItemsSource="{Binding ExplorerHighlightPolylines}"
                                  Panel.ZIndex="11"
                                  IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Polyline Points="{Binding}"
                                          Stroke="#F97316"
                                          StrokeThickness="3.5"
                                          IsHitTestVisible="False"
                                          SnapsToDevicePixels="True"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Surface line-pick mode: amber highlight for each segment picked for the active surface -->
                    <ItemsControl ItemsSource="{Binding PickedSurfaceLineHighlightPolylines}"
                                  Panel.ZIndex="12"
                                  IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Polyline Points="{Binding}"
