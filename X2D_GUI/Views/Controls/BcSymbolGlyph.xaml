<UserControl x:Class="GeotechSlopeApp.Views.Controls.BcSymbolGlyph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:GeotechSlopeApp.Models"
             Width="12" Height="12"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <!--
      Geometry is authored at 18×18 and scaled via Viewbox so callers can set
      a compact canvas size (≈8px) while keeping readable UI list glyphs.
      Visibility must be set via Style setters (not local attributes).
    -->
    <Viewbox Stretch="Uniform">
    <Grid Width="18" Height="18">
        <!-- Fixed: triangle -->
        <Polygon Points="9,1 16,15 2,15"
                 Fill="{Binding FillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Stroke="{Binding StrokeBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 StrokeThickness="1.0">
            <Polygon.Effect>
                <DropShadowEffect BlurRadius="0.8" ShadowDepth="0" Color="White" Opacity="0.75"/>
            </Polygon.Effect>
            <Polygon.Style>
                <Style TargetType="Polygon">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="{x:Static models:BcSymbolKind.Fixed}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Polygon.Style>
        </Polygon>

        <!-- Roller X: cross -->
        <Canvas>
            <Canvas.Style>
                <Style TargetType="Canvas">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="{x:Static models:BcSymbolKind.RollerX}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Canvas.Style>
            <Line X1="3" Y1="3" X2="15" Y2="15"
                  Stroke="{Binding FillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  StrokeThickness="1.8"/>
            <Line X1="3" Y1="15" X2="15" Y2="3"
                  Stroke="{Binding FillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  StrokeThickness="1.8"/>
        </Canvas>

        <!-- Roller Y: circle + bar -->
        <Canvas>
            <Canvas.Style>
                <Style TargetType="Canvas">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="{x:Static models:BcSymbolKind.RollerY}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Canvas.Style>
            <Ellipse Canvas.Left="5" Canvas.Top="4" Width="8" Height="8"
                     Stroke="{Binding FillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     StrokeThickness="1.5" Fill="Transparent"/>
            <Line X1="2" Y1="14" X2="16" Y2="14"
                  Stroke="{Binding FillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  StrokeThickness="1.8"/>
        </Canvas>

        <!-- Prescribed: arrow -->
        <Canvas>
            <Canvas.Style>
                <Style TargetType="Canvas">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="{x:Static models:BcSymbolKind.Prescribed}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Canvas.Style>
            <Line X1="2" Y1="9" X2="12" Y2="9"
                  Stroke="{Binding FillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  StrokeThickness="1.5"/>
            <Polygon Points="12,5 17,9 12,13"
                     Fill="{Binding FillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Canvas>

        <!-- Force: thicker arrow -->
        <Canvas>
            <Canvas.Style>
                <Style TargetType="Canvas">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="{x:Static models:BcSymbolKind.Force}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Canvas.Style>
            <Line X1="2" Y1="9" X2="12" Y2="9"
                  Stroke="{Binding FillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  StrokeThickness="1.8"/>
            <Polygon Points="12,4 18,9 12,14"
                     Fill="{Binding FillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Canvas>

        <!-- Seepage / letter badges -->
        <Border CornerRadius="2" Padding="1,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{Binding FillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                BorderBrush="White" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="{x:Static models:BcSymbolKind.TotalHead}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="{x:Static models:BcSymbolKind.PressureHead}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="{x:Static models:BcSymbolKind.PorePressure}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="{x:Static models:BcSymbolKind.Constant}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="{x:Static models:BcSymbolKind.ZeroPressure}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="{x:Static models:BcSymbolKind.FlowQ}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="{x:Static models:BcSymbolKind.Infiltration}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="{x:Static models:BcSymbolKind.Unknown}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="{x:Static models:BcSymbolKind.None}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="H"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Value="{x:Static models:BcSymbolKind.ZeroPressure}">
                                <Setter Property="Text" Value="P0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Value="{x:Static models:BcSymbolKind.FlowQ}">
                                <Setter Property="Text" Value="Q"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Value="{x:Static models:BcSymbolKind.Infiltration}">
                                <Setter Property="Text" Value="q"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Value="{x:Static models:BcSymbolKind.Unknown}">
                                <Setter Property="Text" Value="?"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Value="{x:Static models:BcSymbolKind.None}">
                                <Setter Property="Text" Value="×"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Value="{x:Static models:BcSymbolKind.PressureHead}">
                                <Setter Property="Text" Value="Ph"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Value="{x:Static models:BcSymbolKind.PorePressure}">
                                <Setter Property="Text" Value="Pp"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Value="{x:Static models:BcSymbolKind.Constant}">
                                <Setter Property="Text" Value="C"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
    </Viewbox>
</UserControl>
