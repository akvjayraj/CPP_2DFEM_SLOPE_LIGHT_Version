<UserControl x:Class="GeotechSlopeApp.Views.Controls.LoadCanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GeotechSlopeApp.Views.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Border BorderBrush="#FFCBD5E1"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8"
                Background="#FFF7FAFC"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Viewbox Stretch="Fill">
                <Canvas x:Name="LoadCanvas"
                        Width="{Binding GeometryDefinition.CanvasWidth}"
                        Height="{Binding GeometryDefinition.CanvasHeight}"
                        Background="#FFFFFF"
                        ClipToBounds="True"
                        SnapsToDevicePixels="True"
                        MouseLeftButtonDown="LoadCanvas_OnMouseLeftButtonDown"
                        MouseMove="LoadCanvas_OnMouseMove"
                        MouseLeave="LoadCanvas_OnMouseLeave">
                <Line X1="0"
                      Y1="{Binding ElementName=LoadCanvas, Path=ActualHeight}"
                      X2="{Binding ElementName=LoadCanvas, Path=ActualWidth}"
                      Y2="{Binding ElementName=LoadCanvas, Path=ActualHeight}"
                      Stroke="#FF475569"
                      StrokeThickness="1"
                      Panel.ZIndex="0"/>
                <Line X1="0"
                      Y1="0"
                      X2="0"
                      Y2="{Binding ElementName=LoadCanvas, Path=ActualHeight}"
                      Stroke="#FF475569"
                      StrokeThickness="1"
                      Panel.ZIndex="0"/>

                <ItemsControl ItemsSource="{Binding GeometryDefinition.XAxisMinorTicks}"
                              Panel.ZIndex="1"
                              IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas>
                                <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#FF94A3B8" StrokeThickness="0.85"/>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding GeometryDefinition.XAxisTicks}"
                              Panel.ZIndex="1"
                              IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Canvas>
                                    <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#FF334155" StrokeThickness="1.2"/>
                                    <TextBlock Text="{Binding Label}" Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}"
                                               FontSize="10" FontWeight="SemiBold" Foreground="#FF1E293B"/>
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                <ItemsControl ItemsSource="{Binding GeometryDefinition.YAxisMinorTicks}"
                              Panel.ZIndex="1"
                              IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas>
                                <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#FF94A3B8" StrokeThickness="0.85"/>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding GeometryDefinition.YAxisTicks}"
                              Panel.ZIndex="1"
                              IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas>
                                <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#FF334155" StrokeThickness="1.2"/>
                                <TextBlock Text="{Binding Label}" Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}"
                                           FontSize="10" FontWeight="SemiBold" Foreground="#FF1E293B"/>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Axis of symmetry (r = 0) when seepage Axisymmetric is enabled -->
                <Canvas Panel.ZIndex="2"
                        IsHitTestVisible="False"
                        Visibility="{Binding GeometryDefinition.ShowAxisOfSymmetry, Converter={StaticResource BoolToVisibility}}">
                    <Line X1="{Binding GeometryDefinition.AxisOfSymmetryX1}"
                          Y1="{Binding GeometryDefinition.AxisOfSymmetryY1}"
                          X2="{Binding GeometryDefinition.AxisOfSymmetryX2}"
                          Y2="{Binding GeometryDefinition.AxisOfSymmetryY2}"
                          Stroke="#FF7C3AED"
                          StrokeThickness="2"
                          StrokeDashArray="8 4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                    <TextBlock Text="Axis of symmetry"
                               Canvas.Left="{Binding GeometryDefinition.AxisOfSymmetryLabelX}"
                               Canvas.Top="{Binding GeometryDefinition.AxisOfSymmetryLabelY}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#FF6D28D9"
                               Background="#E6FFFFFF"
                               Padding="2,0"/>
                </Canvas>

                <Canvas x:Name="ScaledLoadGeometry"
                        Width="{Binding GeometryDefinition.CanvasWidth}"
                        Height="{Binding GeometryDefinition.CanvasHeight}"
                        Panel.ZIndex="2">
                    <Canvas.RenderTransform>
                        <MatrixTransform x:Name="LoadGeometryTransform"/>
                    </Canvas.RenderTransform>
                    <!-- Do not draw GeometryPathPoints as a filled polyline: it connects vertices in grid order, not true boundary order, which causes bow-tie fills and disagrees with InternalEdgeCanvasLines. Same as Geometry Definition canvas. -->
                    <ItemsControl ItemsSource="{Binding GeometryDefinition.InternalEdgeCanvasLines}"
                                  Panel.ZIndex="3"
                                  IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Polyline Points="{Binding Points}"
                                          Stroke="#FF2563EB" StrokeThickness="1.5" StrokeDashArray="4 3"
                                          Fill="Transparent"
                                          SnapsToDevicePixels="True"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Match Material / main geometry canvas: layer strips, tunnel excavation, boolean previews -->
                    <ItemsControl ItemsSource="{Binding GeometryDefinition.Layers}"
                                  Panel.ZIndex="3"
                                  IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Canvas>
                                    <Polygon Points="{Binding Polygon}"
                                             Fill="{Binding Fill}"
                                             Stroke="{Binding Stroke}"
                                             StrokeThickness="{Binding StrokeThickness}"
                                             Opacity="0.65"/>
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding GeometryDefinition.ExcavationPolygons}"
                                  Panel.ZIndex="3"
                                  IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Polygon Points="{Binding}"
                                         Fill="#98daf2"
                                         Stroke="#333333"
                                         StrokeThickness="1"
                                         Opacity="0.9"
                                         SnapsToDevicePixels="True"
                                         RenderOptions.EdgeMode="Aliased"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding GeometryDefinition.RegionBPolygons}"
                                  Panel.ZIndex="8"
                                  IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Polygon Points="{Binding}"
                                         Fill="White"
                                         Stroke="Black"
                                         StrokeThickness="2"
                                         Opacity="1.0"
                                         SnapsToDevicePixels="True"
                                         RenderOptions.EdgeMode="Aliased"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding GeometryDefinition.UnionFillPolygons}"
                                  Panel.ZIndex="9"
                                  IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Polygon Points="{Binding}"
                                         Fill="Red"
                                         Stroke="DarkRed"
                                         StrokeThickness="1.5"
                                         FillRule="NonZero"
                                         Opacity="1.0"
                                         SnapsToDevicePixels="True"
                                         RenderOptions.EdgeMode="Aliased"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding GeometryDefinition.SurfaceRegionOverlays}"
                                  Panel.ZIndex="11"
                                  IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Canvas>
                                    <Polygon Points="{Binding PolygonPoints}"
                                             Fill="{Binding Fill}"
                                             SnapsToDevicePixels="True"
                                             RenderOptions.EdgeMode="Aliased"
                                             IsHitTestVisible="False">
                                        <Polygon.Style>
                                            <Style TargetType="Polygon">
                                                <Setter Property="Stroke" Value="#FF334155"/>
                                                <Setter Property="StrokeThickness" Value="1"/>
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasFillGeometry}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Stroke" Value="#FF0F172A"/>
                                                        <Setter Property="StrokeThickness" Value="2.5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Polygon.Style>
                                    </Polygon>
                                    <Path Data="{Binding FillGeometry}"
                                          Fill="{Binding Fill}"
                                          SnapsToDevicePixels="True"
                                          IsHitTestVisible="False">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Stroke" Value="#FF334155"/>
                                                <Setter Property="StrokeThickness" Value="1"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasFillGeometry}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Stroke" Value="#FF0F172A"/>
                                                        <Setter Property="StrokeThickness" Value="2.5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Text="{Binding DisplayName}"
                                               Canvas.Left="{Binding LabelLeft}"
                                               Canvas.Top="{Binding LabelTop}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#FF0F172A"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowLabel}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="2" ShadowDepth="0" Color="White" Opacity="0.92"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding GeometryDefinition.ExcavatedStageZones}"
                                  Panel.ZIndex="12"
                                  IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Canvas>
                                    <Polygon Points="{Binding CanvasPolygon}"
                                             Fill="White"
                                             Stroke="#FF334155"
                                             StrokeThickness="2"
                                             StrokeDashArray="6 3"
                                             Opacity="1.0"
                                             SnapsToDevicePixels="True"
                                             RenderOptions.EdgeMode="Aliased"/>
                                    <Border Canvas.Left="{Binding CentroidX}"
                                            Canvas.Top="{Binding CentroidY}"
                                            Background="#E0FFFFFF"
                                            BorderBrush="#FF334155"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="4,2"
                                            IsHitTestVisible="False">
                                        <Border.RenderTransform>
                                            <TranslateTransform X="-24" Y="-10"/>
                                        </Border.RenderTransform>
                                        <TextBlock Text="{Binding DisplayLabel}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FF1E293B"/>
                                    </Border>
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Polyline Points="{Binding GeometryDefinition.HighlightedSegmentPoints}"
                             Stroke="#22C55E"
                             StrokeThickness="4"
                             Panel.ZIndex="10"
                             IsHitTestVisible="False"
                             SnapsToDevicePixels="True"/>

                    <!-- Mesh from Mesh tab: Smith / textbook thick black quad outlines (same as Mesh canvas). -->
                    <ItemsControl ItemsSource="{Binding LoadCanvasMeshElements}"
                                  Panel.ZIndex="5"
                                  IsHitTestVisible="False"
                                  Visibility="{Binding HasLoadCanvasMesh, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Canvas IsHitTestVisible="False"
                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                    <Polygon Points="{Binding Nodes}"
                                             Stretch="None"
                                             FillRule="NonZero"
                                             SnapsToDevicePixels="True"
                                             RenderOptions.EdgeMode="Aliased">
                                        <Polygon.Style>
                                            <Style TargetType="Polygon">
                                                <Setter Property="Stroke" Value="#FF000000"/>
                                                <Setter Property="StrokeThickness" Value="1.25"/>
                                                <Setter Property="StrokeLineJoin" Value="Miter"/>
                                                <Setter Property="Fill" Value="Transparent"/>
                                                <Setter Property="Opacity" Value="1.0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                        <Setter Property="Stroke" Value="#FFEF4444"/>
                                                        <Setter Property="StrokeThickness" Value="1.75"/>
                                                        <Setter Property="Fill" Value="#40EF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Polygon.Style>
                                    </Polygon>
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding LoadCanvasMeshElements}"
                                  Panel.ZIndex="6"
                                  IsHitTestVisible="False"
                                  Visibility="{Binding ShowLoadCanvasMeshElements, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding CenterX}"/>
                                <Setter Property="Canvas.Top" Value="{Binding CenterY}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayId}"
                                           Foreground="#FF1D4ED8"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform X="-6" Y="-5"/>
                                    </TextBlock.RenderTransform>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"/>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding LoadCanvasMeshNodeDisplayItems}"
                                  Panel.ZIndex="7"
                                  IsHitTestVisible="False"
                                  Visibility="{Binding ShowLoadCanvasMeshNodes, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Canvas>
                                    <Ellipse Canvas.Left="-3" Canvas.Top="-3"
                                             Width="6" Height="6"
                                             Fill="#FF64748B" Stroke="White" StrokeThickness="1"/>
                                    <TextBlock Canvas.Left="-4" Canvas.Top="5"
                                               Text="{Binding NodeId}"
                                               Foreground="Red"
                                               FontSize="8"
                                               FontWeight="SemiBold"/>
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                <!-- Highlighted traction edge overlay: drawn when a row in the Field Stress
                     Traction DataGrid is selected. Polyline supports both linear (2-point
                     A→B) and quadratic (3-point A→C→B) edges. -->
                <Polyline Points="{Binding HighlightedTractionEdgePoints}"
                          Stroke="#FFEF4444"
                          StrokeThickness="3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Panel.ZIndex="9"
                          IsHitTestVisible="False"
                          Visibility="{Binding HasHighlightedTractionEdge, Converter={StaticResource BoolToVisibility}}"/>

                <ItemsControl ItemsSource="{Binding GeometryDefinition.GeometryVertices}"
                              Panel.ZIndex="3"
                              IsHitTestVisible="False">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <Trigger Property="HasItems" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Ellipse Canvas.Left="{Binding X}"
                                     Canvas.Top="{Binding Y}"
                                     Canvas.ZIndex="11">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <TranslateTransform X="-3" Y="-3"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Width" Value="6"/>
                                        <Setter Property="Height" Value="6"/>
                                        <Setter Property="Fill" Value="#FF0F6A00"/>
                                        <Setter Property="Stroke" Value="White"/>
                                        <Setter Property="StrokeThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                <Setter Property="Width" Value="8"/>
                                                <Setter Property="Height" Value="8"/>
                                                <Setter Property="Fill" Value="#FFFF3B3B"/>
                                                <Setter Property="StrokeThickness" Value="2"/>
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <TranslateTransform X="-4" Y="-4"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Ellipse Canvas.Left="{Binding GeometryDefinition.BoxMethodCircleCenter.X}"
                         Canvas.Top="{Binding GeometryDefinition.BoxMethodCircleCenter.Y}"
                         Width="6"
                         Height="6"
                         Fill="#FFFF3B3B"
                         Stroke="White"
                         StrokeThickness="1.5"
                         Canvas.ZIndex="7">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="-3" Y="-3"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GeometryDefinition.BoxMethodCircleSegments.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding GeometryDefinition.IsBoxMethodCircleVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <ItemsControl ItemsSource="{Binding GeometryDefinition.BoxMethodCircleSegments}"
                              Panel.ZIndex="8"
                              IsHitTestVisible="False">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasItems, RelativeSource={RelativeSource Self}}" Value="True"/>
                                        <Condition Binding="{Binding GeometryDefinition.IsBoxMethodCircleVisible}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Polyline Points="{Binding}"
                                      Stroke="#FFFF3B3B"
                                      StrokeThickness="2"
                                      StrokeDashArray="4 2"
                                      Fill="Transparent"
                                      SnapsToDevicePixels="True"
                                      RenderOptions.EdgeMode="Aliased"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding GeometryDefinition.CirclePreviews}"
                              Panel.ZIndex="7"
                              IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Polyline Points="{Binding Points}"
                                      Stroke="{Binding Stroke}"
                                      StrokeThickness="{Binding StrokeThickness}"
                                      StrokeDashArray="{Binding StrokeDashArray}"
                                      Opacity="{Binding Opacity}"
                                      Fill="Transparent"
                                      SnapsToDevicePixels="True"
                                      RenderOptions.EdgeMode="Aliased"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding GeometryDefinition.GroundwaterLines}"
                              Panel.ZIndex="7"
                              IsHitTestVisible="False"
                              Visibility="{Binding GeometryDefinition.IsGroundwaterPhreaticVisible, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas>
                                <Line X1="{Binding Start.X}"
                                      Y1="{Binding Start.Y}"
                                      X2="{Binding End.X}"
                                      Y2="{Binding End.Y}"
                                      Stroke="#FF1D4ED8"
                                      StrokeThickness="1.5"
                                      StrokeDashArray="4 2"/>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <controls:LineLoadOverlayView ItemsSource="{Binding LineLoadOverlays}"
                                              Panel.ZIndex="18"
                                              IsHitTestVisible="False"/>
                <controls:PointLoadOverlayView ItemsSource="{Binding PointLoadOverlays}"
                                               Panel.ZIndex="18"
                                               IsHitTestVisible="False"/>

                <ItemsControl ItemsSource="{Binding FilteredLoads}"
                              Panel.ZIndex="9"
                              IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas>
                                <Ellipse Width="6" Canvas.ZIndex="11"
                                         Height="6"
                                         Fill="#FFDC2626"
                                         Stroke="White"
                                         StrokeThickness="1"
                                         Canvas.Left="{Binding StartX}"
                                         Canvas.Top="{Binding StartY}">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsPointLoad}" Value="True"/>
                                                        <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="-3" Y="-3"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </Canvas>

                <!-- Hover axis coordinates (same string as Geometry / Mesh canvases). -->
                <Border Canvas.Left="8"
                        Canvas.Top="8"
                        Background="#CC0F172A"
                        CornerRadius="3"
                        Padding="4,1"
                        Panel.ZIndex="500"
                        IsHitTestVisible="False">
                    <TextBlock Text="{Binding GeometryDefinition.GeometryCanvasCoordinates}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                </Border>
            </Canvas>
            </Viewbox>
        </Border>

        <!-- Screen-fixed pseudo-static direction legend (outside zoom transform) -->
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="12,12,0,0"
                Padding="8,6"
                Background="#E6FFFFFF"
                BorderBrush="#FFCBD5E1"
                BorderThickness="1"
                CornerRadius="4"
                Panel.ZIndex="2"
                Visibility="{Binding IsSeismicLoadUiEnabled, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Pseudo-static directions" FontWeight="SemiBold" FontSize="11" Foreground="#FF334155"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Canvas Width="56" Height="28" Margin="0,0,12,0">
                        <Line X1="4" Y1="14" X2="44" Y2="14" Stroke="#FFEA580C" StrokeThickness="2"/>
                        <Polygon Points="44,14 36,10 36,18" Fill="#FFEA580C"/>
                    </Canvas>
                    <Canvas Width="28" Height="28">
                        <Line X1="14" Y1="24" X2="14" Y2="4" Stroke="#FF2563EB" StrokeThickness="2"/>
                        <Polygon Points="14,4 10,12 18,12" Fill="#FF2563EB"/>
                    </Canvas>
                </StackPanel>
                <TextBlock FontSize="10" Foreground="#FF64748B" Margin="0,2,0,0"
                           Text="{Binding SeismicLegendKh, StringFormat='k_h={0:F3} → +x inertia'}"/>
                <TextBlock FontSize="10" Foreground="#FF64748B"
                           Text="{Binding SeismicLegendKv, StringFormat='k_v={0:F3}  vertical gravity × (1−k_v)'}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
