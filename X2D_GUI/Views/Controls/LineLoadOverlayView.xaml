<UserControl x:Class="GeotechSlopeApp.Views.Controls.LineLoadOverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ItemsSource}"
                  IsHitTestVisible="False">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <Canvas />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Canvas>
                    <Polyline Points="{Binding EdgePoints}"
                              Stroke="#FF4C1D95"
                              StrokeThickness="3"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Canvas.ZIndex="18"/>
                    <Line X1="{Binding BracketStart.X}"
                          Y1="{Binding BracketStart.Y}"
                          X2="{Binding BracketEnd.X}"
                          Y2="{Binding BracketEnd.Y}"
                          Stroke="#FFFF2E2E"
                          StrokeThickness="2"
                          Canvas.ZIndex="19"/>
                    <ItemsControl ItemsSource="{Binding Labels}" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                <Setter Property="Canvas.ZIndex" Value="25" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}"
                                           FontSize="{Binding FontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="#FFB91C1C"
                                           Background="#E6FFFFFF"
                                           Padding="2,0">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform X="{Binding OffsetX}" Y="{Binding OffsetY}"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Arrows}" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Canvas>
                                    <Line X1="{Binding TailX}"
                                          Y1="{Binding TailY}"
                                          X2="{Binding HeadX}"
                                          Y2="{Binding HeadY}"
                                          Stroke="#FFFF2E2E"
                                          StrokeThickness="2"
                                          Canvas.ZIndex="20"/>
                                    <Polygon Points="{Binding ArrowHeadPoints}"
                                             Fill="#FFFF2E2E"
                                             Stroke="#FFFF2E2E"
                                             StrokeThickness="1"
                                             Canvas.ZIndex="21"/>
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
