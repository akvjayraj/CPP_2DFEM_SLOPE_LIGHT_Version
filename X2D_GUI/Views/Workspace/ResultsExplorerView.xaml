<UserControl x:Class="GeotechSlopeApp.Views.Workspace.ResultsExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GeotechSlopeApp.Converters"
             Background="{DynamicResource PanelBackgroundBrush}"
             Foreground="{DynamicResource WindowForegroundBrush}">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="PanelCollapseButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>
        <HierarchicalDataTemplate x:Key="ResultsNodeTemplate" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}"
                          IsHitTestVisible="False"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center"
                          Visibility="{Binding IsCheckable, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>
    <DockPanel Visibility="{Binding IsExplorerExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Border DockPanel.Dock="Top" Padding="10,10,10,8">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource PanelCollapseButton}"
                        Command="{Binding ToggleExplorerCommand}"
                        ToolTip="Collapse or expand Results Manager">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Text="{Binding ExplorerChevronGlyph}"/>
                </Button>
                <TextBlock Text="RESULTS MANAGER"
                           FontWeight="SemiBold"
                           FontSize="13"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource ChromeBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,8">
            <StackPanel>
                <TextBlock Text="INFORMATION" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap">
                    <Run Text="Analysis Type: "/><Run Text="{Binding AnalysisTypeLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0">
                    <Run Text="Solver Type: "/><Run Text="{Binding SolverTypeLabel, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0">
                    <Run Text="Total Stages: "/><Run Text="{Binding TotalStages, Mode=OneWay}"/>
                    <Run Text="    Active Stage: "/><Run Text="{Binding ActiveStage, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0">
                    <Run Text="Load Case: "/><Run Text="{Binding LoadCaseLabel, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0">
                    <Run Text="Step: "/><Run Text="{Binding StepLabel, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0">
                    <Run Text="Units: "/><Run Text="{Binding UnitsLabel, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Border>
        <TreeView ItemsSource="{Binding Roots}"
                  ItemTemplate="{StaticResource ResultsNodeTemplate}"
                  BorderThickness="0"
                  Background="Transparent"
                  Foreground="{DynamicResource WindowForegroundBrush}"
                  Padding="8,0,8,8">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
                    <EventSetter Event="MouseLeftButtonUp" Handler="OnNodeClick"/>
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>
    </DockPanel>
</UserControl>
