<UserControl x:Class="GeotechSlopeApp.Views.Workspace.LoadsPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GeotechSlopeApp.Converters"
             Background="{DynamicResource PanelBackgroundBrush}"
             Foreground="{DynamicResource WindowForegroundBrush}"
             TextElement.Foreground="{DynamicResource WindowForegroundBrush}">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:StringToBrushConverter x:Key="StatusBrushConverter"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0"
                  Visibility="{Binding IsPropertiesExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel Margin="8">
            <DockPanel Margin="0,4,0,8">
                <Button DockPanel.Dock="Right"
                        Command="{Binding TogglePropertiesCommand}"
                        ToolTip="Hide Load Properties"
                        Width="22" Height="22" Padding="0"
                        Background="Transparent" BorderThickness="0">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE70E;"
                               Foreground="{DynamicResource WindowForegroundBrush}"/>
                </Button>
                <TextBlock Text="LOAD PROPERTIES" FontWeight="SemiBold" FontSize="13"/>
            </DockPanel>

            <StackPanel Visibility="{Binding IsLoadSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Margin="0,0,0,8"
                            Visibility="{Binding HasSelectedLoad, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <TextBlock Text="No load selected"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource WindowForegroundBrush}"/>
                    <TextBlock Text="Create a load or pick one in Load Explorer."
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <Button Content="New Point Load"
                            Margin="0,0,0,6"
                            HorizontalAlignment="Left"
                            MinWidth="140"
                            Padding="8,4"
                            Command="{Binding AddNodalLoadCommand}"
                            Foreground="{DynamicResource WindowForegroundBrush}"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource ChromeBorderBrush}"/>
                    <Button Content="New Line Load"
                            HorizontalAlignment="Left"
                            MinWidth="140"
                            Padding="8,4"
                            Command="{Binding AddLineLoadCommand}"
                            Foreground="{DynamicResource WindowForegroundBrush}"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource ChromeBorderBrush}"/>
                </StackPanel>
                <StackPanel DataContext="{Binding Loads.SelectedLoad}"
                            Visibility="{Binding DataContext.HasSelectedLoad, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="GENERAL" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="ID" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding IdCode, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Type" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding DataContext.TypeDisplayOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedItem="{Binding DisplayType, Mode=TwoWay}"/>
                    <TextBlock Text="Apply To" Style="{StaticResource FieldLabel}"/>
                    <ComboBox IsEditable="True"
                              ItemsSource="{Binding DataContext.ApplyToOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Text="{Binding ApplyTo, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Load Group" Style="{StaticResource FieldLabel}"/>
                    <ComboBox IsEditable="True"
                              ItemsSource="{Binding DataContext.LoadGroupOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Text="{Binding LoadGroup, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Coordinate System" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding DataContext.CoordinateSystemOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedItem="{Binding CoordinateSystem, Mode=TwoWay}"/>
                    <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding DataContext.StatusOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedItem="{Binding Status, Mode=TwoWay}"
                              Foreground="{Binding StatusColor, Converter={StaticResource StatusBrushConverter}}"/>

                    <TextBlock Text="LOAD DEFINITION" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="Load Type" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding DataContext.DistributionOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedItem="{Binding DisplayDistribution, Mode=TwoWay}"/>
                    <TextBlock Text="Direction" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding DataContext.DirectionOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedItem="{Binding DisplayDirection, Mode=TwoWay}"/>
                    <TextBlock Text="Distribution" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding DataContext.DistributionOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedItem="{Binding DisplayDistribution, Mode=TwoWay}"/>
                    <TextBlock Text="{Binding ValueLabel}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Magnitude, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="End magnitude" Style="{StaticResource FieldLabel}"
                               Visibility="{Binding ShowsEndMagnitude, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBox Text="{Binding EndMagnitude, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding ShowsEndMagnitude, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <TextBlock Text="Placement" Style="{StaticResource FieldLabel}"/>
                    <DockPanel Margin="0,0,0,8">
                        <TextBox DockPanel.Dock="Left" Width="90" Margin="0,0,6,0"
                                 Text="{Binding StartX, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Text="{Binding StartY, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                    </DockPanel>
                    <StackPanel Visibility="{Binding IsDistributedLineLoad, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="End X / Y" Style="{StaticResource FieldLabel}"/>
                        <DockPanel Margin="0,0,0,8">
                            <TextBox DockPanel.Dock="Left" Width="90" Margin="0,0,6,0"
                                     Text="{Binding EndX, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Text="{Binding EndY, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                        </DockPanel>
                    </StackPanel>

                    <TextBlock Text="ADVANCED OPTIONS" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="Load Projection" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding DataContext.ProjectionOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedItem="{Binding LoadProjection, Mode=TwoWay}"/>
                    <TextBlock Text="Load Depth (m)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding LoadDepth, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox IsChecked="{Binding UseProjection, Mode=TwoWay}">
                        <TextBlock Text="Use Projection" Foreground="{DynamicResource WindowForegroundBrush}"/>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding HasRampTimeDependency, Mode=TwoWay}">
                        <TextBlock Text="Ramp/Time Dependency" Foreground="{DynamicResource WindowForegroundBrush}"/>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding IsStageLoad, Mode=TwoWay}">
                        <TextBlock Text="Stage Dependent" Foreground="{DynamicResource WindowForegroundBrush}"/>
                    </CheckBox>
                    <StackPanel Margin="18,0,0,0"
                                Visibility="{Binding IsStageLoad, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Apply From Stage" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding DataContext.StageFromChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  SelectedValue="{Binding ApplyFromStage, Mode=TwoWay, TargetNullValue=1}"
                                  SelectedValuePath="Number"
                                  DisplayMemberPath="Name"/>
                        <TextBlock Text="Apply To Stage" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding DataContext.StageToChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  SelectedValue="{Binding ApplyToStageOrAll, Mode=TwoWay}"
                                  SelectedValuePath="Number"
                                  DisplayMemberPath="Name"/>
                    </StackPanel>

                    <TextBlock Text="NOTES" Style="{StaticResource SectionHeader}"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="64"
                             Height="72"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Visibility="{Binding IsFieldStressSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="FIELD STRESS" Style="{StaticResource SectionHeader}"/>
                <RadioButton GroupName="LoadsFsMode"
                             IsChecked="{Binding Loads.FieldStress.IsGravityModeSelected, Mode=TwoWay}" Margin="0,0,0,4">
                    <TextBlock Text="Gravity" Foreground="{DynamicResource WindowForegroundBrush}"/>
                </RadioButton>
                <RadioButton GroupName="LoadsFsMode"
                             IsChecked="{Binding Loads.FieldStress.IsConstantModeSelected, Mode=TwoWay}" Margin="0,0,0,4">
                    <TextBlock Text="Constant" Foreground="{DynamicResource WindowForegroundBrush}"/>
                </RadioButton>
                <RadioButton GroupName="LoadsFsMode"
                             IsChecked="{Binding Loads.FieldStress.IsDirectModeSelected, Mode=TwoWay}" Margin="0,0,0,4">
                    <TextBlock Text="Direct tensor" Foreground="{DynamicResource WindowForegroundBrush}"/>
                </RadioButton>
                <RadioButton GroupName="LoadsFsMode"
                             IsChecked="{Binding Loads.FieldStress.IsTractionModeSelected, Mode=TwoWay}" Margin="0,0,0,8">
                    <TextBlock Text="Traction" Foreground="{DynamicResource WindowForegroundBrush}"/>
                </RadioButton>
                <StackPanel Visibility="{Binding Loads.FieldStress.IsGravityMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Kx (σh / σv)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Loads.FieldStress.Global.Kx, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Kz (σZ / σv)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Loads.FieldStress.Global.Kz, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox IsChecked="{Binding Loads.FieldStress.Global.AutoSurface, Mode=TwoWay}">
                        <TextBlock Text="Auto free surface" Foreground="{DynamicResource WindowForegroundBrush}"/>
                    </CheckBox>
                </StackPanel>
            </StackPanel>

            <StackPanel Visibility="{Binding IsSeismicSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="SEISMIC" Style="{StaticResource SectionHeader}"/>
                <CheckBox IsChecked="{Binding Loads.SeismicAnalysisEnabled, Mode=TwoWay}">
                    <TextBlock Text="Enable seismic analysis" Foreground="{DynamicResource WindowForegroundBrush}"/>
                </CheckBox>
                <TextBlock Text="k_h" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Loads.SeismicEditTarget.PseudoStaticKh, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="k_v" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Loads.SeismicEditTarget.PseudoStaticKv, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
