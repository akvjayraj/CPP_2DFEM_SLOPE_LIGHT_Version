<UserControl x:Class="GeotechSlopeApp.Views.Workspace.GroundwaterPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GeotechSlopeApp.Converters"
             Background="{DynamicResource PanelBackgroundBrush}"
             Foreground="{DynamicResource WindowForegroundBrush}">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <DockPanel Visibility="{Binding IsPropertiesExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
        <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4">
            <Button DockPanel.Dock="Right"
                    Command="{Binding TogglePropertiesCommand}"
                    ToolTip="Hide Groundwater Properties"
                    Width="22" Height="22" Padding="0"
                    Background="Transparent" BorderThickness="0">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE70E;"
                           Foreground="{DynamicResource WindowForegroundBrush}"/>
            </Button>
            <TextBlock Text="GROUNDWATER PROPERTIES" FontWeight="SemiBold" FontSize="13"
                       Foreground="{DynamicResource WindowForegroundBrush}"/>
        </DockPanel>
        <TextBlock Margin="8,4,8,8"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="Pore-pressure method, surfaces, grids, water heads, and transient BCs are in Groundwater Explorer."/>
    </DockPanel>
</UserControl>
