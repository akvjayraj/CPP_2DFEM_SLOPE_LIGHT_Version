<UserControl x:Class="GeotechSlopeApp.Views.Workspace.MeshInformationTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GeotechSlopeApp.Converters"
             Background="{DynamicResource PanelBackgroundBrush}"
             Foreground="{DynamicResource WindowForegroundBrush}">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="PanelCollapseButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>
    <DockPanel Visibility="{Binding IsTableExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Border DockPanel.Dock="Top" Padding="8,5">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource PanelCollapseButton}"
                        Command="{Binding ToggleTableCommand}"
                        ToolTip="Collapse or expand Mesh Information">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Text="{Binding TableChevronGlyph}"
                               Foreground="{DynamicResource WindowForegroundBrush}"/>
                </Button>
                <TextBlock Text="Mesh Information"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WindowForegroundBrush}"/>
            </DockPanel>
        </Border>
        <DataGrid ItemsSource="{Binding Mesh.MeshInformationRows}"
                  SelectedItem="{Binding Mesh.SelectedMeshInformationRow, Mode=TwoWay}"
                  Visibility="{Binding IsTableExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  Background="{DynamicResource PanelBackgroundBrush}"
                  Foreground="{DynamicResource WindowForegroundBrush}"
                  RowBackground="{DynamicResource PanelBackgroundBrush}"
                  AlternatingRowBackground="{DynamicResource PanelBackgroundBrush}"
                  HorizontalGridLinesBrush="{DynamicResource ChromeBorderBrush}"
                  VerticalGridLinesBrush="{DynamicResource ChromeBorderBrush}"
                  BorderThickness="0"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Element ID" Binding="{Binding ElementId}" Width="80"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="50"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Etype" Binding="{Binding Etype}" Width="50"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Node 1" Binding="{Binding Node1}" Width="56"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Node 2" Binding="{Binding Node2}" Width="56"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Node 3" Binding="{Binding Node3}" Width="56"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Node 4" Binding="{Binding Node4}" Width="56"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Node 5" Binding="{Binding Node5}" Width="56"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Node 6" Binding="{Binding Node6}" Width="56"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Node 7" Binding="{Binding Node7}" Width="56"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Node 8" Binding="{Binding Node8}" Width="56"
                                    ElementStyle="{StaticResource CellText}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
