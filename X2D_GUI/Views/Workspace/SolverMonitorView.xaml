<UserControl x:Class="GeotechSlopeApp.Views.Workspace.SolverMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="{DynamicResource PanelBackgroundBrush}">
        <DockPanel DockPanel.Dock="Top" Margin="8,6,8,4">
            <TextBlock Text="Analysis log" FontWeight="SemiBold"
                       Foreground="{DynamicResource WindowForegroundBrush}"/>
            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                       Text="{Binding FEAnalysisVM.StatusMessage}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <TextBox Text="{Binding Workspace.SolverLog, Mode=OneWay}"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="11"
                 Margin="8,0,8,8"
                 Background="{DynamicResource ViewportPaperBrush}"
                 Foreground="{DynamicResource WindowForegroundBrush}"
                 BorderBrush="{DynamicResource ChromeBorderBrush}"/>
    </DockPanel>
</UserControl>
