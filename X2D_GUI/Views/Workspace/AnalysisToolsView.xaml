<UserControl x:Class="GeotechSlopeApp.Views.Workspace.AnalysisToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PanelBackgroundBrush}"
             Foreground="{DynamicResource WindowForegroundBrush}">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10,8,10,6">
            <TextBlock Text="Analysis Tools" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Button Content="Check Model" Command="{Binding Workspace.CheckModelCommand}"/>
            <Button Content="Verify Boundary Conditions" Command="{Binding Workspace.VerifyBoundaryConditionsCommand}"/>
            <Button Content="Verify Loads" Command="{Binding Workspace.VerifyLoadsCommand}"/>
            <Button Content="Verify Materials" Command="{Binding Workspace.VerifyMaterialsCommand}"/>
            <Button Content="Verify Mesh" Command="{Binding Workspace.VerifyMeshCommand}"/>
            <Button Content="Run Trial Analysis" Command="{Binding Workspace.RunTrialAnalysisCommand}"/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="10,0,10,6">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBlock Text="Analysis Log" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                        Content="Clear Log"
                        Command="{Binding Workspace.ClearLogCommand}"
                        Padding="8,2"/>
            </DockPanel>
            <TextBox Text="{Binding Workspace.SolverLog, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="11"
                     Background="{DynamicResource ViewportPaperBrush}"/>
        </DockPanel>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource ChromeBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,8">
            <StackPanel>
                <TextBlock Text="Quick Settings" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <CheckBox Content="Auto Save Results"
                          IsChecked="{Binding Workspace.Settings.AutoSaveResults}"
                          Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Save Interval (min)" Width="130" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBox Width="56" Text="{Binding Workspace.Settings.SaveIntervalMinutes}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Keep Log (days)" Width="130" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBox Width="56" Text="{Binding Workspace.Settings.KeepLogDays}"/>
                </StackPanel>
                <Button Content="More Settings..."
                        Command="{Binding PreferencesCommand}"
                        Foreground="#FF60A5FA"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
