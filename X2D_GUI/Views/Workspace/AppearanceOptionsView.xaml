<UserControl x:Class="GeotechSlopeApp.Views.Workspace.AppearanceOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
        <StackPanel>
            <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{DynamicResource WindowForegroundBrush}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="Presets and custom colors apply to Analysis Workspace chrome. Classic tabs stay the default layout until you opt in under View → User interface."/>

            <TextBlock Text="Layout" FontWeight="SemiBold" Margin="0,4,0,6"
                       Foreground="{DynamicResource WindowForegroundBrush}"/>
            <RadioButton Content="Classic tabs (default)"
                         IsChecked="{Binding UseClassicTabs, Mode=TwoWay}"
                         Margin="0,2"/>
            <RadioButton Content="Analysis Workspace"
                         IsChecked="{Binding UseAnalysisWorkspace, Mode=TwoWay}"
                         Margin="0,2,0,10"/>

            <TextBlock Text="Color preset" FontWeight="SemiBold" Margin="0,4,0,6"
                       Foreground="{DynamicResource WindowForegroundBrush}"/>
            <RadioButton Content="Classic light" IsChecked="{Binding IsClassicLight}" Margin="0,2"/>
            <RadioButton Content="Light" IsChecked="{Binding IsLight}" Margin="0,2"/>
            <RadioButton Content="Dark" IsChecked="{Binding IsDark}" Margin="0,2"/>
            <RadioButton Content="Custom" IsChecked="{Binding IsCustom}" Margin="0,2,0,10"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Window / panel background" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding WindowBackground, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                <TextBlock Grid.Row="1" Text="Font / text" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WindowForeground, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                <TextBlock Grid.Row="2" Text="Secondary text" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SecondaryText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                <TextBlock Grid.Row="3" Text="Accent" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Accent, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                <TextBlock Grid.Row="4" Text="Viewport paper" VerticalAlignment="Center"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ViewportPaper, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                <TextBlock Grid.Row="5" Text="Grid" VerticalAlignment="Center"/>
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Grid, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
            </Grid>

            <TextBlock Text="{Binding ContrastWarning}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Foreground="#B45309"/>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,4,0,8"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="Apply" Width="88" Margin="0,0,8,0" Command="{Binding ApplyCommand}"/>
                <Button Content="Reset to preset" Width="120" Command="{Binding ResetPresetCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
