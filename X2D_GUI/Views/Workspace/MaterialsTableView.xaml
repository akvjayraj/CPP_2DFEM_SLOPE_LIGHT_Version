<UserControl x:Class="GeotechSlopeApp.Views.Workspace.MaterialsTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GeotechSlopeApp.Converters"
             Background="{DynamicResource PanelBackgroundBrush}"
             Foreground="{DynamicResource WindowForegroundBrush}">
    <UserControl.Resources>
        <converters:FailureCriterionConverter x:Key="FailureCriterionConverter"/>
        <converters:MaterialTypeConverter x:Key="MaterialTypeConverter"/>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="Materials"
                   FontWeight="SemiBold"
                   Margin="8,6,8,4"
                   Foreground="{DynamicResource WindowForegroundBrush}"/>
        <DataGrid ItemsSource="{Binding Materials.Materials}"
                  SelectedItem="{Binding Materials.SelectedMaterialModel, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  Background="{DynamicResource PanelBackgroundBrush}"
                  Foreground="{DynamicResource WindowForegroundBrush}"
                  RowBackground="{DynamicResource PanelBackgroundBrush}"
                  AlternatingRowBackground="{DynamicResource PanelBackgroundBrush}"
                  HorizontalGridLinesBrush="{DynamicResource ChromeBorderBrush}"
                  BorderThickness="0"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40" IsReadOnly="True"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Model" Binding="{Binding FailureCriterion, Converter={StaticResource FailureCriterionConverter}}" Width="110" IsReadOnly="True"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Type" Binding="{Binding MaterialType, Converter={StaticResource MaterialTypeConverter}}" Width="90" IsReadOnly="True"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="γ" Binding="{Binding UnitWeight, StringFormat={}{0:0.###}}" Width="60"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="E" Binding="{Binding YoungsModulus, StringFormat={}{0:0.###}}" Width="80"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="c'" Binding="{Binding Cohesion, StringFormat={}{0:0.###}}" Width="60"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="φ'" Binding="{Binding FrictionAngle, StringFormat={}{0:0.###}}" Width="50"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTemplateColumn Header="Color" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="22" Height="12" CornerRadius="2" Margin="4,2"
                                    Background="{Binding ColourBrush}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
