<UserControl x:Class="GeotechSlopeApp.Views.Workspace.AnalysisRibbonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GeotechSlopeApp.Converters"
             xmlns:local="clr-namespace:GeotechSlopeApp.Views.Workspace">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

        <Style x:Key="FileColumnHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FileLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="2,3"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ExplorerSelectionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>
        <Style x:Key="FileIconToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="MinWidth" Value="37"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ExplorerSelectionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ExplorerSelectionBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FileIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="MinWidth" Value="37"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ExplorerSelectionBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FileIconCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxWidth" Value="42"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="FileGroupCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="FileGroupBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="3,1,6,1"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
        </Style>
        <Style x:Key="FileGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="AnalysisGlyph" TargetType="TextBlock" BasedOn="{StaticResource FileGlyph}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>
        <Style x:Key="AnalysisIconCaption" TargetType="TextBlock" BasedOn="{StaticResource FileIconCaption}">
            <Setter Property="MaxWidth" Value="68"/>
            <Setter Property="FontSize" Value="9"/>
        </Style>
        <Style x:Key="AnalysisIconToggle" TargetType="ToggleButton" BasedOn="{StaticResource FileIconToggleButton}">
            <Setter Property="MinWidth" Value="52"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style x:Key="AnalysisIconButton" TargetType="Button" BasedOn="{StaticResource FileIconButton}">
            <Setter Property="MinWidth" Value="52"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style x:Key="FileChevron" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="7"/>
            <Setter Property="Text" Value="&#xE70D;"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
        <Style x:Key="GeometrySelectButton" TargetType="Button" BasedOn="{StaticResource FileIconButton}">
            <Setter Property="Background" Value="{DynamicResource ExplorerSelectionBrush}"/>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource ChromeBorderBrush}"
                                BorderThickness="1"
                                Padding="4,4">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Icon"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  Margin="8,0,16,0"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                                <TextBlock Grid.Column="2"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="8,0,4,0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ExplorerSelectionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#FFF8FAFC"/>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource ChromeBorderBrush}"
            BorderThickness="0,0,0,1">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,4,6,0">
                <RadioButton Content="FILE" GroupName="WsRibbon" Margin="4,0"
                             IsChecked="{Binding Workspace.IsFileRibbon, Mode=OneWay}"
                             Command="{Binding Workspace.SelectRibbonTabCommand}" CommandParameter="FILE"/>
                <RadioButton Content="GEOMETRY" GroupName="WsRibbon" Margin="4,0"
                             IsChecked="{Binding Workspace.IsGeometryRibbon, Mode=OneWay}"
                             Command="{Binding Workspace.SelectRibbonTabCommand}" CommandParameter="GEOMETRY"/>
                <RadioButton Content="MATERIALS" GroupName="WsRibbon" Margin="4,0"
                             IsChecked="{Binding Workspace.IsMaterialsRibbon, Mode=OneWay}"
                             Command="{Binding Workspace.SelectRibbonTabCommand}" CommandParameter="MATERIALS"/>
                <RadioButton Content="LOADS" GroupName="WsRibbon" Margin="4,0"
                             IsChecked="{Binding Workspace.IsLoadsRibbon, Mode=OneWay}"
                             Command="{Binding Workspace.SelectRibbonTabCommand}" CommandParameter="LOADS"/>
                <RadioButton Content="MESH" GroupName="WsRibbon" Margin="4,0"
                             IsChecked="{Binding Workspace.IsMeshRibbon, Mode=OneWay}"
                             Command="{Binding Workspace.SelectRibbonTabCommand}" CommandParameter="MESH"/>
                <RadioButton Content="BOUNDARY" GroupName="WsRibbon" Margin="4,0"
                             IsChecked="{Binding Workspace.IsBoundaryRibbon, Mode=OneWay}"
                             Command="{Binding Workspace.SelectRibbonTabCommand}" CommandParameter="BOUNDARY"/>
                <RadioButton Content="GROUNDWATER" GroupName="WsRibbon" Margin="4,0"
                             Visibility="{Binding Workspace.ShowGroundwaterRibbon, Converter={StaticResource BooleanToVisibilityConverter}}"
                             IsChecked="{Binding Workspace.IsGroundwaterRibbon, Mode=OneWay}"
                             Command="{Binding Workspace.SelectRibbonTabCommand}" CommandParameter="GROUNDWATER"/>
                <RadioButton Content="ANALYSIS" GroupName="WsRibbon" Margin="4,0"
                             IsChecked="{Binding Workspace.IsAnalysisRibbon, Mode=OneWay}"
                             Command="{Binding Workspace.SelectRibbonTabCommand}" CommandParameter="ANALYSIS"/>
                <RadioButton Content="RESULTS" GroupName="WsRibbon" Margin="4,0"
                             IsChecked="{Binding Workspace.IsResultsRibbon, Mode=OneWay}"
                             Command="{Binding Workspace.SelectRibbonTabCommand}" CommandParameter="RESULTS"/>
                <RadioButton Content="VIEW" GroupName="WsRibbon" Margin="4,0"
                             IsChecked="{Binding Workspace.IsViewRibbon, Mode=OneWay}"
                             Command="{Binding Workspace.SelectRibbonTabCommand}" CommandParameter="VIEW"/>
            </StackPanel>
            <Grid Margin="8,4,8,2">
                <WrapPanel IsHitTestVisible="{Binding Workspace.IsFileRibbon}"
                           Visibility="{Binding Workspace.IsFileRibbon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Style="{StaticResource FileGroupBorder}">
                                    <StackPanel>
                                        <Button Style="{StaticResource FileIconButton}" Click="OpenFileDropdown" ToolTip="New">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FileGlyph}" Text="&#xE8A5;" Foreground="#FFF59E0B"/>
                                                <TextBlock Style="{StaticResource FileIconCaption}" Text="New Project"/>
                                                <TextBlock Style="{StaticResource FileChevron}"/>
                                            </StackPanel>
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="New Project" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N">
                                                        <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8A5;" Foreground="#FFF59E0B"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="New from Template" Command="{Binding Workspace.ShowCapabilityCommand}" CommandParameter="NewFromTemplate">
                                                        <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8F1;"/></MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                        <TextBlock Style="{StaticResource FileGroupCaption}" Text="New"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FileGroupBorder}">
                                    <StackPanel>
                                        <Button Style="{StaticResource FileIconButton}" Click="OpenFileDropdown" ToolTip="Open">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FileGlyph}" Text="&#xED25;" Foreground="#FFF59E0B"/>
                                                <TextBlock Style="{StaticResource FileIconCaption}" Text="Open Project"/>
                                                <TextBlock Style="{StaticResource FileChevron}"/>
                                            </StackPanel>
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Open Project..." Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+O">
                                                        <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xED25;" Foreground="#FFF59E0B"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Close Project" Command="{Binding CloseProjectCommand}" InputGestureText="Ctrl+F4">
                                                        <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8BB;"/></MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                        <TextBlock Style="{StaticResource FileGroupCaption}" Text="Open"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FileGroupBorder}">
                                    <StackPanel>
                                        <Button Style="{StaticResource FileIconButton}" Click="OpenFileDropdown" ToolTip="Save">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FileGlyph}" Text="&#xE74E;" Foreground="#FFA78BFA"/>
                                                <TextBlock Style="{StaticResource FileIconCaption}" Text="Save Project"/>
                                                <TextBlock Style="{StaticResource FileChevron}"/>
                                            </StackPanel>
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Save Project" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S">
                                                        <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE74E;" Foreground="#FFA78BFA"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Save As..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S">
                                                        <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE70F;" Foreground="#FFA78BFA"/></MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                        <TextBlock Style="{StaticResource FileGroupCaption}" Text="Save"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FileGroupBorder}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource FileIconButton}" Click="OpenFileDropdown" ToolTip="Import">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource FileGlyph}" Text="&#xE8B5;" Foreground="#FF60A5FA"/>
                                                    <TextBlock Style="{StaticResource FileIconCaption}" Text="Import"/>
                                                    <TextBlock Style="{StaticResource FileChevron}"/>
                                                </StackPanel>
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Import Geometry" Command="{Binding ImportGeometryFileCommand}">
                                                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xED63;" Foreground="#FF60A5FA"/></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Import Mesh" Command="{Binding ImportMeshFileCommand}">
                                                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE80A;" Foreground="#FF60A5FA"/></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Import Point Cloud" Command="{Binding Workspace.ShowCapabilityCommand}" CommandParameter="ImportPointCloud">
                                                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE81E;" Foreground="#FF60A5FA"/></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Import External Data" Command="{Binding ImportSlopeImageCommand}">
                                                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8B5;" Foreground="#FF60A5FA"/></MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                            <Button Style="{StaticResource FileIconButton}" Click="OpenFileDropdown" ToolTip="Export">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource FileGlyph}" Text="&#xEDE1;" Foreground="#FF34D399"/>
                                                    <TextBlock Style="{StaticResource FileIconCaption}" Text="Export"/>
                                                    <TextBlock Style="{StaticResource FileChevron}"/>
                                                </StackPanel>
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Export Geometry" Command="{Binding ExportGeometryCommand}">
                                                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xED63;" Foreground="#FF34D399"/></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Export Mesh" Command="{Binding ExportMeshCommand}">
                                                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE80A;" Foreground="#FF34D399"/></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Export Results" Command="{Binding ExportResultsCommand}">
                                                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE9F9;" Foreground="#FF34D399"/></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Export Graphics" Command="{Binding Workspace.ShowCapabilityCommand}" CommandParameter="ExportGraphics">
                                                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE91B;" Foreground="#FF34D399"/></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Export Report" Command="{Binding ExportReportCommand}">
                                                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE9D2;" Foreground="#FF34D399"/></MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource FileGroupCaption}" Text="Import / Export"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FileGroupBorder}">
                                    <StackPanel>
                                        <Button Style="{StaticResource FileIconButton}" Click="OpenFileDropdown" ToolTip="Project">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FileGlyph}" Text="&#xE946;" Foreground="#FF7DD3FC"/>
                                                <TextBlock Style="{StaticResource FileIconCaption}" Text="Project Info"/>
                                                <TextBlock Style="{StaticResource FileChevron}"/>
                                            </StackPanel>
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Project Information" Command="{Binding ProjectSettingsGeneralCommand}">
                                                        <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE946;" Foreground="#FF7DD3FC"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Project Details" Command="{Binding ProjectSettingsGeneralCommand}">
                                                        <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8A1;" Foreground="#FF7DD3FC"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Project Statistics" Command="{Binding Workspace.CheckModelCommand}">
                                                        <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE9D2;" Foreground="#FF7DD3FC"/></MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                        <TextBlock Style="{StaticResource FileGroupCaption}" Text="Project"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FileGroupBorder}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource FileIconButton}" Click="OpenFileDropdown" ToolTip="Recent Projects">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource FileGlyph}" Text="&#xE81C;" Foreground="{DynamicResource WindowForegroundBrush}"/>
                                                    <TextBlock Style="{StaticResource FileIconCaption}" Text="Recent Projects"/>
                                                    <TextBlock Style="{StaticResource FileChevron}"/>
                                                </StackPanel>
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="(No recent projects)"
                                                                  IsEnabled="False"
                                                                  Visibility="{Binding RecentProjects.HasEntries, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE81C;"/></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem ItemsSource="{Binding RecentProjects.Entries}"
                                                                  Visibility="{Binding RecentProjects.HasEntries, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <MenuItem.ItemContainerStyle>
                                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                                    <Setter Property="Header" Value="{Binding DisplayName}"/>
                                                                    <Setter Property="ToolTip" Value="{Binding ToolTip}"/>
                                                                    <Setter Property="Command"
                                                                            Value="{Binding DataContext.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                    <Setter Property="CommandParameter" Value="{Binding FilePath}"/>
                                                                </Style>
                                                            </MenuItem.ItemContainerStyle>
                                                        </MenuItem>
                                                        <Separator/>
                                                        <MenuItem Header="Clear Recent List" Command="{Binding ClearRecentFilesCommand}">
                                                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE74D;"/></MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                            <Button Style="{StaticResource FileIconButton}" Click="OpenFileDropdown" ToolTip="Version History">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource FileGlyph}" Text="&#xE81C;" Foreground="{DynamicResource WindowForegroundBrush}"/>
                                                    <TextBlock Style="{StaticResource FileIconCaption}" Text="Version History"/>
                                                    <TextBlock Style="{StaticResource FileChevron}"/>
                                                </StackPanel>
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Version History" Command="{Binding Workspace.ShowCapabilityCommand}" CommandParameter="VersionHistory">
                                                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE81C;"/></MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource FileGroupCaption}" Text="Project Management"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FileGroupBorder}">
                                    <StackPanel>
                                        <Button Style="{StaticResource FileIconButton}" Click="OpenFileDropdown" ToolTip="Backup">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FileGlyph}" Text="&#xE777;" Foreground="#FF60A5FA"/>
                                                <TextBlock Style="{StaticResource FileIconCaption}" Text="Backup &amp; Recovery"/>
                                                <TextBlock Style="{StaticResource FileChevron}"/>
                                            </StackPanel>
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Backup &amp; Recovery" Command="{Binding Workspace.ShowCapabilityCommand}" CommandParameter="BackupRecovery">
                                                        <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE777;" Foreground="#FF60A5FA"/></MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                        <TextBlock Style="{StaticResource FileGroupCaption}" Text="Backup"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FileGroupBorder}">
                                    <StackPanel>
                                        <Button Style="{StaticResource FileIconButton}" Click="OpenFileDropdown" ToolTip="Print">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FileGlyph}" Text="&#xE749;" Foreground="{DynamicResource WindowForegroundBrush}"/>
                                                <TextBlock Style="{StaticResource FileIconCaption}" Text="Print"/>
                                                <TextBlock Style="{StaticResource FileChevron}"/>
                                            </StackPanel>
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Print..." Command="{Binding PrintCommand}" InputGestureText="Ctrl+P">
                                                        <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE749;"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Print Preview..." Command="{Binding PrintPreviewCommand}">
                                                        <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8A1;"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Page Setup..." Command="{Binding PageSetupCommand}">
                                                        <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE771;"/></MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                        <TextBlock Style="{StaticResource FileGroupCaption}" Text="Print"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FileGroupBorder}" BorderThickness="0">
                                    <StackPanel>
                                        <Button Style="{StaticResource FileIconButton}" Click="OpenFileDropdown" ToolTip="Report">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FileGlyph}" Text="&#xE9D2;" Foreground="{DynamicResource WindowForegroundBrush}"/>
                                                <TextBlock Style="{StaticResource FileIconCaption}" Text="Report"/>
                                                <TextBlock Style="{StaticResource FileChevron}"/>
                                            </StackPanel>
                                            <Button.ContextMenu>
                                                <ContextMenu>
