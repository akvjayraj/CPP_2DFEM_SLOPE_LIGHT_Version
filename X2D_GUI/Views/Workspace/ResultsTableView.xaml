<UserControl x:Class="GeotechSlopeApp.Views.Workspace.ResultsTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GeotechSlopeApp.Converters"
             Background="{DynamicResource PanelBackgroundBrush}"
             Foreground="{DynamicResource WindowForegroundBrush}">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="RowBackground" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ChromeBorderBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource ChromeBorderBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
        </Style>
    </UserControl.Resources>
    <Grid Visibility="{Binding IsTableExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0" Margin="8,6,4,6">
            <TextBlock DockPanel.Dock="Top" Text="MESSAGES" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"
                       Foreground="{DynamicResource WindowForegroundBrush}"/>
            <TextBox Text="{Binding MessagesText, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Background="{DynamicResource ViewportPaperBrush}"
                     Foreground="{DynamicResource WindowForegroundBrush}"
                     BorderBrush="{DynamicResource ChromeBorderBrush}"/>
        </DockPanel>
        <DockPanel Grid.Column="1" Margin="4,6,8,6">
            <TextBlock DockPanel.Dock="Top" Text="MIN / MAX SUMMARY" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"
                       Foreground="{DynamicResource WindowForegroundBrush}"/>
            <DataGrid ItemsSource="{Binding MinMaxRows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="*"/>
                    <DataGridTextColumn Header="Min" Binding="{Binding MinText}" Width="80"/>
                    <DataGridTextColumn Header="Max" Binding="{Binding MaxText}" Width="80"/>
                    <DataGridTextColumn Header="Min (X, Y)" Binding="{Binding MinLocation}" Width="110"/>
                    <DataGridTextColumn Header="Max (X, Y)" Binding="{Binding MaxLocation}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
