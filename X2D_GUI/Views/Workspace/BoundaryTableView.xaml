<UserControl x:Class="GeotechSlopeApp.Views.Workspace.BoundaryTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GeotechSlopeApp.Converters"
             Background="{DynamicResource PanelBackgroundBrush}"
             Foreground="{DynamicResource WindowForegroundBrush}">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="PanelCollapseButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TableAction" TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ViewportPaperBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>
    <DockPanel Visibility="{Binding IsTableExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Border DockPanel.Dock="Top" Padding="8,5">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource PanelCollapseButton}"
                        Command="{Binding ToggleTableCommand}"
                        ToolTip="Collapse or expand Boundary Table">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Text="{Binding TableChevronGlyph}"
                               Foreground="{DynamicResource WindowForegroundBrush}"/>
                </Button>
                <TextBlock Text="BOUNDARY TABLE"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WindowForegroundBrush}"/>
            </DockPanel>
        </Border>
        <StackPanel DockPanel.Dock="Right" Margin="8,4,8,4" Width="88"
                    Visibility="{Binding IsTableExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Button Style="{StaticResource TableAction}" Content="Apply"
                    Command="{Binding ApplyCommand}"/>
            <Button Style="{StaticResource TableAction}" Content="Delete"
                    Command="{Binding DeleteSelectedCommand}"/>
            <Button Style="{StaticResource TableAction}" Content="Clear"
                    Command="{Binding Boundary.ClearBoundaryConditionsCommand}"/>
            <Button Style="{StaticResource TableAction}" Content="Markers"
                    Command="{Binding ToggleMarkersCommand}"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Boundary.BoundaryConditions}"
                  SelectedItem="{Binding Boundary.SelectedBoundaryCondition, Mode=TwoWay}"
                  Visibility="{Binding IsTableExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  Background="{DynamicResource PanelBackgroundBrush}"
                  Foreground="{DynamicResource WindowForegroundBrush}"
                  RowBackground="{DynamicResource PanelBackgroundBrush}"
                  AlternatingRowBackground="{DynamicResource PanelBackgroundBrush}"
                  HorizontalGridLinesBrush="{DynamicResource ChromeBorderBrush}"
                  VerticalGridLinesBrush="{DynamicResource ChromeBorderBrush}"
                  BorderThickness="0"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Node" Binding="{Binding NodeId}" Width="56" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Boundary" Binding="{Binding BoundaryName}" Width="100" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Type" Binding="{Binding BCType}" Width="140" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Category" Binding="{Binding AnalysisCategory}" Width="140" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="DOF" Binding="{Binding DofDisplay}" Width="70" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="70" ElementStyle="{StaticResource CellText}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
