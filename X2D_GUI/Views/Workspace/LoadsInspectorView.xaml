<UserControl x:Class="GeotechSlopeApp.Views.Workspace.LoadsInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GeotechSlopeApp.Converters"
             Background="{DynamicResource PanelBackgroundBrush}"
             Foreground="{DynamicResource WindowForegroundBrush}"
             TextElement.Foreground="{DynamicResource WindowForegroundBrush}">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:StringToBrushConverter x:Key="StringToBrushConverter" UseWindowForegroundFallback="True"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,12,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ViewportPaperBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style x:Key="SectionRule" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ChromeBorderBrush}"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8,10,12"
                  Visibility="{Binding IsInspectorExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel>
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right"
                        Command="{Binding ToggleInspectorCommand}"
                        ToolTip="Hide selected load details"
                        Width="22" Height="22" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE711;"
                               Foreground="{DynamicResource WindowForegroundBrush}"/>
                </Button>
                <TextBlock Text="SELECTED LOAD DETAILS"
                           FontWeight="SemiBold"
                           FontSize="13"
                           VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="No load selected"
                       Foreground="{DynamicResource WindowForegroundBrush}"
                       Margin="0,4,0,8"
                       Visibility="{Binding HasSelectedLoad, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>

            <StackPanel Visibility="{Binding HasSelectedLoad, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding InspectorName}"
                           FontSize="13"
                           Margin="0,0,0,4"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock Text="GENERAL" Style="{StaticResource SectionHeader}" Margin="0,8,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Type" Style="{StaticResource FieldLabel}"/>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}">
                        <TextBlock Text="{Binding InspectorType}" Style="{StaticResource FieldValue}"/>
                    </Border>
                    <TextBlock Grid.Row="1" Text="Direction" Style="{StaticResource FieldLabel}"/>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}">
                        <TextBlock Text="{Binding InspectorDirection}" Style="{StaticResource FieldValue}"/>
                    </Border>
                    <TextBlock Grid.Row="2" Text="Value" Style="{StaticResource FieldLabel}"/>
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}">
                        <TextBlock Text="{Binding InspectorValue}" Style="{StaticResource FieldValue}"/>
                    </Border>
                    <TextBlock Grid.Row="3" Text="Distribution" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Grid.Row="3" Grid.Column="1"
                              Style="{StaticResource FieldCombo}"
                              ItemsSource="{Binding DistributionOptions}"
                              SelectedItem="{Binding SelectedLoad.DisplayDistribution, Mode=TwoWay}"/>
                    <TextBlock Grid.Row="4" Text="Load Group" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Grid.Row="4" Grid.Column="1"
                              Style="{StaticResource FieldCombo}"
                              ItemsSource="{Binding LoadGroupOptions}"
                              SelectedItem="{Binding SelectedLoad.LoadGroup, Mode=TwoWay}"/>
                    <TextBlock Grid.Row="5" Text="Status" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="5" Grid.Column="1"
                               Text="{Binding InspectorStatus}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,0,6"
                               Foreground="{Binding InspectorStatusColor, Converter={StaticResource StringToBrushConverter}}"/>
                </Grid>
                <Border Style="{StaticResource SectionRule}"/>

                <TextBlock Text="APPLIED GEOMETRY" Style="{StaticResource SectionHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Surfaces" Style="{StaticResource FieldLabel}"/>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}">
                        <TextBlock Text="{Binding InspectorSurfaces}" Style="{StaticResource FieldValue}"/>
                    </Border>
                    <TextBlock Grid.Row="1" Text="Area" Style="{StaticResource FieldLabel}"/>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}">
                        <TextBlock Text="{Binding InspectorArea}" Style="{StaticResource FieldValue}"/>
                    </Border>
                    <TextBlock Grid.Row="2" Text="Length" Style="{StaticResource FieldLabel}"
                               Visibility="{Binding InspectorShowsLength, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}"
                            Visibility="{Binding InspectorShowsLength, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding InspectorLength}" Style="{StaticResource FieldValue}"/>
                    </Border>
                </Grid>
                <Border Style="{StaticResource SectionRule}"/>

                <TextBlock Text="DIRECTION PREVIEW" Style="{StaticResource SectionHeader}"/>
                <Border BorderBrush="{DynamicResource ChromeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="8,10"
                        Background="{DynamicResource WindowBackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="{Binding InspectorValue}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   FontSize="11"
                                   Margin="0,0,0,4"/>
                        <Grid Height="72" ClipToBounds="True">
                            <Canvas Width="200" Height="72" HorizontalAlignment="Center">
                                <Canvas.RenderTransform>
                                    <RotateTransform Angle="{Binding InspectorPreviewAngle}" CenterX="100" CenterY="36"/>
                                </Canvas.RenderTransform>
                                <Line X1="24" Y1="48" X2="176" Y2="48"
                                      Stroke="{DynamicResource WindowForegroundBrush}" StrokeThickness="1.5"/>
                                <Line X1="28" Y1="52" X2="36" Y2="60" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1"/>
                                <Line X1="44" Y1="52" X2="52" Y2="60" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1"/>
                                <Line X1="60" Y1="52" X2="68" Y2="60" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1"/>
                                <Line X1="76" Y1="52" X2="84" Y2="60" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1"/>
                                <Line X1="92" Y1="52" X2="100" Y2="60" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1"/>
                                <Line X1="108" Y1="52" X2="116" Y2="60" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1"/>
                                <Line X1="124" Y1="52" X2="132" Y2="60" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1"/>
                                <Line X1="140" Y1="52" X2="148" Y2="60" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1"/>
                                <Line X1="156" Y1="52" X2="164" Y2="60" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1"/>
                                <Path Data="M 36,18 L 36,46 L 32,40 M 36,46 L 40,40" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                                <Path Data="M 60,18 L 60,46 L 56,40 M 60,46 L 64,40" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                                <Path Data="M 84,18 L 84,46 L 80,40 M 84,46 L 88,40" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                                <Path Data="M 108,18 L 108,46 L 104,40 M 108,46 L 112,40" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                                <Path Data="M 132,18 L 132,46 L 128,40 M 132,46 L 136,40" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                                <Path Data="M 156,18 L 156,46 L 152,40 M 156,46 L 160,40" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                            </Canvas>
                        </Grid>
                        <TextBlock Text="{Binding InspectorPreviewCaption}"
                                   HorizontalAlignment="Center"
                                   FontSize="11"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SectionRule}"/>

                <TextBlock Text="STAGE ASSIGNMENT" Style="{StaticResource SectionHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Apply From Stage" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              Style="{StaticResource FieldCombo}"
                              ItemsSource="{Binding StageFromChoices}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Number"
                              SelectedValue="{Binding SelectedLoad.ApplyFromStage, Mode=TwoWay, TargetNullValue=1}"/>
                    <TextBlock Grid.Row="1" Text="Apply To Stage" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              Style="{StaticResource FieldCombo}"
                              ItemsSource="{Binding StageToChoices}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Number"
                              SelectedValue="{Binding SelectedLoad.ApplyToStageOrAll, Mode=TwoWay}"/>
                </Grid>
                <Border Style="{StaticResource SectionRule}"/>

                <TextBlock Text="RESULTANT LOAD" Style="{StaticResource SectionHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Vertical (kN)" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding InspectorResultantVertical}"
                               HorizontalAlignment="Right"
                               Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="1" Text="Horizontal X (kN)" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding InspectorResultantHorizontalX}"
                               HorizontalAlignment="Right"
                               Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="2" Text="Horizontal Y (kN)" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="{Binding InspectorResultantHorizontalY}"
                               HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
