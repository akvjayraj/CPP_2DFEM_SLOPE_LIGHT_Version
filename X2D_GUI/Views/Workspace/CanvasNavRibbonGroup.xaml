<UserControl x:Class="GeotechSlopeApp.Views.Workspace.CanvasNavRibbonGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CanvasNavButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ExplorerSelectionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ExplorerSelectionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CanvasNavGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <UniformGrid Rows="2" Columns="3">
        <Button Style="{StaticResource CanvasNavButton}"
                Command="{Binding NavigateToGeometryCommand}"
                ToolTip="Select">
            <TextBlock Style="{StaticResource CanvasNavGlyph}" Text="&#xE8B0;"/>
        </Button>
        <Button Style="{StaticResource CanvasNavButton}"
                Command="{Binding ZoomInCommand}"
                ToolTip="Zoom In">
            <TextBlock Style="{StaticResource CanvasNavGlyph}" Text="&#xE8A3;"/>
        </Button>
        <Button Style="{StaticResource CanvasNavButton}"
                Command="{Binding ZoomOutCommand}"
                ToolTip="Zoom Out">
            <TextBlock Style="{StaticResource CanvasNavGlyph}" Text="&#xE71F;"/>
        </Button>
        <Button Style="{StaticResource CanvasNavButton}"
                Command="{Binding ToggleZoomAreaModeCommand}"
                ToolTip="Zoom Window">
            <TextBlock Style="{StaticResource CanvasNavGlyph}" Text="&#xE8A7;"/>
        </Button>
        <Button Style="{StaticResource CanvasNavButton}"
                Command="{Binding ZoomToFitCommand}"
                ToolTip="Zoom All">
            <TextBlock Style="{StaticResource CanvasNavGlyph}" Text="&#xE9A6;"/>
        </Button>
        <Button Style="{StaticResource CanvasNavButton}"
                Command="{Binding TogglePanModeCommand}"
                ToolTip="Pan">
            <TextBlock Style="{StaticResource CanvasNavGlyph}" Text="&#xE7C2;"/>
        </Button>
    </UniformGrid>
</UserControl>
