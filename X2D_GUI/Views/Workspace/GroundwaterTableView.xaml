<UserControl x:Class="GeotechSlopeApp.Views.Workspace.GroundwaterTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GeotechSlopeApp.Converters"
             Background="{DynamicResource PanelBackgroundBrush}"
             Foreground="{DynamicResource WindowForegroundBrush}">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>
    <DockPanel Visibility="{Binding IsTableExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Border DockPanel.Dock="Top" Padding="8,5">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Command="{Binding ToggleTableCommand}"
                        Width="22" Height="22" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="Collapse or expand Groundwater Table">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Text="{Binding TableChevronGlyph}"
                               Foreground="{DynamicResource WindowForegroundBrush}"/>
                </Button>
                <TextBlock Text="GROUNDWATER TABLE"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WindowForegroundBrush}"/>
            </DockPanel>
        </Border>
        <TabControl Background="{DynamicResource PanelBackgroundBrush}"
                    BorderThickness="0">
            <TabItem Header="Water Heads">
                <DataGrid ItemsSource="{Binding WaterHeads}"
                          SelectedItem="{Binding Groundwater.SelectedWaterHead, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          Background="{DynamicResource PanelBackgroundBrush}"
                          Foreground="{DynamicResource WindowForegroundBrush}"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="90"/>
                        <DataGridTextColumn Header="Head" Binding="{Binding Head}" Width="80"/>
                        <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled}" Width="50"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Surface Points">
                <DataGrid ItemsSource="{Binding SurfPoints}"
                          SelectedItem="{Binding Groundwater.SelectedSurfPoint, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          Background="{DynamicResource PanelBackgroundBrush}"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40"/>
                        <DataGridTextColumn Header="X (m)" Binding="{Binding AxisX}" Width="*"/>
                        <DataGridTextColumn Header="Y / Elevation (m)" Binding="{Binding Elevation}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
