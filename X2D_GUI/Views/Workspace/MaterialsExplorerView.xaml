<UserControl x:Class="GeotechSlopeApp.Views.Workspace.MaterialsExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GeotechSlopeApp.Converters"
             Background="{DynamicResource PanelBackgroundBrush}"
             Foreground="{DynamicResource WindowForegroundBrush}">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:StringToBrushConverter x:Key="GlyphBrushConverter" UseWindowForegroundFallback="True"/>
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0,4,8"/>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
    </UserControl.Resources>
    <DockPanel Visibility="{Binding IsExplorerExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel DockPanel.Dock="Top" Margin="10,10,10,8">
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right"
                        Width="22" Height="22" Padding="0"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Command="{Binding ToggleExplorerCommand}"
                        ToolTip="Collapse or expand Material Explorer">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Text="{Binding ExplorerChevronGlyph}"
                               Foreground="{DynamicResource WindowForegroundBrush}"/>
                </Button>
                <TextBlock Text="Material Explorer"
                           FontWeight="SemiBold"
                           FontSize="13"
                           VerticalAlignment="Center"/>
            </DockPanel>
            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6,4"
                     ToolTip="Search Materials..."
                     Visibility="{Binding IsExplorerExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource ChromeBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,8"
                Visibility="{Binding IsExplorerExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Material Summary" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding TotalCount, StringFormat=Total: {0}}" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding SoilCount, StringFormat=Soil: {0}}" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding RockCount, StringFormat=Rock: {0}}" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding StructuralCount, StringFormat=Structural: {0}}" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding InterfaceCount, StringFormat=Interface: {0}}" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding UnassignedCount, StringFormat=Unassigned layers: {0}}"/>
            </StackPanel>
        </Border>
        <TreeView ItemsSource="{Binding Roots}" SelectedItemChanged="OnSelectedItemChanged"
                  Visibility="{Binding IsExplorerExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <Button Padding="4,1"
                                FontSize="10"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                ToolTip="Click then click a surface on the canvas to assign this material"
                                Command="{Binding DataContext.Materials.AssignMaterialFromRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Payload}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎨 "
                                               FontSize="9"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="Assign"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </StackPanel>
                            </Button.Content>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}"
                                                        CornerRadius="2">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowAssignButton}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Payload.IsAssignTarget}" Value="True">
                                            <Setter Property="Background" Value="#FF86EFAC"/>
                                            <Setter Property="BorderBrush" Value="#FF16A34A"/>
                                            <Setter Property="Foreground" Value="#FF14532D"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Text="{Binding Glyph}"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding GlyphColor, Converter={StaticResource GlyphBrushConverter}}"/>
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="{Binding Title, Mode=OneWay}"/>
                            <Run Text="{Binding CountLabel, Mode=OneWay}"
                                 Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</UserControl>
