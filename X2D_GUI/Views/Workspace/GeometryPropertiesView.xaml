<UserControl x:Class="GeotechSlopeApp.Views.Workspace.GeometryPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GeotechSlopeApp.Converters"
             Background="{DynamicResource PanelBackgroundBrush}"
             Foreground="{DynamicResource WindowForegroundBrush}">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="PanelCollapseButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel Visibility="{Binding IsPropertiesExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Border DockPanel.Dock="Top" Padding="6,5">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource PanelCollapseButton}"
                        Command="{Binding TogglePropertiesCommand}"
                        ToolTip="Hide Properties">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Text="{Binding PropertiesChevronGlyph}"
                               Foreground="{DynamicResource WindowForegroundBrush}"/>
                </Button>
                <TextBlock Text="Properties"
                           FontWeight="SemiBold"
                           FontSize="13"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Padding="10,0,10,10">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="ID" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedPointId}" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1" Text="X" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPointX}" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="2" Text="Y" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedPointY}" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="3" Text="Z" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedPointZ}" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="4" Text="Description" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedPointDescription}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="5" Text="Type"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedPointType}"/>
                </Grid>

                <TextBlock Text="Display" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,8"/>
                <CheckBox Content="Show Label" IsChecked="{Binding ShowPointLabel}" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Label Size" Width="80" VerticalAlignment="Center"/>
                    <TextBox Width="60" Text="{Binding LabelSize, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Color" Width="80" VerticalAlignment="Center"/>
                    <TextBox Width="80" Text="{Binding PointColor, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Symbol" Width="80" VerticalAlignment="Center"/>
                    <TextBox Width="80" Text="{Binding PointSymbol, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Symbol Size" Width="80" VerticalAlignment="Center"/>
                    <TextBox Width="60" Text="{Binding SymbolSize, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <TextBlock Text="Coordinate System" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="System" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CoordinateSystem}" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1" Text="Units" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UnitsLabel}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="2" Text="Angle"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AngleLabel}"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
