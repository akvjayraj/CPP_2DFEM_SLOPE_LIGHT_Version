<Window x:Class="GeotechSlopeApp.Views.Workspace.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ws="clr-namespace:GeotechSlopeApp.Views.Workspace"
        Title="Preferences"
        Height="560" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="12,8" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ChromeBorderBrush}">
            <Button Content="Close" Width="88" HorizontalAlignment="Right" IsCancel="True" IsDefault="True"/>
        </Border>
        <ws:AppearanceOptionsView/>
    </DockPanel>
</Window>
