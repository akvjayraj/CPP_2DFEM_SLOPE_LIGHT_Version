<UserControl x:Class="GeotechSlopeApp.Views.Workspace.GroundwaterExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GeotechSlopeApp.Converters"
             xmlns:tabs="clr-namespace:GeotechSlopeApp.Views.Tabs"
             Background="{DynamicResource PanelBackgroundBrush}"
             Foreground="{DynamicResource WindowForegroundBrush}">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="PanelCollapseButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>
    </UserControl.Resources>
    <DockPanel Visibility="{Binding IsExplorerExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Border DockPanel.Dock="Top" Padding="10,10,10,8">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource PanelCollapseButton}"
                        Command="{Binding ToggleExplorerCommand}"
                        ToolTip="Collapse or expand Groundwater Explorer">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Text="{Binding ExplorerChevronGlyph}"
                               Foreground="{DynamicResource WindowForegroundBrush}"/>
                </Button>
                <TextBlock Text="GROUNDWATER EXPLORER"
                           FontWeight="SemiBold"
                           FontSize="13"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource ChromeBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,8"
                Visibility="{Binding IsSummaryExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding SummaryText}"
                       FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"/>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,0,8,8">
            <tabs:GroundwaterDetailsView DataContext="{Binding Groundwater}"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
