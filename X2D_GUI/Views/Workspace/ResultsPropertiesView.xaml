<UserControl x:Class="GeotechSlopeApp.Views.Workspace.ResultsPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GeotechSlopeApp.Converters"
             Background="{DynamicResource PanelBackgroundBrush}"
             Foreground="{DynamicResource WindowForegroundBrush}">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>
    </UserControl.Resources>
    <DockPanel Visibility="{Binding IsPropertiesExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
        <DockPanel DockPanel.Dock="Top" Margin="10,10,10,8">
            <Button DockPanel.Dock="Right"
                    Command="{Binding TogglePropertiesCommand}"
                    ToolTip="Hide Plot Options"
                    Width="22" Height="22" Padding="0"
                    Background="Transparent" BorderThickness="0">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE70E;"/>
            </Button>
            <TextBlock Text="PLOT OPTIONS" FontWeight="SemiBold" FontSize="13"/>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,10,10">
            <StackPanel>
                <TextBlock Text="Result Type" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <ComboBox Margin="0,2,0,8" ItemsSource="{Binding ResultTypeChoices}" SelectedItem="{Binding ResultTypeDisplay}"/>
                <TextBlock Text="Component" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <ComboBox Margin="0,2,0,8" ItemsSource="{Binding Components}" SelectedItem="{Binding ComponentDisplay}"/>
                <TextBlock Text="Display" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <ComboBox Margin="0,2,0,10" ItemsSource="{Binding DisplayModes}" SelectedItem="{Binding DisplayMode}"/>

                <CheckBox Content="Show Contour Lines" IsChecked="{Binding ShowContourLines}" Margin="0,0,0,8"/>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Number of Contours" VerticalAlignment="Center" Width="130"/>
                    <TextBox Text="{Binding ContourCount, UpdateSourceTrigger=PropertyChanged}" Width="56" HorizontalAlignment="Left"/>
                </DockPanel>
                <TextBlock Text="Range" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <CheckBox Content="Automatic" IsChecked="{Binding RangeAutomatic}" Margin="0,2,0,6"/>
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="Max" Width="36" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding RangeMaxText}" VerticalAlignment="Center"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Min" Width="36" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding RangeMinText}" VerticalAlignment="Center"/>
                </DockPanel>

                <CheckBox Content="Show Legend" IsChecked="{Binding Results.ShowContourLegend}" Margin="0,0,0,8"/>
                <TextBlock Text="Position" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <ComboBox Margin="0,2,0,8" ItemsSource="{Binding LegendPositions}" SelectedItem="{Binding LegendPosition}"/>
                <TextBlock Text="Contour Scheme" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <ComboBox Margin="0,2,0,10" ItemsSource="{Binding ContourSchemes}" SelectedItem="{Binding ContourScheme}"/>

                <CheckBox Content="Show Deformed Mesh" IsChecked="{Binding ShowDeformedMesh}" Margin="0,0,0,6"/>
                <CheckBox Content="Show Loads" IsChecked="{Binding ShowLoads}" Margin="0,0,0,6"/>
                <CheckBox Content="Show Supports" IsChecked="{Binding ShowSupports}" Margin="0,0,0,10"/>

                <TextBlock Text="Transparency" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding TransparencyPercent, StringFormat={}{0:0}%}" Width="40" VerticalAlignment="Center"/>
                    <Slider Minimum="0" Maximum="100" Value="{Binding TransparencyPercent}" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
