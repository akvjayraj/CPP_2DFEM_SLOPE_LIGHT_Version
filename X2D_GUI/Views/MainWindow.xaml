                    <GridSplitter Grid.Column="0" Width="4" HorizontalAlignment="Center"/>
                    <TabControl Grid.Column="1"
                                Visibility="{Binding IsResultsInspectorChrome, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Background="{DynamicResource PanelBackgroundBrush}">
                        <TabItem Header="Results">
                            <ws:ResultsCategoryPanelView/>
                        </TabItem>
                        <TabItem Header="Check">
                            <ws:CheckModelView/>
                        </TabItem>
                    </TabControl>
                    <ws:AnalysisToolsView Grid.Column="1"
                                          Visibility="{Binding IsAnalysisRibbonWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Grid Grid.Column="1"
                          Visibility="{Binding IsGeometryWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ws:GeometryPropertiesView DataContext="{Binding Workspace.Geometry}"/>
                    </Grid>
                    <Grid Grid.Column="1"
                          Visibility="{Binding IsMaterialsWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ws:MaterialsInspectorView DataContext="{Binding Workspace.Materials}"/>
                    </Grid>
                    <Grid Grid.Column="1"
                          Visibility="{Binding IsLoadsWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ws:LoadsInspectorView DataContext="{Binding Workspace.Loads}"/>
                    </Grid>
                    <Grid Grid.Column="1"
                          Visibility="{Binding IsResultsWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ws:ResultsPropertiesView DataContext="{Binding Workspace.Results}"/>
                    </Grid>
                </Grid>
            </Grid>
                </Grid>
            <StatusBar Grid.Row="2"
                       Background="{DynamicResource PanelBackgroundBrush}"
                       Foreground="{DynamicResource WindowForegroundBrush}"
                       Visibility="{Binding IsFileOrAnalysisChrome, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StatusBarItem Content="{Binding Workspace.StatusReady}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.StatusUnits}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.StatusStrip}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.StatusDimension}"/>
                <StatusBarItem Content="XYZ"/>
            </StatusBar>
            <StatusBar Grid.Row="2"
                       Background="{DynamicResource PanelBackgroundBrush}"
                       Foreground="{DynamicResource WindowForegroundBrush}"
                       Visibility="{Binding IsGeometryWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StatusBarItem Content="{Binding Workspace.Geometry.StatusReady}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.Geometry.StatusUnits}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.Geometry.StatusAnalysis}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.Geometry.StatusDimension}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.Geometry.StatusLastSaved}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.Geometry.StatusCursor}"/>
            </StatusBar>
            <StatusBar Grid.Row="2"
                       Background="{DynamicResource PanelBackgroundBrush}"
                       Foreground="{DynamicResource WindowForegroundBrush}"
                       Visibility="{Binding IsMaterialsWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StatusBarItem Content="{Binding Workspace.Materials.StatusReady}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.Materials.StatusUnits}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.Materials.StatusAnalysis}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.Materials.StatusDimension}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.Materials.StatusLastSaved}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.Materials.StatusCursor}"/>
            </StatusBar>
            <StatusBar Grid.Row="2"
                       Background="{DynamicResource PanelBackgroundBrush}"
                       Foreground="{DynamicResource WindowForegroundBrush}"
                       Visibility="{Binding IsMeshWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StatusBarItem Content="{Binding Workspace.Mesh.StatusReady}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.Mesh.StatusUnits}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.Mesh.StatusAnalysis}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.Mesh.StatusDimension}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.Mesh.StatusLastSaved}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.Mesh.StatusCursor}"/>
            </StatusBar>
            <StatusBar Grid.Row="2"
                       Background="{DynamicResource PanelBackgroundBrush}"
                       Foreground="{DynamicResource WindowForegroundBrush}"
                       Visibility="{Binding IsLoadsWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StatusBarItem Content="{Binding Workspace.Loads.StatusReady}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.Loads.StatusUnits}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.Loads.StatusAnalysis}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.Loads.StatusDimension}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.Loads.StatusLastSaved}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.Loads.StatusCursor}"/>
            </StatusBar>
            <StatusBar Grid.Row="2"
                       Background="{DynamicResource PanelBackgroundBrush}"
                       Foreground="{DynamicResource WindowForegroundBrush}"
                       Visibility="{Binding IsBoundaryWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StatusBarItem Content="{Binding Workspace.Boundary.StatusReady}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.Boundary.StatusUnits}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.Boundary.StatusAnalysis}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.Boundary.StatusDimension}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.Boundary.StatusLastSaved}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Workspace.Boundary.StatusCursor}"/>
            </StatusBar>
        </Grid>

        <!-- Footer: workspace tabs (projects) + stage tabs (staged excavation) -->
        <Border Grid.Row="2"
                BorderBrush="#FFCBD5E1"
                BorderThickness="0,1,0,0"
                Background="#FFF1F5F9">
            <Grid Margin="12,8,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row A: staged excavation stage tabs (above the project tabs) -->
                <TabControl x:Name="StageFooterTabsControl"
                            Grid.Row="0"
                            ItemsSource="{Binding ProjectSettingsVM.StageFooterTabs}"
                            SelectedIndex="{Binding ProjectSettingsVM.SelectedStageFooterTabIndex}"
                            SelectionChanged="StageFooterTabs_SelectionChanged"
                            Visibility="{Binding ShowStageFooterRow, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StageName}"/>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <Grid/>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>

                <!-- Row B: project workspace tabs (below the stage tabs) -->
                <TabControl x:Name="WorkspaceFooterTabsControl"
                            Grid.Row="1"
                            Margin="0,6,0,0"
                            ItemsSource="{Binding ProjectWorkspace.Slots}"
                            SelectedIndex="{Binding ProjectWorkspace.ActiveIndex, Mode=OneWay}"
                            SelectionChanged="WorkspaceFooterTabs_SelectionChanged"
                            Visibility="{Binding ProjectWorkspace.Slots.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="8,4">
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Content="×"
                                        Width="20"
                                        Height="20"
                                        Padding="0"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Click="CloseWorkspaceTab_OnClick"
                                        Tag="{Binding}"
                                        Cursor="Hand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="Gray"
                                        ToolTip="Close Project">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Foreground" Value="Gray"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                    <Setter Property="Background" Value="#FFE0E0E0"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <Grid/>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</Window>
