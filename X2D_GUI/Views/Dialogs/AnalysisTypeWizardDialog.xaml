<Window x:Class="GeotechSlopeApp.Views.Dialogs.AnalysisTypeWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:GeotechSlopeApp.Converters"
        xmlns:dialogs="clr-namespace:GeotechSlopeApp.Views.Dialogs"
        Title="{Binding StepTitle}"
        Width="980" Height="640"
        MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolVis"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ViewportPaperBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ViewportPaperBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
        </Style>
        <Style x:Key="OptionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="OptionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="OptionRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="GatedNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="OptionPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ViewportPaperBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="OptionPanelFill" TargetType="Border" BasedOn="{StaticResource OptionPanel}">
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style x:Key="WizardButton" TargetType="Button">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ViewportPaperBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="PrimaryWizardButton" TargetType="Button" BasedOn="{StaticResource WizardButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <SolidColorBrush x:Key="SoilBrush" Color="#B8956A"/>
        <SolidColorBrush x:Key="HydroRingBrush" Color="#16A34A"/>
        <SolidColorBrush x:Key="ThermalBulbBrush" Color="#DC2626"/>

        <Style x:Key="StepCircle" TargetType="Border">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StepCircleCurrent" TargetType="Border" BasedOn="{StaticResource StepCircle}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style x:Key="StepNumber" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StepNumberCurrent" TargetType="TextBlock" BasedOn="{StaticResource StepNumber}">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="StepCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StepCaptionCurrent" TargetType="TextBlock" BasedOn="{StaticResource StepCaption}">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <DataTemplate x:Key="IconStatic">
            <Canvas Width="88" Height="56">
                <Rectangle Canvas.Left="14" Canvas.Top="30" Width="60" Height="18" Fill="{StaticResource SoilBrush}" RadiusX="2" RadiusY="2"/>
                <Polygon Points="24,8 30,8 30,20 34,20 27,28 20,20 24,20" Fill="{DynamicResource AccentBrush}"/>
                <Polygon Points="41,4 47,4 47,16 51,16 44,24 37,16 41,16" Fill="{DynamicResource AccentBrush}"/>
                <Polygon Points="58,8 64,8 64,20 68,20 61,28 54,20 58,20" Fill="{DynamicResource AccentBrush}"/>
            </Canvas>
        </DataTemplate>
        <DataTemplate x:Key="IconSeepage">
            <Canvas Width="88" Height="56">
                <Polygon Points="8,46 8,28 38,18 80,18 80,46" Fill="{StaticResource SoilBrush}"/>
                <Path Data="M8,28 C20,20 28,12 38,18" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Fill="Transparent"/>
                <Ellipse Canvas.Left="4" Canvas.Top="8" Width="28" Height="16" Fill="{DynamicResource AccentBrush}" Opacity="0.85"/>
                <Path Data="M18,22 C22,28 26,32 32,36" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                <Path Data="M12,24 C16,30 20,36 28,40" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                <Polygon Points="30,38 34,34 32,40" Fill="{DynamicResource AccentBrush}"/>
            </Canvas>
        </DataTemplate>
        <DataTemplate x:Key="IconConsolidation">
            <Canvas Width="88" Height="56">
                <Rectangle Canvas.Left="16" Canvas.Top="18" Width="56" Height="28" Fill="{StaticResource SoilBrush}" RadiusX="2" RadiusY="2"/>
                <Line X1="28" Y1="18" X2="28" Y2="46" Stroke="{DynamicResource WindowForegroundBrush}" StrokeThickness="1" StrokeDashArray="2,2"/>
                <Line X1="44" Y1="18" X2="44" Y2="46" Stroke="{DynamicResource WindowForegroundBrush}" StrokeThickness="1" StrokeDashArray="2,2"/>
                <Line X1="60" Y1="18" X2="60" Y2="46" Stroke="{DynamicResource WindowForegroundBrush}" StrokeThickness="1" StrokeDashArray="2,2"/>
                <Polygon Points="26,8 30,8 30,14 33,14 28,20 23,14 26,14" Fill="{DynamicResource AccentBrush}"/>
                <Polygon Points="42,6 46,6 46,12 49,12 44,18 39,12 42,12" Fill="{DynamicResource AccentBrush}"/>
                <Polygon Points="58,8 62,8 62,14 65,14 60,20 55,14 58,14" Fill="{DynamicResource AccentBrush}"/>
                <Ellipse Canvas.Left="64" Canvas.Top="34" Width="16" Height="16" Fill="{DynamicResource ViewportPaperBrush}"
                         Stroke="{DynamicResource WindowForegroundBrush}" StrokeThickness="1.2"/>
                <Line X1="72" Y1="42" X2="72" Y2="36" Stroke="{DynamicResource WindowForegroundBrush}" StrokeThickness="1.2"/>
                <Line X1="72" Y1="42" X2="76" Y2="44" Stroke="{DynamicResource WindowForegroundBrush}" StrokeThickness="1.2"/>
            </Canvas>
        </DataTemplate>
        <DataTemplate x:Key="IconDynamic">
            <Canvas Width="88" Height="56">
                <Polyline Points="6,32 16,32 22,12 28,44 36,20 44,38 52,16 60,36 68,28 82,28"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2" Fill="Transparent"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
        </DataTemplate>
        <DataTemplate x:Key="IconThermal">
            <Canvas Width="88" Height="56">
                <Rectangle Canvas.Left="18" Canvas.Top="32" Width="52" Height="16" Fill="{StaticResource SoilBrush}" RadiusX="2" RadiusY="2"/>
                <Rectangle Canvas.Left="40" Canvas.Top="6" Width="8" Height="28" Fill="{DynamicResource WindowForegroundBrush}" RadiusX="3" RadiusY="3"/>
                <Rectangle Canvas.Left="42" Canvas.Top="10" Width="4" Height="20" Fill="{StaticResource ThermalBulbBrush}"/>
                <Ellipse Canvas.Left="36" Canvas.Top="28" Width="16" Height="16" Fill="{StaticResource ThermalBulbBrush}"/>
            </Canvas>
        </DataTemplate>
        <DataTemplate x:Key="IconCoupled">
            <Canvas Width="88" Height="56">
                <Ellipse Canvas.Left="14" Canvas.Top="8" Width="28" Height="28" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.4" Fill="Transparent"/>
                <Ellipse Canvas.Left="32" Canvas.Top="8" Width="28" Height="28" Stroke="{StaticResource HydroRingBrush}" StrokeThickness="2.4" Fill="Transparent"/>
                <Ellipse Canvas.Left="23" Canvas.Top="22" Width="28" Height="28" Stroke="#DC2626" StrokeThickness="2.4" Fill="Transparent"/>
                <TextBlock Canvas.Left="22" Canvas.Top="14" Text="T" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Canvas.Left="54" Canvas.Top="14" Text="H" FontSize="9" FontWeight="Bold" Foreground="{StaticResource HydroRingBrush}"/>
                <TextBlock Canvas.Left="38" Canvas.Top="36" Text="M" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource WindowForegroundBrush}"/>
            </Canvas>
        </DataTemplate>
        <DataTemplate x:Key="IconSrf">
            <Canvas Width="88" Height="56">
                <Polygon Points="6,46 6,28 36,14 82,14 82,46" Fill="{StaticResource SoilBrush}"/>
                <Path Data="M18,40 A28,18 0 0 1 70,18" Stroke="{DynamicResource WindowForegroundBrush}"
                      StrokeThickness="1.4" StrokeDashArray="3,2" Fill="Transparent"/>
            </Canvas>
        </DataTemplate>
        <DataTemplate x:Key="IconStages">
            <Canvas Width="88" Height="56">
                <Line X1="8" Y1="46" X2="80" Y2="46" Stroke="{StaticResource SoilBrush}" StrokeThickness="4"/>
                <Rectangle Canvas.Left="28" Canvas.Top="28" Width="22" Height="12" Fill="{DynamicResource AccentBrush}" RadiusX="2" RadiusY="2"/>
                <Rectangle Canvas.Left="42" Canvas.Top="20" Width="12" Height="10" Fill="{DynamicResource WindowForegroundBrush}" RadiusX="1" RadiusY="1"/>
                <Ellipse Canvas.Left="28" Canvas.Top="38" Width="8" Height="8" Fill="{DynamicResource WindowForegroundBrush}"/>
                <Ellipse Canvas.Left="44" Canvas.Top="38" Width="8" Height="8" Fill="{DynamicResource WindowForegroundBrush}"/>
                <Line X1="50" Y1="24" X2="64" Y2="16" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2"/>
                <Polygon Points="64,16 74,18 70,24" Fill="{DynamicResource AccentBrush}"/>
            </Canvas>
        </DataTemplate>

        <dialogs:AnalysisTypeCardIconSelector x:Key="CardIconSelector"
                                              StaticTemplate="{StaticResource IconStatic}"
                                              SeepageTemplate="{StaticResource IconSeepage}"
                                              ConsolidationTemplate="{StaticResource IconConsolidation}"
                                              DynamicTemplate="{StaticResource IconDynamic}"
                                              ThermalTemplate="{StaticResource IconThermal}"
                                              CoupledTemplate="{StaticResource IconCoupled}"
                                              SrfTemplate="{StaticResource IconSrf}"
                                              StagesTemplate="{StaticResource IconStages}"/>
        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ViewportPaperBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
        </Style>
        <Style x:Key="TypeCard" TargetType="RadioButton">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{DynamicResource ViewportPaperBrush}"
                                BorderBrush="{DynamicResource ChromeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ExplorerSelectionBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="18,10,18,4">
            <StackPanel>
                <TextBlock Text="{Binding StepTitle}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StepSubtitle}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,6"/>
                <Grid Height="48" Margin="0,2,0,0">
                    <Line X1="44" Y1="11" X2="0" Y2="11"
                          Stretch="Fill" Stroke="{DynamicResource ChromeBorderBrush}" StrokeThickness="1"
                          Margin="44,0,44,0" VerticalAlignment="Top"/>
                    <UniformGrid Rows="1" Columns="5">
                        <StackPanel>
                            <Border Style="{StaticResource StepCircleCurrent}"
                                    Visibility="{Binding IsStepSelectType, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="1" Style="{StaticResource StepNumberCurrent}"/>
                            </Border>
                            <Border Style="{StaticResource StepCircle}"
                                    Visibility="{Binding IsStepSelectType, Converter={StaticResource InvBoolVis}}">
                                <TextBlock Text="1" Style="{StaticResource StepNumber}"/>
                            </Border>
                            <TextBlock Text="Select Type"
                                       Style="{StaticResource StepCaptionCurrent}"
                                       Visibility="{Binding IsStepSelectType, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="Select Type"
                                       Style="{StaticResource StepCaption}"
                                       Visibility="{Binding IsStepSelectType, Converter={StaticResource InvBoolVis}}"/>
                        </StackPanel>
                        <StackPanel>
                            <Border Style="{StaticResource StepCircleCurrent}"
                                    Visibility="{Binding IsStepDefineOptions, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="2" Style="{StaticResource StepNumberCurrent}"/>
                            </Border>
                            <Border Style="{StaticResource StepCircle}"
                                    Visibility="{Binding IsStepDefineOptions, Converter={StaticResource InvBoolVis}}">
                                <TextBlock Text="2" Style="{StaticResource StepNumber}"/>
                            </Border>
                            <TextBlock Text="Define Options"
                                       Style="{StaticResource StepCaptionCurrent}"
                                       Visibility="{Binding IsStepDefineOptions, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="Define Options"
                                       Style="{StaticResource StepCaption}"
                                       Visibility="{Binding IsStepDefineOptions, Converter={StaticResource InvBoolVis}}"/>
                        </StackPanel>
                        <StackPanel>
                            <Border Style="{StaticResource StepCircleCurrent}"
                                    Visibility="{Binding IsStepStageSettings, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="3" Style="{StaticResource StepNumberCurrent}"/>
                            </Border>
                            <Border Style="{StaticResource StepCircle}"
                                    Visibility="{Binding IsStepStageSettings, Converter={StaticResource InvBoolVis}}">
                                <TextBlock Text="3" Style="{StaticResource StepNumber}"/>
                            </Border>
                            <TextBlock Text="Stage Settings"
                                       Style="{StaticResource StepCaptionCurrent}"
                                       Visibility="{Binding IsStepStageSettings, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="Stage Settings"
                                       Style="{StaticResource StepCaption}"
                                       Visibility="{Binding IsStepStageSettings, Converter={StaticResource InvBoolVis}}"/>
                        </StackPanel>
                        <StackPanel>
                            <Border Style="{StaticResource StepCircleCurrent}"
                                    Visibility="{Binding IsStepSolverSettings, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="4" Style="{StaticResource StepNumberCurrent}"/>
                            </Border>
                            <Border Style="{StaticResource StepCircle}"
                                    Visibility="{Binding IsStepSolverSettings, Converter={StaticResource InvBoolVis}}">
                                <TextBlock Text="4" Style="{StaticResource StepNumber}"/>
                            </Border>
                            <TextBlock Text="Solver Settings"
                                       Style="{StaticResource StepCaptionCurrent}"
                                       Visibility="{Binding IsStepSolverSettings, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="Solver Settings"
                                       Style="{StaticResource StepCaption}"
                                       Visibility="{Binding IsStepSolverSettings, Converter={StaticResource InvBoolVis}}"/>
                        </StackPanel>
                        <StackPanel>
                            <Border Style="{StaticResource StepCircleCurrent}"
                                    Visibility="{Binding IsStepReview, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="5" Style="{StaticResource StepNumberCurrent}"/>
                            </Border>
                            <Border Style="{StaticResource StepCircle}"
                                    Visibility="{Binding IsStepReview, Converter={StaticResource InvBoolVis}}">
                                <TextBlock Text="5" Style="{StaticResource StepNumber}"/>
                            </Border>
                            <TextBlock Text="Review &amp; Confirm"
                                       Style="{StaticResource StepCaptionCurrent}"
                                       Visibility="{Binding IsStepReview, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="Review &amp; Confirm"
                                       Style="{StaticResource StepCaption}"
                                       Visibility="{Binding IsStepReview, Converter={StaticResource InvBoolVis}}"/>
                        </StackPanel>
                    </UniformGrid>
                </Grid>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource ChromeBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="&lt; Back"
                            Style="{StaticResource WizardButton}"
                            Command="{Binding BackCommand}"
                            IsEnabled="{Binding CanGoBack}"/>
                    <Button Content="{Binding NextLabel}"
                            Style="{StaticResource PrimaryWizardButton}"
                            Command="{Binding NextCommand}"/>
                    <Button Content="Cancel"
                            Style="{StaticResource WizardButton}"
                            Command="{Binding CancelCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding InfoBarText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding StatusBarText}"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   FontSize="11"
                   Margin="18,0,18,6"/>

        <Grid Margin="8,2">
                <!-- Step 1 -->
                <ItemsControl ItemsSource="{Binding Cards}"
                              Visibility="{Binding IsStepSelectType, Converter={StaticResource BoolVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="2" Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource TypeCard}"
                                         GroupName="AnalysisTypeCards"
                                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                                         Command="{Binding DataContext.SelectCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding}">
                                <StackPanel>
                                    <RadioButton IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 IsHitTestVisible="False"
                                                 GroupName="AnalysisTypeCardDots"
                                                 HorizontalAlignment="Left"/>
                                    <ContentControl Content="{Binding}"
                                                    ContentTemplateSelector="{StaticResource CardIconSelector}"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,8,0,8"/>
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"/>
                                    <TextBlock Text="{Binding Description}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="4,6,4,0"/>
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <dialogs:AnalysisTypeDefineOptionsHostView
                    Visibility="{Binding ShowTypedDefineOptions, Converter={StaticResource BoolVis}}"/>

                <!-- Step 2 Define Options: equal 4x2 cells that fill the remaining dialog. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding ShowGenericDefineOptions, Converter={StaticResource BoolVis}}">
                <UniformGrid Rows="4" Columns="2"
                             MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                    <Border Style="{StaticResource OptionPanelFill}">
                        <StackPanel>
                            <TextBlock Text="1. Constitutive / Material Behavior" Style="{StaticResource OptionHeader}"/>
                            <Grid Style="{StaticResource OptionRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Analysis Type" Style="{StaticResource OptionLabel}"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding PhysicsTypeChoices}"
                                          SelectedItem="{Binding PendingIntentDisplayName, Mode=OneWay}"/>
                            </Grid>
                            <Grid Style="{StaticResource OptionRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Formulation" Style="{StaticResource OptionLabel}"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding FormulationChoices}"
                                          SelectedItem="{Binding SelectedFormulation}"/>
                            </Grid>
                            <CheckBox Content="Large Deformation" IsChecked="{Binding IncludeLargeDeformation}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OptionPanelFill}">
                        <StackPanel>
                                <TextBlock Text="2. Loading" Style="{StaticResource OptionHeader}"/>
                                <Grid Style="{StaticResource OptionRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Loading Type" Style="{StaticResource OptionLabel}"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding GatedLoadingTypes}"
                                              SelectedItem="{Binding GatedLoadingType}"/>
                                </Grid>
                                <Grid Style="{StaticResource OptionRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Content="Apply Gravity" IsChecked="{Binding FEAnalysisVM.GravityEnabled}"/>
                                    <TextBlock Grid.Column="1" Text="Dir" Style="{StaticResource OptionLabel}" Margin="8,0,6,0"/>
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding GatedGravityDirections}"
                                              SelectedItem="{Binding GatedGravityDirection}"/>
                                </Grid>
                                <Grid Style="{StaticResource OptionRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Gravity (m/s²)" Style="{StaticResource OptionLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding FEAnalysisVM.GravityAcceleration}"/>
                                </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OptionPanelFill}">
                        <StackPanel>
                                <TextBlock Text="3. Nonlinearity" Style="{StaticResource OptionHeader}"/>
                                <CheckBox Content="{Binding MaterialNonlinearityLabel, StringFormat=Material Nonlinearity: {0}}"
                                          IsChecked="{Binding IncludeMaterialNonlinearity}"/>
                                <Grid Style="{StaticResource OptionRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Content="Geometric Nonlinearity" IsChecked="{Binding IncludeGeometricNonlinearity}"/>
                                    <CheckBox Grid.Column="1" Content="Contact Nonlinearity" IsChecked="{Binding IncludeContactNonlinearity}"/>
                                </Grid>
                                <Grid Style="{StaticResource OptionRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tangent Stiffness Update" Style="{StaticResource OptionLabel}"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding GatedTangentStiffness}"
                                              SelectedItem="{Binding GatedTangentStiffnessValue}"/>
                                </Grid>
                                <Grid Style="{StaticResource OptionRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Convergence Option" Style="{StaticResource OptionLabel}"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding GatedConvergenceOptions}"
                                              SelectedItem="{Binding GatedConvergenceOption}"/>
                                </Grid>
                                <Grid Style="{StaticResource OptionRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tolerance" Style="{StaticResource OptionLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding FEAnalysisVM.ConvergenceToleranceText}"/>
                                    <CheckBox Grid.Column="2" Content="Steps" Margin="8,0,6,0"
                                              IsChecked="{Binding FEAnalysisVM.LoadSteppingEnabled}"/>
                                    <TextBox Grid.Column="3" Text="{Binding FEAnalysisVM.NumberOfLoadSteps}"/>
                                </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OptionPanelFill}">
                        <StackPanel>
                                <TextBlock Text="4. Initial Stress" Style="{StaticResource OptionHeader}"/>
                                <Grid Style="{StaticResource OptionRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Content="Generate Initial Stress"
                                              IsChecked="{Binding GenerateInitialStress}"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding InitialStressMethodChoices}"
                                              SelectedItem="{Binding SelectedInitialStressMethod}"/>
                                </Grid>
                                <Grid Style="{StaticResource OptionRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="K₀ Method" Style="{StaticResource OptionLabel}"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding GatedK0Methods}"
                                              SelectedItem="{Binding GatedK0Method}"/>
                                </Grid>
                                <Grid Style="{StaticResource OptionRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="K₀ / Kz" Style="{StaticResource OptionLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding LoadConditionsVM.FieldStress.Global.Kx}"/>
                                    <TextBlock Grid.Column="2" Text="Kz" Style="{StaticResource OptionLabel}" Margin="8,0,6,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding LoadConditionsVM.FieldStress.Global.Kz}"/>
                                </Grid>
                                <CheckBox Content="Use Pore Pressure" IsChecked="{Binding GroundwaterVM.IsEnabled}"/>
                                <Grid Style="{StaticResource OptionRow}"
                                      Visibility="{Binding IsSrfPending, Converter={StaticResource BoolVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SRF in-situ" Style="{StaticResource OptionLabel}"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding FEAnalysisVM.SrfInsituModeChoices}"
                                              SelectedItem="{Binding FEAnalysisVM.SelectedSrfInsituMode}"/>
                                </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OptionPanelFill}">
                        <StackPanel>
                                <TextBlock Text="5. Damping (Optional)" Style="{StaticResource OptionHeader}"/>
                                <Grid Style="{StaticResource OptionRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Damping Type" Style="{StaticResource OptionLabel}"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding GatedDampingTypes}"
                                              SelectedItem="{Binding GatedDampingType}"/>
                                </Grid>
                                <Grid Style="{StaticResource OptionRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Damping Ratio" Style="{StaticResource OptionLabel}"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding GatedDampingRatios}"
                                              SelectedItem="{Binding GatedDampingRatio}"/>
                                </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OptionPanelFill}">
                        <StackPanel>
                                <TextBlock Text="6. Boundary Condition Behavior" Style="{StaticResource OptionHeader}"/>
                                <Grid Style="{StaticResource OptionRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Incompatible Modes" Style="{StaticResource OptionLabel}"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding GatedIncompatibleModes}"
                                              SelectedItem="{Binding GatedIncompatibleMode}"/>
                                </Grid>
                                <Grid Style="{StaticResource OptionRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Boundary Stiffness" Style="{StaticResource OptionLabel}"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding GatedBoundaryStiffness}"
                                              SelectedItem="{Binding GatedBoundaryStiffnessValue}"/>
                                </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OptionPanelFill}">
                        <StackPanel>
                                <TextBlock Text="7. Coupling (Optional)" Style="{StaticResource OptionHeader}"/>
                                <Grid Style="{StaticResource OptionRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Content="Couple with Seepage"
                                              IsChecked="{Binding GroundwaterVM.IsEnabled}"/>
                                    <CheckBox Grid.Column="1" Content="Thermal Effects" IsChecked="{Binding IncludeTemperatureEffect}"/>
                                </Grid>
                                <CheckBox Content="Pore Pressure Coupling"
                                          IsChecked="{Binding Workspace.Settings.UpdatePorePressure}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OptionPanelFill}">
                        <StackPanel>
                                <TextBlock Text="8. Advanced Options" Style="{StaticResource OptionHeader}"/>
                                <Grid Style="{StaticResource OptionRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Stress Recovery" Style="{StaticResource OptionLabel}"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding GatedStressRecovery}"
                                              SelectedItem="{Binding GatedStressRecoveryValue}"/>
                                </Grid>
                                <Grid Style="{StaticResource OptionRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Stiffness / Line" Style="{StaticResource OptionLabel}"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding GatedStiffnessMatrix}"
                                              SelectedItem="{Binding GatedStiffnessMatrixValue}"/>
                                    <TextBlock Grid.Column="2" Text="Search" Style="{StaticResource OptionLabel}" Margin="8,0,6,0"/>
                                    <ComboBox Grid.Column="3"
                                              ItemsSource="{Binding GatedLineSearch}"
                                              SelectedItem="{Binding GatedLineSearchValue}"/>
                                </Grid>
                                <Grid Style="{StaticResource OptionRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Boundary Stiffness" Style="{StaticResource OptionLabel}"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding GatedBoundaryStiffness}"
                                              SelectedItem="{Binding GatedBoundaryStiffnessValue}"/>
                                </Grid>
                                <Grid Style="{StaticResource OptionRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Max Iters / Incr" Style="{StaticResource OptionLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding FEAnalysisVM.MaxIterations}"/>
                                    <TextBlock Grid.Column="2" Text="Incr" Style="{StaticResource OptionLabel}" Margin="8,0,6,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding FEAnalysisVM.LoadIncrements}"/>
                                </Grid>
                                <CheckBox Content="Automatic Time Stepping" IsChecked="{Binding AutomaticTimeStepping}"/>
                                <StackPanel Visibility="{Binding IsConsolidationPending, Converter={StaticResource BoolVis}}">
                                    <Grid Style="{StaticResource OptionRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="48"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Time Step / N" Style="{StaticResource OptionLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding ProjectSettingsVM.TransientSettings.TimeStep}"/>
                                        <TextBlock Grid.Column="2" Text="N" Style="{StaticResource OptionLabel}" Margin="8,0,6,0"/>
                                        <TextBox Grid.Column="3" Text="{Binding ProjectSettingsVM.TransientSettings.NumberOfSteps}"/>
                                    </Grid>
                                </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                </ScrollViewer>

                <!-- Step 3 Stage Construction -->
                <DockPanel Visibility="{Binding IsStepStageSettings, Converter={StaticResource BoolVis}}">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button Content="+ Add Stage" Style="{StaticResource ToolbarBtn}" Command="{Binding AddStageCommand}"/>
                        <Button Content="Insert" Style="{StaticResource ToolbarBtn}" Command="{Binding InsertStageCommand}"/>
                        <Button Content="Delete" Style="{StaticResource ToolbarBtn}" Command="{Binding RemoveStageCommand}"/>
                        <Button Content="Duplicate" Style="{StaticResource ToolbarBtn}" Command="{Binding DuplicateStageCommand}"/>
                        <Button Content="Import Sequence" Style="{StaticResource ToolbarBtn}" Command="{Binding ImportSequenceCommand}"/>
                        <Button Content="▲ Up" Style="{StaticResource ToolbarBtn}" Command="{Binding MoveStageUpCommand}"/>
                        <Button Content="▼ Down" Style="{StaticResource ToolbarBtn}" Command="{Binding MoveStageDownCommand}"/>
                    </WrapPanel>
                    <Grid DockPanel.Dock="Bottom" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource OptionPanel}" Margin="0,0,3,0">
                            <StackPanel>
                                <TextBlock Text="Stage Details" Style="{StaticResource OptionHeader}"/>
                                <Grid Style="{StaticResource OptionRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Type" Style="{StaticResource OptionLabel}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding StageTypeOptions}"
                                              SelectedItem="{Binding SelectedStage.StageType}"
                                              IsEnabled="{Binding HasSelectedStage}"/>
                                </Grid>
                                <Grid Style="{StaticResource OptionRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/><ColumnDefinition Width="70"/><ColumnDefinition Width="50"/><ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Duration" Style="{StaticResource OptionLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding SelectedStage.Duration}"/>
                                    <TextBox Grid.Column="2" Margin="4,0,0,0" Text="{Binding SelectedStage.Units}"/>
                                    <TextBox Grid.Column="3" Margin="6,0,0,0" Text="{Binding SelectedStage.LoadFactor}"/>
                                </Grid>
                                <TextBlock Text="Activate / Deactivate surfaces" Style="{StaticResource OptionLabel}"/>
                                <ItemsControl ItemsSource="{Binding SurfaceRows}" MaxHeight="72">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Display}" IsChecked="{Binding IsActive, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox MinHeight="48" MaxHeight="56" TextWrapping="Wrap" AcceptsReturn="True"
                                         Text="{Binding SelectedStage.Notes}"/>
                                <WrapPanel Margin="0,4,0,0">
                                    <Button Content="Supports" Style="{StaticResource ToolbarBtn}"
                                            Command="{Binding SelectComponentTabCommand}" CommandParameter="Supports"/>
                                    <Button Content="Loads" Style="{StaticResource ToolbarBtn}"
                                            Command="{Binding SelectComponentTabCommand}" CommandParameter="Loads"/>
                                    <Button Content="Boundary" Style="{StaticResource ToolbarBtn}"
                                            Command="{Binding SelectComponentTabCommand}" CommandParameter="Boundary"/>
                                    <Button Content="Materials" Style="{StaticResource ToolbarBtn}"
                                            Command="{Binding SelectComponentTabCommand}" CommandParameter="Materials"/>
                                </WrapPanel>
                                <StackPanel Visibility="{Binding IsSupportsTab, Converter={StaticResource BoolVis}}">
                                    <CheckBox Content="Lining" IsChecked="{Binding SelectedStage.LiningEnabled}"/>
                                    <CheckBox Content="Bolts" IsChecked="{Binding SelectedStage.BoltsEnabled}"/>
                                    <TextBlock Text="Install Support is incomplete in this engine." Style="{StaticResource GatedNote}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding LoadsStageHint}" Style="{StaticResource GatedNote}" TextWrapping="Wrap"
                                           Visibility="{Binding IsLoadsTab, Converter={StaticResource BoolVis}}"/>
                                <TextBlock Text="{Binding BoundaryStageHint}" Style="{StaticResource GatedNote}" TextWrapping="Wrap"
                                           Visibility="{Binding IsBoundaryTab, Converter={StaticResource BoolVis}}"/>
                                <TextBlock Text="{Binding MaterialsStageHint}" Style="{StaticResource GatedNote}" TextWrapping="Wrap"
                                           Visibility="{Binding IsMaterialsTab, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource OptionPanel}" Margin="3,0">
                            <StackPanel>
                                <TextBlock Text="Surfaces" Style="{StaticResource OptionHeader}"/>
                                <ItemsControl ItemsSource="{Binding SurfaceRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Display}" IsChecked="{Binding IsActive, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource OptionPanel}" Margin="3,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Description" Style="{StaticResource OptionHeader}"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                                           Text="Stages are solved in order and are cumulative."/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,6,0,0"
                                           Text="Preview uses the main 2D view."/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <DataGrid ItemsSource="{Binding StageDefinitions}"
                              SelectedItem="{Binding SelectedStage, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              Background="{DynamicResource PanelBackgroundBrush}"
                              Foreground="{DynamicResource WindowForegroundBrush}"
                              RowBackground="{DynamicResource PanelBackgroundBrush}"
                              AlternatingRowBackground="{DynamicResource ViewportPaperBrush}"
                              BorderBrush="{DynamicResource ChromeBorderBrush}"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Stage #" Binding="{Binding StageNumber}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Stage Name" Binding="{Binding StageName, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridComboBoxColumn Header="Type"
                                                    SelectedItemBinding="{Binding StageType, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="160">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                        <Setter Property="ItemsSource" Value="{Binding DataContext.StageTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                        <Setter Property="ItemsSource" Value="{Binding DataContext.StageTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                            <DataGridTextColumn Header="Duration" Binding="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <DataGridTextColumn Header="Time Factor" Binding="{Binding LoadFactor, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Width="56"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- Step 4 Solver -->
                <StackPanel Visibility="{Binding IsStepSolverSettings, Converter={StaticResource BoolVis}}" Margin="8">
                    <TextBlock Text="Solver Settings" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="Tolerance" Style="{StaticResource OptionLabel}"/>
                        <TextBox Width="120" Text="{Binding FEAnalysisVM.ConvergenceToleranceText}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="Max Iterations" Style="{StaticResource OptionLabel}"/>
                        <TextBox Width="120" Text="{Binding FEAnalysisVM.MaxIterations}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="Load increments" Style="{StaticResource OptionLabel}"/>
                        <TextBox Width="120" Text="{Binding FEAnalysisVM.LoadIncrements}"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding HasSelectedStage, Converter={StaticResource BoolVis}}" Margin="0,12,0,0">
                        <TextBlock Text="Selected stage" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Stage tolerance" Style="{StaticResource OptionLabel}"/>
                            <TextBox Width="120" Text="{Binding SelectedStage.Tolerance}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Stage max iters" Style="{StaticResource OptionLabel}"/>
                            <TextBox Width="120" Text="{Binding SelectedStage.MaxIterations}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsSrfPending, Converter={StaticResource BoolVis}}" Margin="0,12,0,0">
                        <TextBlock Text="Strength reduction" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Initial RF" Style="{StaticResource OptionLabel}"/>
                            <TextBox Width="120" Text="{Binding Workspace.Settings.InitialStrengthReductionFactor}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Increment" Style="{StaticResource OptionLabel}"/>
                            <TextBox Width="120" Text="{Binding Workspace.Settings.StrengthReductionIncrement}"/>
                        </StackPanel>
                        <ComboBox Width="200" HorizontalAlignment="Left"
                                  ItemsSource="{Binding Workspace.SsrTypeChoices}"
                                  SelectedItem="{Binding Workspace.Settings.SsrType}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Step 5 Review -->
                <StackPanel Visibility="{Binding IsStepReview, Converter={StaticResource BoolVis}}" Margin="8">
                    <TextBlock Text="Review &amp; Confirm" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding ReviewSummary}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding CapabilityBanner}"
                               Foreground="#B45309"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Visibility="{Binding HasCapabilityBanner, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
        </Grid>
    </DockPanel>
</Window>
