<Window x:Class="GeotechSlopeApp.Views.Dialogs.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GeotechSlopeApp.ViewModels"
        Title="User Manual"
        Width="1120" Height="780"
        WindowStartupLocation="CenterOwner"
        MinWidth="760" MinHeight="480">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <HierarchicalDataTemplate DataType="{x:Type vm:HelpTopicNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Title}" Padding="1,3" TextTrimming="CharacterEllipsis" />
        </HierarchicalDataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Command bar -->
        <Border DockPanel.Dock="Top" Background="#FFF8FAFC"
                BorderBrush="#FFE2E8F0" BorderThickness="0,0,0,1" Padding="10,7">
            <DockPanel>
                <Button Content="&#x25C0;" Width="30" Margin="0,0,4,0" FontSize="11"
                        ToolTip="Back" Command="{Binding BackCommand}" />
                <Button Content="&#x25B6;" Width="30" Margin="0,0,10,0" FontSize="11"
                        ToolTip="Forward" Command="{Binding ForwardCommand}" />
                <Button Content="Contents" Width="76" Margin="0,0,12,0"
                        ToolTip="Back to the first page of the manual" Command="{Binding HomeCommand}" />
                <TextBlock Text="{Binding Breadcrumb}" VerticalAlignment="Center"
                           Foreground="#FF64748B" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#FFE2E8F0" BorderThickness="0,1,0,0" Padding="10,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" Width="90" IsCancel="True"
                        Click="Close_Click" />
                <TextBlock VerticalAlignment="Center" Foreground="#FF64748B"
                           Text="Press F1 in the main window for help on the tab you are working in." />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="284" MinWidth="190" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Contents and search -->
            <DockPanel Grid.Column="0" Background="#FFFCFDFE">
                <Border DockPanel.Dock="Top" Padding="10,9,10,8"
                        BorderBrush="#FFE2E8F0" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBox x:Name="SearchBox" Padding="6,4,52,4"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search the manual" />
                        <TextBlock Text="Search" IsHitTestVisible="False" Margin="9,0,0,0"
                                   VerticalAlignment="Center" Foreground="#FF94A3B8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="Clear" Width="44" Height="21" HorizontalAlignment="Right"
                                Margin="0,0,4,0" Padding="0" FontSize="11"
                                Command="{Binding ClearSearchCommand}"
                                Visibility="{Binding IsSearchActive, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>

                <TreeView x:Name="ContentsTree"
                          ItemsSource="{Binding Nodes}"
                          BorderThickness="0"
                          Background="Transparent"
                          SelectedItemChanged="ContentsTree_SelectedItemChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.Style>
                        <Style TargetType="TreeView">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearchActive}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.Style>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>

                <ListBox x:Name="SearchResultsList"
                         ItemsSource="{Binding SearchResults}"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         SelectionChanged="SearchResultsList_SelectionChanged"
                         Visibility="{Binding IsSearchActive, Converter={StaticResource BoolToVis}}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4,6,6">
                                <TextBlock Text="{Binding Topic.Title}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Snippet}" Foreground="#FF64748B"
                                           FontSize="11" TextWrapping="Wrap" MaxHeight="48" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="#FFE2E8F0" ResizeBehavior="PreviousAndNext" />

            <FlowDocumentScrollViewer x:Name="Viewer" Grid.Column="2"
                                      Document="{Binding Document}"
                                      IsToolBarVisible="False"
                                      Background="White"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto" />
        </Grid>
    </DockPanel>
</Window>
