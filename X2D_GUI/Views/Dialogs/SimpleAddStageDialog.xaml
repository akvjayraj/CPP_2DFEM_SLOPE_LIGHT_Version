<Window x:Class="GeotechSlopeApp.Views.Dialogs.SimpleAddStageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Stage" 
        Height="250" 
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Enter stage number and name"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16"
                   TextWrapping="Wrap"/>
        
        <GroupBox Header="Stage Settings" Grid.Row="1" Margin="0,0,0,16">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Stage Number:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Grid.Column="0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableStageNumbers}"
                          SelectedItem="{Binding SelectedStageNumber}"
                          Height="28"
                          Margin="0,0,16,0"/>
                <TextBlock Text="Stage Name:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Grid.Column="2"/>
                <TextBox Grid.Column="3"
                         Text="{Binding StageName, UpdateSourceTrigger=PropertyChanged}"
                         Height="28"
                         Margin="0,0,8,0"
                         ToolTip="Name for this stage"/>
                <Button Grid.Column="4"
                        Content="Add"
                        Command="{Binding AddStageCommand}"
                        Width="80"
                        Height="28"
                        IsEnabled="{Binding CanExecute}"
                        ToolTip="Add this stage"/>
            </Grid>
        </GroupBox>
        
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Click="CancelButton_Click"
                    Width="100"
                    Height="32"
                    Margin="0,0,8,0"/>
            <Button Content="Close"
                    Click="CloseButton_Click"
                    Width="100"
                    Height="32"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
