                            </Grid.ColumnDefinitions>
                            <TextBlock Text="K0 / Kx" Style="{StaticResource OptionLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding LoadConditionsVM.FieldStress.Global.Kx}"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource OptionPanelFill}">
                    <StackPanel>
                        <TextBlock Text="Description" Style="{StaticResource OptionHeader}"/>
                        <TextBlock Style="{StaticResource DescCol}" Text="Fully coupled Biot is not available. Live paths are seepage→SRF and prescribed-u→SRF."/>
                        <TextBlock Style="{StaticResource DescCol}" Text="{Binding CapabilityBanner}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- SSR: 5 boxes + Description -->
            <UniformGrid Columns="3"
                         Visibility="{Binding ShowSrfDefineOptions, Converter={StaticResource BoolVis}}"
                         MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <Border Style="{StaticResource OptionPanelFill}">
                    <StackPanel>
                        <TextBlock Text="1. Strength Reduction Method" Style="{StaticResource OptionHeader}"/>
                        <Grid Style="{StaticResource OptionRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Method" Style="{StaticResource OptionLabel}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Workspace.MethodChoices}" SelectedItem="{Binding Workspace.Settings.Method}"/>
                        </Grid>
                        <Grid Style="{StaticResource OptionRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SSR Type" Style="{StaticResource OptionLabel}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Workspace.SsrTypeChoices}" SelectedItem="{Binding Workspace.Settings.SsrType}"/>
                        </Grid>
                        <CheckBox Content="Non-convergence" IsChecked="{Binding Workspace.Settings.CheckNonConvergence}"/>
                        <CheckBox Content="Displacement Divergence" IsChecked="{Binding Workspace.Settings.CheckDisplacementJump}"/>
                        <Grid Style="{StaticResource OptionRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Initial RF" Style="{StaticResource OptionLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding Workspace.Settings.InitialStrengthReductionFactor}"/>
                        </Grid>
                        <Grid Style="{StaticResource OptionRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Increment" Style="{StaticResource OptionLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding Workspace.Settings.StrengthReductionIncrement}"/>
                        </Grid>
                        <Grid Style="{StaticResource OptionRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="F min / max" Style="{StaticResource OptionLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox Width="56" Text="{Binding FEAnalysisVM.SrfFoSMin}"/>
                                <TextBox Width="56" Margin="6,0,0,0" Text="{Binding FEAnalysisVM.SrfFoSMax}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource OptionPanelFill}">
                    <StackPanel>
                        <TextBlock Text="2. Convergence Controls" Style="{StaticResource OptionHeader}"/>
                        <Grid Style="{StaticResource OptionRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tolerance" Style="{StaticResource OptionLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding FEAnalysisVM.ConvergenceToleranceText}"/>
                        </Grid>
                        <Grid Style="{StaticResource OptionRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Max Iters" Style="{StaticResource OptionLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding FEAnalysisVM.MaxIterations}"/>
                        </Grid>
                        <Grid Style="{StaticResource OptionRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Load incr." Style="{StaticResource OptionLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding FEAnalysisVM.LoadIncrements}"/>
                        </Grid>
                        <CheckBox Content="Load stepping" IsChecked="{Binding FEAnalysisVM.LoadSteppingEnabled}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource OptionPanelFill}">
                    <StackPanel>
                        <TextBlock Text="3. Analysis Options" Style="{StaticResource OptionHeader}"/>
                        <Grid Style="{StaticResource OptionRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Analysis Type" Style="{StaticResource OptionLabel}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding PhysicsTypeChoices}" SelectedItem="{Binding PendingIntentDisplayName, Mode=OneWay}"/>
                        </Grid>
                        <ComboBox ItemsSource="{Binding PorePressureChoices}" SelectedItem="{Binding Workspace.Settings.PorePressureOption}"/>
                        <CheckBox Content="Use Pore Pressure" IsChecked="{Binding GroundwaterVM.IsEnabled}"/>
                        <CheckBox Content="Include Gravity" IsChecked="{Binding FEAnalysisVM.GravityEnabled}"/>
                        <TextBox Text="{Binding FEAnalysisVM.GravityAcceleration}"/>
                        <CheckBox Content="Include Temperature Effect" IsChecked="{Binding IncludeTemperatureEffect}"/>
                        <CheckBox Content="Large Deformation" IsChecked="{Binding IncludeLargeDeformation}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource OptionPanelFill}">
                    <StackPanel>
                        <TextBlock Text="4. Failure Criterion" Style="{StaticResource OptionHeader}"/>
                        <TextBlock Text="{Binding MaterialNonlinearityLabel}"/>
                        <ComboBox ItemsSource="{Binding FEAnalysisVM.SrfInsituModeChoices}" SelectedItem="{Binding FEAnalysisVM.SelectedSrfInsituMode}"/>
                        <CheckBox Content="Tension cutoff" IsChecked="{Binding TensionCutoff}"/>
                        <CheckBox Content="Shear Strain Limit" IsChecked="{Binding Workspace.Settings.CheckPlasticZoneConnect}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource OptionPanelFill}">
                    <StackPanel>
                        <TextBlock Text="5. Output Controls" Style="{StaticResource OptionHeader}"/>
                        <CheckBox Content="Strength Reduction Factor" IsChecked="{Binding OutputSrf}"/>
                        <CheckBox Content="Displacement" IsChecked="{Binding OutputSrfDisplacement}"/>
                        <CheckBox Content="Plastic Zone" IsChecked="{Binding OutputPlasticZone}"/>
                        <TextBlock Text="Preview uses the main 2D view." Style="{StaticResource GatedNote}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource OptionPanelFill}">
                    <StackPanel>
                        <TextBlock Text="Description" Style="{StaticResource OptionHeader}"/>
                        <TextBlock Style="{StaticResource DescCol}" Text="SSR reduces strength until non-convergence. Bracket bounds and increment write the existing FE / workspace SRF settings."/>
                        <TextBlock Style="{StaticResource DescCol}" Text="{Binding CapabilityBanner}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Grid>
    </ScrollViewer>
</UserControl>
