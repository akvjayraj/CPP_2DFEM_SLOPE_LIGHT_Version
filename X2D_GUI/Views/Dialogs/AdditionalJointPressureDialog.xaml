<Window x:Class="GeotechSlopeApp.Views.Dialogs.AdditionalJointPressureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Additional Pressure"
        Width="320" Height="150"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="Additional pressure (kPa)" Margin="0,0,0,6"/>
            <TextBox x:Name="PressureBox"/>
        </StackPanel>
    </DockPanel>
</Window>
