<Window x:Class="GeotechSlopeApp.Views.Dialogs.MaterialLibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Material Library — Built-in Presets"
        Width="820" Height="560"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: search -->
        <DockPanel Grid.Row="0">
            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="FilterBox" Width="200" Height="26"
                     VerticalContentAlignment="Center" Padding="4,0"
                     TextChanged="FilterBox_TextChanged"/>
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#666" FontStyle="Italic"
                       Text="Select one or more presets and click 'Add to Project' to import them."/>
        </DockPanel>

        <!-- Material grid -->
        <DataGrid x:Name="LibraryGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F8F8F8"
                  FontSize="12"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Colour" Width="50" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="24" Height="16" CornerRadius="2"
                                    Background="{Binding ColourBrush}" Margin="4,2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Name"             Binding="{Binding Name}"          Width="160"/>
                <DataGridTextColumn Header="E (kPa)"          Binding="{Binding YoungsModulus, StringFormat=N0}"  Width="90"/>
                <DataGridTextColumn Header="ν"                Binding="{Binding PoissonsRatio,  StringFormat=F3}"  Width="55"/>
                <DataGridTextColumn Header="γ (kN/m³)"        Binding="{Binding UnitWeight,     StringFormat=F1}"  Width="75"/>
                <DataGridTextColumn Header="c (kPa)"          Binding="{Binding Cohesion,       StringFormat=F0}"  Width="65"/>
                <DataGridTextColumn Header="φ (°)"            Binding="{Binding FrictionAngle,  StringFormat=F1}"  Width="55"/>
                <DataGridTextColumn Header="Criterion"        Binding="{Binding FailureCriterion}"  Width="110"/>
                <DataGridTextColumn Header="Description"      Binding="{Binding Description}"   Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Add to Project" Width="130" Height="28"
                    IsDefault="True" Click="AddToProjectButton_Click" Margin="0,0,8,0"/>
            <Button Content="Close" Width="80" Height="28"
                    IsCancel="True" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
