<Window x:Class="GeotechSlopeApp.Views.Dialogs.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GeotechSlopeApp - Sign in"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        FocusManager.FocusedElement="{Binding ElementName=UsernameTextBox}">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#FF334155"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFE2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
    </Window.Resources>
    <Border Background="#FFF8FAFC" Padding="18">
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="GeotechSlopeApp"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#FF0F172A"/>
                <TextBlock x:Name="SubtitleTextBlock"
                           Text="Locked-license build"
                           FontSize="12"
                           Foreground="#FF64748B"
                           Margin="0,2,0,16"/>

                <TextBlock Text="Username" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="UsernameTextBox"
                         Height="30"
                         Padding="6,4"
                         FontSize="13"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Password" Style="{StaticResource LabelStyle}"/>
                <PasswordBox x:Name="PasswordBox"
                             Height="30"
                             Padding="6,4"
                             FontSize="13"
                             Margin="0,0,0,12"/>

                <TextBlock x:Name="StatusTextBlock"
                           Text=""
                           Foreground="#FFB91C1C"
                           FontSize="12"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Button x:Name="ExitButton"
                            Content="Exit"
                            Width="92"
                            Height="32"
                            Margin="0,0,8,0"
                            Click="ExitButton_Click"
                            IsCancel="True"/>
                    <Button x:Name="LoginButton"
                            Content="Sign in"
                            Width="92"
                            Height="32"
                            Click="LoginButton_Click"
                            IsDefault="True"
                            Background="#FF2563EB"
                            Foreground="White"
                            BorderBrush="#FF1D4ED8"/>
                </StackPanel>

                <TextBlock x:Name="FooterTextBlock"
                           Text=""
                           FontSize="11"
                           Foreground="#FF94A3B8"
                           Margin="0,16,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Border>
</Window>
