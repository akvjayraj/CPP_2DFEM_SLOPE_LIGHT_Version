<Window x:Class="GeotechSlopeApp.Views.Dialogs.AddStageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:GeotechSlopeApp.Models"
        Title="Add Stage" 
        Height="750" 
        Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Select shapes from Geometry Definition and Excavation Operations, then assign a stage number"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16"
                   TextWrapping="Wrap"/>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <GroupBox Header="Available Shapes" Grid.Column="0" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Select surfaces (S1, S2...) or result regions (A-B, A+B):"
                               FontSize="11"
                               Foreground="#FF475569"
                               Margin="8,8,8,4"/>
                    <ListBox x:Name="AvailableShapesListBox"
                             Grid.Row="1"
                             ItemsSource="{Binding AvailableShapes}"
                             SelectionMode="Extended"
                             Margin="8,0,8,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName, Mode=OneWay}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>
            
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                <Button Content="&gt;&gt;"
                        Width="40"
                        Height="30"
                        Margin="0,4"
                        ToolTip="Add selected shapes"
                        Click="AddSelectedShapes_Click"/>
                <Button Content="&lt;&lt;"
                        Width="40"
                        Height="30"
                        Margin="0,4"
                        ToolTip="Remove selected shapes"
                        Click="RemoveSelectedShapes_Click"/>
            </StackPanel>
            
            <GroupBox Header="Selected Shapes" Grid.Column="2" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Shapes to add to stage:"
                               FontSize="11"
                               Foreground="#FF475569"
                               Margin="8,8,8,4"/>
                    <ListBox x:Name="SelectedShapesListBox"
                             Grid.Row="1"
                             ItemsSource="{Binding SelectedShapes}"
                             Margin="8,0,8,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName, Mode=OneWay}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>
        </Grid>
        
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <GroupBox Header="Stage Settings" Margin="0,0,0,12">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Stage Number:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Grid.Column="0"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableStageNumbers}"
                              SelectedItem="{Binding SelectedStageNumber}"
                              Height="28"
                              Margin="0,0,16,0"/>
                    <TextBlock Text="Stage Name:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Grid.Column="2"/>
                    <TextBox Grid.Column="3"
                             Text="{Binding StageName, UpdateSourceTrigger=PropertyChanged}"
                             Height="28"
                             ToolTip="Name for this stage"/>
                </Grid>
            </GroupBox>
        </StackPanel>

        <GroupBox Header="Existing Stages" Grid.Row="3" Margin="0,0,0,12">
            <DataGrid ItemsSource="{Binding ExistingStages}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      Margin="8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Stage Number"
                                        Binding="{Binding StageNumber}"
                                        Width="100"/>
                    <DataGridTextColumn Header="Stage Name"
                                        Binding="{Binding StageName}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Shape Count"
                                        Binding="{Binding ShapeCount}"
                                        Width="100"/>
                    <DataGridTextColumn Header="Shapes"
                                        Binding="{Binding ShapesSummary}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Click="CancelButton_Click"
                    Width="100"
                    Height="32"
                    Margin="0,0,8,0"/>
            <Button Content="Add Stage"
                    Click="AddStageButton_Click"
                    Width="100"
                    Height="32"
                    IsEnabled="{Binding CanExecute}"
                    Margin="0,0,8,0"/>
            <Button Content="Finish"
                    Click="FinishButton_Click"
                    Width="100"
                    Height="32"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
