<Window x:Class="GeotechSlopeApp.Views.Dialogs.AssignMaterialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign Material to Layer"
        Width="420" Height="280"
        MinWidth="360" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Layer" Style="{StaticResource Label}" Margin="0,0,0,4"/>
            <ComboBox x:Name="LayerComboBox"
                      DisplayMemberPath="LayerPickerDisplay"
                      FontSize="13" Height="28"/>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Material" Style="{StaticResource Label}" Margin="0,0,0,4"/>
            <ComboBox x:Name="MaterialComboBox"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      FontSize="13" Height="28"/>
        </StackPanel>

        <TextBlock x:Name="CurrentAssignmentText" Grid.Row="4"
                   FontSize="12" Foreground="#555" FontStyle="Italic"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" Width="80" IsDefault="True"
                    Click="OkButton_Click" Margin="0,0,8,0"/>
            <Button Content="Cancel" Width="80" IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
