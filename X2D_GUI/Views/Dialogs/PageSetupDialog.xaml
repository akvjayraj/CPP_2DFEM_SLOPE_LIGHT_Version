<Window x:Class="GeotechSlopeApp.Views.Dialogs.PageSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Page Setup"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Orientation" Margin="0,0,0,12">
            <ComboBox x:Name="OrientationCombo" MinWidth="200" Margin="8"/>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="Margins (mm)" Margin="0,0,0,12">
            <UniformGrid Columns="4" Margin="8">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Left"/>
                    <TextBox x:Name="MarginLeftBox"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Right"/>
                    <TextBox x:Name="MarginRightBox"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Top"/>
                    <TextBox x:Name="MarginTopBox"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Bottom"/>
                    <TextBox x:Name="MarginBottomBox"/>
                </StackPanel>
            </UniformGrid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Scale" Margin="0,0,0,12">
            <StackPanel Margin="8">
                <RadioButton x:Name="FitToPageRadio" Content="Fit to page" Margin="0,0,0,4"/>
                <RadioButton x:Name="ActualSizeRadio" Content="100% (actual size)"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Header / Footer" Margin="0,0,0,12">
            <StackPanel Margin="8">
                <CheckBox x:Name="ShowHeaderCheck" Content="Print header" Margin="0,0,0,4"/>
                <TextBox x:Name="HeaderFormatBox" Margin="0,0,0,8"/>
                <CheckBox x:Name="ShowFooterCheck" Content="Print footer" Margin="0,0,0,4"/>
                <TextBox x:Name="FooterFormatBox"/>
                <TextBlock Text="Tokens: {ProjectName}, {TabName}, {Date}"
                           Margin="0,8,0,0"
                           Foreground="#FF64748B"
                           FontSize="11"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OnOkClick"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
