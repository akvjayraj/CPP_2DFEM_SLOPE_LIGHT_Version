<Window x:Class="GeotechSlopeApp.Views.Dialogs.BooleanOperationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:GeotechSlopeApp.Converters"
        Title="Surface boolean / Excavate" 
        Height="600" 
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Pick two regions (A and B), or multiple regions with the same Union / Subtract / Intersect operation. Each Execute adds a new row; history is not overwritten."
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton Content="Two regions (A and B)"
                             GroupName="BooleanMode"
                             IsChecked="{Binding IsMultiRegionMode, Converter={StaticResource InverseBooleanConverter}, Mode=TwoWay}"
                             Margin="0,0,16,0"
                             VerticalAlignment="Center"/>
                <RadioButton Content="Multiple regions"
                             GroupName="BooleanMode"
                             IsChecked="{Binding IsMultiRegionMode, Mode=TwoWay}"
                             VerticalAlignment="Center"/>
            </StackPanel>

            <GroupBox Header="Operation type" Margin="0,0,0,12">
                <ComboBox Margin="8"
                          ItemsSource="{Binding OperationTypeChoices}"
                          SelectedItem="{Binding SelectedOperationType}"
                          Height="28"/>
            </GroupBox>

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="380">
                <StackPanel>
                    <StackPanel Visibility="{Binding IsMultiRegionMode, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                        <GroupBox Header="Region A (Primary)" Margin="0,0,0,12">
                            <StackPanel Margin="8">
                                <TextBlock Text="Region A:" 
                                           FontSize="11"
                                           Foreground="#FF475569"
                                           Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding AvailableRegions}"
                                          SelectedItem="{Binding SelectedRegionA}"
                                          DisplayMemberPath="RegionName"
                                          Height="28"
                                          Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding RegionADescription}"
                                           Foreground="#FF475569"
                                           TextWrapping="Wrap"
                                           FontSize="11"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Region B (Secondary)" Margin="0,0,0,12">
                            <StackPanel Margin="8">
                                <TextBlock Text="Region B:" 
                                           FontSize="11"
                                           Foreground="#FF475569"
                                           Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding AvailableRegions}"
                                          SelectedItem="{Binding SelectedRegionB}"
                                          DisplayMemberPath="RegionName"
                                          Height="28"
                                          Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding RegionBDescription}"
                                           Foreground="#FF475569"
                                           TextWrapping="Wrap"
                                           FontSize="11"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <GroupBox Header="Regions"
                              Margin="0,0,0,12"
                              Visibility="{Binding IsMultiRegionMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Margin="8">
                            <TextBlock Text="{Binding MultiRegionHelpText}"
                                       Foreground="#FF475569"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding MultiRegionItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Margin="0,3"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Result Settings">
                        <StackPanel Margin="8">
                            <TextBlock Text="Result Region Name:" 
                                       FontSize="11"
                                       Foreground="#FF475569"
                                       Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ResultRegionName, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28"
                                     Margin="0,0,0,8"
                                     ToolTip="Name for the resulting region"/>
                            <CheckBox Content="Preserve attributes from Region A"
                                      IsChecked="{Binding PreserveAttributes}"
                                      Margin="0,8,0,0"
                                      Visibility="{Binding IsMultiRegionMode, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
        
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Cancel"
                    Click="CancelButton_Click"
                    Width="100"
                    Height="32"
                    Margin="0,0,8,0"/>
            <Button Content="Execute"
                    Click="ExecuteButton_Click"
                    Width="100"
                    Height="32"
                    IsDefault="True"
                    IsEnabled="{Binding CanExecute}"/>
        </StackPanel>
    </Grid>
</Window>
