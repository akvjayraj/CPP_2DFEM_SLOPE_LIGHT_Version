<Window x:Class="GeotechSlopeApp.Views.Dialogs.FieldStationImportWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Evidence Pack"
        Width="640" Height="520"
        MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <DockPanel Background="#FFF8FAFC" LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#FFE2E8F0" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel>
                <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="14" Foreground="#FF1D4ED8"/>
                <TextBlock Text="{Binding StatusText}" Foreground="#FF64748B" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#FFE2E8F0" BorderThickness="0,1,0,0" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="88" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="Import" Width="88" IsDefault="True" Click="ImportButton_Click"/>
            </StackPanel>
        </Border>

        <ScrollViewer Padding="14" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Proprietary Evidence Pack CSV only (not gINT, AGS, GEO5, or Slide)."
                           Foreground="#FF64748B" Margin="0,0,0,10" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton Content="Elevations (Top Y / Bottom Y)"
                                 IsChecked="{Binding UseElevations, Mode=TwoWay}"
                                 Margin="0,0,16,0"/>
                    <RadioButton Content="Depths (Collar Y − Depth)"
                                 IsChecked="{Binding UseDepth, Mode=TwoWay}"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Station Id" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,16,8"
                              ItemsSource="{Binding ColumnChoices}"
                              SelectedItem="{Binding StationColumn, Mode=TwoWay}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="X" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox Grid.Row="0" Grid.Column="3" Margin="0,0,0,8"
                              ItemsSource="{Binding ColumnChoices}"
                              SelectedItem="{Binding XColumn, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Unit code" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,16,8"
                              ItemsSource="{Binding ColumnChoices}"
                              SelectedItem="{Binding UnitColumn, Mode=TwoWay}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Label" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,8"
                              ItemsSource="{Binding ColumnChoices}"
                              SelectedItem="{Binding LabelColumn, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Top Y" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,16,8"
                              ItemsSource="{Binding ColumnChoices}"
                              SelectedItem="{Binding TopYColumn, Mode=TwoWay}"
                              IsEnabled="{Binding UseElevations}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Bottom Y" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox Grid.Row="2" Grid.Column="3" Margin="0,0,0,8"
                              ItemsSource="{Binding ColumnChoices}"
                              SelectedItem="{Binding BottomYColumn, Mode=TwoWay}"
                              IsEnabled="{Binding UseElevations}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Collar Y" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,0,16,8"
                              ItemsSource="{Binding ColumnChoices}"
                              SelectedItem="{Binding CollarYColumn, Mode=TwoWay}"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Depth" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox Grid.Row="3" Grid.Column="3" Margin="0,0,0,8"
                              ItemsSource="{Binding ColumnChoices}"
                              SelectedItem="{Binding DepthColumn, Mode=TwoWay}"
                              IsEnabled="{Binding UseDepth}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Note" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,0,16,8"
                              ItemsSource="{Binding ColumnChoices}"
                              SelectedItem="{Binding NoteColumn, Mode=TwoWay}"/>
                </Grid>

                <TextBlock Text="Preview (first 3 rows)" FontWeight="SemiBold" Margin="0,12,0,6"/>
                <ItemsControl ItemsSource="{Binding PreviewLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                                       Foreground="#FF334155" Margin="0,0,0,2" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
