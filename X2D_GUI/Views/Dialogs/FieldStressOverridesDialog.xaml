<Window x:Class="GeotechSlopeApp.Views.Dialogs.FieldStressOverridesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:GeotechSlopeApp.Converters"
        Title="Field Stress — Per-Material Overrides"
        Width="780" Height="640"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolVis"/>
        <converters:NullToVisibilityConverter    x:Key="NullVis"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground"        Value="#FF475569"/>
            <Setter Property="Margin"            Value="0,2"/>
            <Setter Property="Width"             Value="130"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="3,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Global traction groups (n_traction_groups + per-group edges) loaded from .dat.
             Visible when the global mode is Traction (the dedicated traction-block editor)
             or whenever a traction-group list is present (so the dialog still shows them when
             the user has switched modes for inspection). Traction groups are a property of
             the elastic .dat traction block, not per-material overrides. -->
        <Expander Grid.Row="0"
                  Header="Traction groups (.dat n_traction_groups)"
                  IsExpanded="True"
                  Margin="0,0,0,8"
                  Background="#FFF8FAFC"
                  BorderBrush="#FFCBD5E1"
                  BorderThickness="1"
                  Visibility="{Binding IsTractionMode, Converter={StaticResource BoolVis}}">
            <Border Padding="8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Number of traction groups: " FontWeight="SemiBold"
                                   Foreground="#FF334155" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TractionGroupCount}"
                                   Foreground="#FF334155" VerticalAlignment="Center"/>
                        <Button Content="Add group" Padding="6,2" Margin="12,0,0,0"
                                Command="{Binding AddTractionGroupCommand}"
                                ToolTip="Append a new traction group seeded with the global Direct-tensor stresses."/>
                    </StackPanel>
                    <TextBlock Text="Edge count: number of loaded edges. Edge rows: node IDs defining each loaded boundary edge. Edits round-trip to the .dat on Execute Script."
                               FontSize="11" Foreground="#FF64748B"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>

                    <ItemsControl ItemsSource="{Binding TractionGroups}" MaxHeight="320">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#FFE2E8F0" BorderThickness="1"
                                        CornerRadius="3" Padding="6" Margin="0,0,0,6"
                                        Background="White">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Group" FontWeight="SemiBold"
                                                       Foreground="#FF334155" VerticalAlignment="Center"/>
                                            <TextBlock Text=" — mode " Foreground="#FF475569"
                                                       VerticalAlignment="Center"/>
                                            <TextBox Width="40" VerticalAlignment="Center"
                                                     Text="{Binding Mode, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="0 = direct (sxx,syy,sxy), 1 = far-field (sigma_v,K0)"/>
                                            <Button Content="Remove group" Padding="6,2" Margin="12,0,0,0"
                                                    Command="{Binding DataContext.RemoveTractionGroupCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="σxx:" VerticalAlignment="Center" Foreground="#FF475569"/>
                                            <TextBox   Grid.Column="1" Margin="2,0,8,0"
                                                       Text="{Binding Sxx, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Column="2" Text="σyy:" VerticalAlignment="Center" Foreground="#FF475569"/>
                                            <TextBox   Grid.Column="3" Margin="2,0,8,0"
                                                       Text="{Binding Syy, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Column="4" Text="τxy:" VerticalAlignment="Center" Foreground="#FF475569"/>
                                            <TextBox   Grid.Column="5" Margin="2,0,0,0"
                                                       Text="{Binding Txy, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                            <TextBlock Text="Edge count: " Foreground="#FF334155"/>
                                            <TextBlock Text="{Binding Edges.Count}" Foreground="#FF334155"/>
                                            <Button Content="Add edge" Padding="6,2" Margin="12,0,0,0"
                                                    Command="{Binding DataContext.AddTractionEdgeCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                        <DataGrid ItemsSource="{Binding Edges}"
                                                  SelectedItem="{Binding DataContext.SelectedTractionEdge,
                                                                         RelativeSource={RelativeSource AncestorType=Window},
                                                                         Mode=TwoWay}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  MaxHeight="160"
                                                  Margin="0,2,0,0"
                                                  ToolTip="Click a row to highlight its A→B (and optional mid-edge C) edge on the Load Conditions canvas.">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Node A" Width="80"
                                                                    Binding="{Binding NodeA, UpdateSourceTrigger=PropertyChanged}"/>
                                                <DataGridTextColumn Header="Node B" Width="80"
                                                                    Binding="{Binding NodeB, UpdateSourceTrigger=PropertyChanged}"/>
                                                <DataGridTextColumn Header="Node C (T6/Q8 mid-edge, 0=none)" Width="*"
                                                                    Binding="{Binding NodeC, UpdateSourceTrigger=PropertyChanged}"/>
                                                <DataGridTemplateColumn Header="" Width="80">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="Remove" Padding="4,1"
                                                                    Command="{Binding DataContext.RemoveTractionEdgeCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Expander>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: overrides list -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Add"    Width="60" Margin="0,0,6,0"
                            Command="{Binding AddOverrideCommand}"
                            ToolTip="Add a new per-material override using the first available material."/>
                    <Button Content="Remove" Width="70"
                            Command="{Binding RemoveOverrideCommand}"
                            CommandParameter="{Binding SelectedOverride}"
                            ToolTip="Remove the selected override."/>
                </StackPanel>
                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3">
                    <ListBox ItemsSource="{Binding Overrides}"
                             SelectedItem="{Binding SelectedOverride, Mode=TwoWay}"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="Mat "/>
                                    <Run Text="{Binding MaterialIndex, Mode=OneWay}"/>
                                    <Run Text=" — "/>
                                    <Run Text="{Binding MaterialName, Mode=OneWay}"/>
                                    <Run Text=" ("/>
                                    <Run Text="{Binding Spec.Mode, Mode=OneWay}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Right: override editor -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding SelectedOverride, Converter={StaticResource NullVis}, ConverterParameter=Inverse}">
                <TextBlock Text="Select a material override on the left to edit it, or click Add to create one."
                           Foreground="#FF94A3B8" TextWrapping="Wrap" VerticalAlignment="Top" Margin="8"/>
            </ScrollViewer>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding SelectedOverride, Converter={StaticResource NullVis}}">
                <StackPanel Margin="8,0,0,0" DataContext="{Binding SelectedOverride}">

                    <!-- Material picker -->
                    <TextBlock Text="Material" FontWeight="SemiBold" Foreground="#FF334155" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Material:"/>
                        <ComboBox x:Name="MaterialComboBox"
                                  ItemsSource="{Binding DataContext.MaterialsSource, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Name"
                                  Width="160"
                                  SelectionChanged="OnMaterialComboBoxSelectionChanged"/>
                    </StackPanel>

                    <!-- Mode selector -->
                    <TextBlock Text="Mode" FontWeight="SemiBold" Foreground="#FF334155" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton Content="Gravity"
                                     IsChecked="{Binding IsGravityModeSelected, Mode=TwoWay}"
                                     GroupName="OvMode" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <RadioButton Content="Constant"
                                     IsChecked="{Binding IsConstantModeSelected, Mode=TwoWay}"
                                     GroupName="OvMode" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <RadioButton Content="Direct tensor"
                                     IsChecked="{Binding IsDirectModeSelected, Mode=TwoWay}"
                                     GroupName="OvMode" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Gravity params -->
                    <StackPanel Visibility="{Binding IsGravityMode, Converter={StaticResource BoolVis}}"
                                Margin="0,0,0,10">
                        <TextBlock Text="Gravity parameters" FontWeight="SemiBold" Foreground="#FF334155" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Kx (σh / σv):"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"
                                       Text="{Binding Spec.Kx, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Kz (σZ / σv):"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"
                                       Text="{Binding Spec.Kz, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox  Grid.Row="2" Grid.ColumnSpan="2" Content="Auto free surface" Margin="0,4,0,2"
                                       IsChecked="{Binding Spec.AutoSurface, Mode=TwoWay}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="y surface (m):"
                                       Visibility="{Binding Spec.AutoSurface, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}"/>
                            <TextBox   Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}"
                                       Text="{Binding Spec.YSurface, UpdateSourceTrigger=PropertyChanged}"
                                       Visibility="{Binding Spec.AutoSurface, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}"/>
                            <CheckBox  Grid.Row="4" Grid.ColumnSpan="2" Content="Effective-stress ratio mode" Margin="0,2"
                                       IsChecked="{Binding Spec.UseEffectiveStressRatio, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Direct tensor params -->
                    <StackPanel Visibility="{Binding IsDirectMode, Converter={StaticResource BoolVis}}"
                                Margin="0,0,0,10">
                        <TextBlock Text="Direct traction tensor, mode=0 (kPa, tension positive)"
                                   FontWeight="SemiBold" Foreground="#FF334155" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="σxx (kPa):"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"
                                       Text="{Binding Spec.DirectSxx, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="σyy (kPa):"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"
                                       Text="{Binding Spec.DirectSyy, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="τxy (kPa):"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}"
                                       Text="{Binding Spec.DirectTxy, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Constant params -->
                    <StackPanel Visibility="{Binding IsConstantMode, Converter={StaticResource BoolVis}}"
                                Margin="0,0,0,10">
                        <TextBlock Text="Constant stress parameters (kPa, tension positive)"
                                   FontWeight="SemiBold" Foreground="#FF334155" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="σ1 major (kPa):"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"
                                       Text="{Binding Spec.Sigma1, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="σ3 minor (kPa):"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"
                                       Text="{Binding Spec.Sigma3, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="σZ out-of-plane:"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}"
                                       Text="{Binding Spec.SigmaZ, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="θ CCW from +x (°):"
                                       ToolTip="Angle of σ1 direction counter-clockwise from the +x axis."/>
                            <TextBox   Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}"
                                       Text="{Binding Spec.AngleDeg, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Close button -->
        <Button Grid.Row="2" Content="Close" Width="80" HorizontalAlignment="Right"
                Margin="0,10,0,0" Padding="0,4"
                Click="OnCloseClick"/>
    </Grid>
</Window>
