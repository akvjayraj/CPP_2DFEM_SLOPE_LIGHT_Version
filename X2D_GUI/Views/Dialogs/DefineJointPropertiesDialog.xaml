<Window x:Class="GeotechSlopeApp.Views.Dialogs.DefineJointPropertiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Define Joint Properties"
        Width="720" Height="540"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#FF475569"/>
            <Setter Property="Margin" Value="0,0,8,4"/>
        </Style>
    </Window.Resources>
    <DockPanel Background="#FFF8FAFC">
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#FFE2E8F0" BorderThickness="0,1,0,0" Padding="12,8">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Statistics..." Width="100" IsEnabled="False"
                        ToolTip="Joint statistics require a completed FE run."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="OK" Width="88" Margin="0,0,8,0" IsDefault="True" Command="{Binding OkCommand}"/>
                    <Button Content="Cancel" Width="88" IsCancel="True" Command="{Binding CancelCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" MinWidth="150"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBox DockPanel.Dock="Top" Margin="0,0,0,6"
                         Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding ShowFilter, Converter={StaticResource BoolVis}}"
                         ToolTip="Filter by name"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="+" Width="28" Command="{Binding AddCommand}" ToolTip="Add joint property"/>
                    <Button Content="−" Width="28" Margin="4,0,0,0" Command="{Binding DeleteCommand}" ToolTip="Delete"/>
                    <Button Content="⧉" Width="28" Margin="4,0,0,0" Command="{Binding DuplicateCommand}" ToolTip="Duplicate"/>
                    <Button Content="⏷" Width="28" Margin="4,0,0,0" Command="{Binding ToggleFilterCommand}" ToolTip="Filter list"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding FilteredSets}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="12" Height="12" Margin="0,0,6,0" BorderBrush="#FFCBD5E1" BorderThickness="1"
                                        Background="{Binding ColourBrush}"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent"/>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          DataContext="{Binding Selected}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                        <Border Grid.Column="2" Height="22" BorderBrush="#FFCBD5E1" BorderThickness="1"
                                Background="{Binding ColourBrush}"/>
                    </Grid>
                    <TextBlock Text="Color" FontSize="11" Foreground="#FF64748B" Margin="0,0,0,4"/>
                    <ListBox ItemsSource="{Binding DataContext.ColourPalette, RelativeSource={RelativeSource AncestorType=Window}}"
                             SelectedItem="{Binding Colour, Mode=TwoWay}"
                             Height="36" Margin="0,0,0,10">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="16" Height="16" Margin="2" BorderBrush="#FF94A3B8" BorderThickness="1">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding}"/>
                                    </Border.Background>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <GroupBox Header="Slip Criterion" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Criterion" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                                      ItemsSource="{Binding DataContext.Criteria, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding Criterion, Mode=TwoWay}"/>
                            <TextBlock Grid.Row="1" Text="Tensile strength (kPa)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                                     Text="{Binding TensileStrengthKpa, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="2" Text="Peak cohesion (kPa)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"
                                     Text="{Binding PeakCohesionKpa, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="3" Text="Peak friction angle (deg)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,6"
                                     Text="{Binding PeakFrictionDeg, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox Grid.Row="4" Grid.ColumnSpan="2" Content="Residual strength"
                                      IsChecked="{Binding UseResidualStrength, Mode=TwoWay}" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="5" Text="Res. tensile (kPa)" Style="{StaticResource FieldLabel}"
                                       IsEnabled="{Binding UseResidualStrength}"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,4"
                                     Text="{Binding ResidualTensileStrengthKpa, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding UseResidualStrength}"/>
                            <TextBlock Grid.Row="6" Text="Res. cohesion (kPa)" Style="{StaticResource FieldLabel}"
                                       IsEnabled="{Binding UseResidualStrength}"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,4"
                                     Text="{Binding ResidualCohesionKpa, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding UseResidualStrength}"/>
                            <TextBlock Grid.Row="7" Text="Res. friction (deg)" Style="{StaticResource FieldLabel}"
                                       IsEnabled="{Binding UseResidualStrength}"/>
                            <TextBox Grid.Row="7" Grid.Column="1"
                                     Text="{Binding ResidualFrictionDeg, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding UseResidualStrength}"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Stiffness" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Normal stiffness (kPa/m)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                                     Text="{Binding NormalStiffnessKpaPerM, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Text="Shear stiffness (kPa/m)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding ShearStiffnessKpaPerM, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Additional Pressure Inside Joint" Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <CheckBox Content="Groundwater pore pressure"
                                      IsChecked="{Binding UseGroundwaterPorePressure, Mode=TwoWay}" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Content="Define..." Padding="8,3" Margin="8,0,0,0"
                                        Command="{Binding DataContext.DefineAdditionalPressureCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <CheckBox Content="Additional pressure (kPa)"
                                          IsChecked="{Binding UseAdditionalPressure, Mode=TwoWay}"
                                          VerticalAlignment="Center"/>
                            </DockPanel>
                            <CheckBox Content="Apply pressure to liner side only"
                                      IsChecked="{Binding ApplyPressureToLinerSideOnly, Mode=TwoWay}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Stage Joint Properties" Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Define Factors..." Padding="8,3" Margin="8,0,0,0"
                                        Command="{Binding DataContext.DefineStageFactorsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <CheckBox Content="Stage joint properties"
                                          IsChecked="{Binding UseStagedProperties, Mode=TwoWay}"
                                          VerticalAlignment="Center"/>
                            </DockPanel>
                            <StackPanel IsEnabled="{Binding UseStagedProperties}">
                                <DataGrid ItemsSource="{Binding StageFactors}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          Height="90" Margin="0,0,0,6">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Stage" Binding="{Binding StageNumber, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                                        <DataGridTextColumn Header="kn" Binding="{Binding KnFactor, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        <DataGridTextColumn Header="ks" Binding="{Binding KsFactor, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        <DataGridTextColumn Header="c" Binding="{Binding CohesionFactor, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        <DataGridTextColumn Header="φ" Binding="{Binding FrictionFactor, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Content="Add stage factor" HorizontalAlignment="Left" Padding="8,3"
                                        Command="{Binding DataContext.AddStageFactorCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="Allow slip starting from stage" Style="{StaticResource FieldLabel}"
                                           IsEnabled="{Binding UseStagedProperties}"/>
                                <TextBox Width="60" HorizontalAlignment="Left"
                                         IsEnabled="{Binding UseStagedProperties}"
                                         Text="{Binding AllowSlipFromStage, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>

                    <CheckBox Content="Initial joint deformation"
                              IsChecked="{Binding InitialJointDeformation, Mode=TwoWay}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
