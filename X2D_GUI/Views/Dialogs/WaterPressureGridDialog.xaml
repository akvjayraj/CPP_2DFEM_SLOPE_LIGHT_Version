<Window x:Class="GeotechSlopeApp.Views.Dialogs.WaterPressureGridDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Water Pressure Grid"
        Width="820" Height="560"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="140"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: named grids -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="+" Width="36" Height="28" Margin="0,0,6,0"
                            FontWeight="Bold" FontSize="14"
                            Command="{Binding AddGridCommand}"
                            ToolTip="Add a named grid"/>
                    <Button Content="Delete" Height="28" Padding="10,0"
                            Command="{Binding DeleteGridCommand}"
                            ToolTip="Delete the selected grid (at least one must remain)"/>
                </StackPanel>
                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3">
                    <ListBox ItemsSource="{Binding Grids}"
                             SelectedItem="{Binding SelectedGrid, Mode=TwoWay}"
                             DisplayMemberPath="Name"
                             BorderThickness="0"/>
                </Border>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Right: type + points -->
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Name:" VerticalAlignment="Center" Width="70" Foreground="#FF475569"/>
                        <TextBox Width="200"
                                 Text="{Binding SelectedGrid.Name, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Grid Type:" VerticalAlignment="Center" Width="70" Foreground="#FF475569"/>
                        <ComboBox Width="200"
                                  ItemsSource="{Binding AllowedGridTypes}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedGridTypeOption, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Add point" Padding="8,2" Margin="0,0,6,0"
                                Command="{Binding AddPointCommand}"/>
                        <Button Content="Remove selected" Padding="8,2"
                                Command="{Binding RemovePointCommand}"/>
                    </StackPanel>
                </StackPanel>

                <DataGrid x:Name="PointsGrid"
                          ItemsSource="{Binding SelectedGrid.Points}"
                          SelectedItem="{Binding SelectedPoint, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Point" Binding="{Binding Index}" IsReadOnly="True" Width="60"/>
                        <DataGridTextColumn Binding="{Binding X, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" Width="*">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DataContext.PointXHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Y, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" Width="*">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DataContext.PointYHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Value"
                                            Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>

        <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Import..." Width="90" Height="28" Margin="0,0,8,0"
                        Command="{Binding ImportCommand}"/>
                <Button Content="Export..." Width="90" Height="28"
                        Command="{Binding ExportCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="OK" Width="90" Height="28" Margin="0,0,8,0"
                        IsDefault="True" Click="OkButton_Click"/>
                <Button Content="Cancel" Width="90" Height="28"
                        IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
