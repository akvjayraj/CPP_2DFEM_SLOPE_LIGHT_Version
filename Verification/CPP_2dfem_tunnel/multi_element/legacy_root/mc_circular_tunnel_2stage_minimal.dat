! <solver:p610_t3>
! Minimal 2-stage CIRCULAR tunnel excavation (Mohr-Coulomb, T3 plane-strain).
!
!   Tunnel   : circular cavity at the origin, radius 1 m, approximated by an
!              octagon (8 boundary nodes every 45 deg). After both stages, the
!              cavity is exactly the inner disc of the mesh.
!   Domain   : 6 m x 6 m square (-3 <= x,y <= 3), outer boundary clamped.
!   Mesh     : 24 T3 elements, 17 nodes.
!                * Inner disc  = 8 "pizza-slice" triangles meeting at the
!                                tunnel centre (node 1) - these are excavated.
!                * Outer ring  = 16 triangles connecting the 8 tunnel-boundary
!                                nodes to the 8 outer-boundary nodes - kept.
!
!   Stage 1 (top heading): elements  1, 2, 3, 4   (theta = 0 deg ... 180 deg)
!   Stage 2 (bench):       elements  5, 6, 7, 8   (theta = 180 deg ... 360 deg)
!
!   Node layout (1-based, polar):
!         1                              tunnel centre (0, 0)
!         2..9   inner ring  r = 1       at 0, 45, 90, 135, 180, 225, 270, 315 deg
!        10..17  outer ring  square 3 m  at 0, 45, 90, 135, 180, 225, 270, 315 deg
!                (corners of the 6x6 box for 45/135/225/315; mid-sides otherwise)
!
! <BEGIN:AnalysisOptions>
! failure_criterion MohrCoulomb
! material_type Isotropic
! mesh_type T3
! solver_executable p610_t3_mohr_coulomb
! <END:AnalysisOptions>
!
! <BEGIN:Header>
! nels  nn  np_types
24  17  1
! <END:Header>
!
! <BEGIN:Materials>
! phi  c  psi  gamma  E  nu  K0   (one value per line, per material type)
30
10
0
20
10000
0.2
0.5
! <END:Materials>
!
! <BEGIN:Mesh>
! x  y  (nodal coordinates, 1..nn)
! Tunnel centre
0  0
! Inner ring r=1 (theta = 0, 45, 90, ... 315 deg)
1.0       0.0
0.7071068 0.7071068
0.0       1.0
-0.7071068 0.7071068
-1.0      0.0
-0.7071068 -0.7071068
0.0       -1.0
0.7071068 -0.7071068
! Outer ring (mid-sides + corners of a 6x6 box, theta = 0, 45, ... 315 deg)
3   0
3   3
0   3
-3  3
-3  0
-3 -3
0  -3
3  -3
! n1  n2  n3  (element connectivity, 1-based; 24 T3 elements, all CCW)
! --- Inner disc (8 elements, will be excavated in two stages) ---
1   2   3
1   3   4
1   4   5
1   5   6
1   6   7
1   7   8
1   8   9
1   9   2
! --- Outer ring, octant 0-45 deg (between inner nodes 2,3 and outer 10,11) ---
2   10  11
2   11  3
! --- Outer ring, octant 45-90 deg ---
3   11  12
3   12  4
! --- Outer ring, octant 90-135 deg ---
4   12  13
4   13  5
! --- Outer ring, octant 135-180 deg ---
5   13  14
5   14  6
! --- Outer ring, octant 180-225 deg ---
6   14  15
6   15  7
! --- Outer ring, octant 225-270 deg ---
7   15  16
7   16  8
! --- Outer ring, octant 270-315 deg ---
8   16  17
8   17  9
! --- Outer ring, octant 315-360 deg ---
9   17  10
9   10  2
! <END:Mesh>
!
! <BEGIN:Bcs>
! nr  (restrained node count; rows: node fix_x fix_y; 0 = restrained, 1 = free)
! Outer ring fully clamped (all 8 outer nodes fixed in both x and y).
8
10  0  0
11  0  0
12  0  0
13  0  0
14  0  0
15  0  0
16  0  0
17  0  0
! <END:Bcs>
!
! <BEGIN:OutputNodes>
! nouts  (output node count, then node numbers - the 4 cardinal tunnel-boundary nodes)
4
2  4  6  8
! <END:OutputNodes>
!
! <BEGIN:SolverControl>
! tol  limit  incs  layers
1.0e-5  250  5  2
! <END:SolverControl>
!
! <BEGIN:Layers>
! Excavation layer 1 -- top heading (4 elements, upper half of tunnel disc)
4
1  2  3  4
! Excavation layer 2 -- bench (4 elements, lower half of tunnel disc)
4
5  6  7  8
! <END:Layers>
